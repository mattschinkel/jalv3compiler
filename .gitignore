# Private by default: nothing new is tracked unless named below.
# New root files or folders stay untracked; add them here deliberately.
/*
!/.gitignore
!/.github/
!/README.md
!/README.txt
!/NOTICE
!/bin/
!/demo_lib/
!/demo_sample/
!/doc/
!/documentation/
!/sims/
!/src/
!/unit-tests/

# documentation build intermediates (shipped PDFs live in doc/external)
doc/pdf/
doc/html/

# build artifacts (compile outputs land here from src/)
src/*/.obj-*/
src/*/.dep/
src/*.a
src/*/*.a
src/jal/jal_build.h
*.o
__pycache__/
*.asm
*.cod
*.hex
*.out
*.bin

# golden canary fixtures are inputs, not artifacts
!sims/golden/*.hex

# fetched corpus (pinned by unit-tests/fetch_jallib.sh)
/third_party/

# unit-test runtime outputs
unit-tests/Output_*/
unit-tests/Comparison/
unit-tests/.unittests_shadow/
unit-tests/reports/

# sims runtime outputs (reports land here at runtime)
sims/reports/
sims/report_archive/
sims/output_compare/

# superseded samples kept locally
demo_sample/old/
demo_sample/backup/

# scratch / tooling
tmp/
.zcodeignore
bin/beta/jalv3-x86-64-san
bin/beta/jalv3-x86-64-cov
unit-tests/.cache/
bin/beta/jalv3-x86-64.exe

# bin/beta/ holds every build (the two current compilers are tracked, the
# instrumented flavors above are not).  bin/release/ is written by hand only.
# bin/old_versions/ holds RELEASED versions only (the jalv2 line: jalv24q6*,
# jalv25*, jalv25r1..r9).  jALv3 is in beta, so its builds stay in bin/ root
# as bin/jalv3-x86-64 and bin/jalv3-win64.exe and are replaced in place --
# a versioned jalv3 binary must never be archived here.  This rule makes a
# slip a git-level refusal rather than something to notice in review.
bin/old_versions/jalv3*
bin/old_versions/**/jalv3*
