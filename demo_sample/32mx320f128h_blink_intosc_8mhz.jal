-- ------------------------------------------------------
-- Title: Blink both on-board LEDs of the chipKIT Uno32 at 8 MHz (internal oscillator)
--
-- Author: Matthew Schinkel, Copyright (c) 2026, all rights reserved
--
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Minimal-clock twin of the 80 MHz blink: internal 8 MHz FRC
--    directly, no PLL -- same alternating on-board-LED blink on the
--    Digilent chipKIT Uno32 (PIC32MX320F128H).
--
-- Notes:
--    LD4 = chipKIT digital pin 13 = RG6, LD5 = pin 43 = RF0
--    (mapping per chipKIT-core Uno32 Board_Data.c).
--    Both this and the 80 MHz PLL twin silicon-proven 2026-10-26.
--
-- ------------------------------------------------------
include 32mx320f128h                -- target device (PIC32MX3xx, MIPS32 M4K)

pragma target clock 8_000_000       -- internal 8 MHz, no PLL
pragma target OSC    FRC            -- internal 8 MHz FRC
pragma target image pfm             -- PFM app + boot block (MX270-proven shape)
pragma target WDT   DISABLED        -- watchdog off

enable_digital_io()
_usec_delay(100_000)                -- wait for power to stabilize

alias led4 is pin_G6                -- LD4, chipKIT pin 13
alias led5 is pin_F0                -- LD5, chipKIT pin 43

pin_G6_direction = OUTPUT
pin_F0_direction = OUTPUT

forever loop
   led4 = ON
   led5 = OFF
   _usec_delay(500_000)
   led4 = OFF
   led5 = ON
   _usec_delay(500_000)
end loop
