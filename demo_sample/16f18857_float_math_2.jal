-- Title: PIC16F18857 float_math_2 feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: float_math demo for the enhanced-midrange PIC16F18857 (32 MHz
--              INTOSC+PLL, serial on EUSART). The test body lives in
--              the f18857_float_math_body include block.
--
-- Requires: f18857_float_math_2_body
-- This file has been generated by Matt's sample generator.
--

include 16f18857                     -- target PICmicro
pragma target clock 32_000_000
pragma target OSC      OFF           -- internal oscillator
pragma target RSTOSC   HFINT32       -- power-up clock select (32 MHz)
pragma target CLKOUTEN DISABLED      -- no clock output
pragma target WDT      DISABLED      -- watchdog
pragma target BROWNOUT DISABLED      -- no brownout reset
pragma target FCMEN    DISABLED      -- no clock monitoring
pragma target CSWEN    ENABLED       -- allow OSCCON1 writes
pragma target LVP      ENABLED       -- low voltage programming
pragma target MCLR     EXTERNAL      -- external reset
--
enable_digital_io()                  -- make all pins digital I/O
_usec_delay (100_000)                -- wait for power to stabilize

-- 16f18857 port of the float_math demo (enhanced midrange PIC16, 32 MHz
--   HFINTOSC; LED on A0, serial on EUSART @115200)
alias led1 is pin_A0
alias led2 is pin_A1
pin_A0_direction = OUTPUT
pin_A1_direction = OUTPUT

-- setup uart for communication (C6/C7 via PPS, the JALPIC One wiring)
const serial_hw_baudrate  = 115200
include pps
pps_control_lock(FALSE)
RC6PPS = PPS_TX
RXPPS  = PPS_RC7
pps_control_lock(TRUE)
alias pin_TX is pin_C6
alias pin_TX_direction is pin_C6_direction
alias pin_RX is pin_C7
alias pin_RX_direction is pin_C7_direction

include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format
include print_float_exact
var float pi      = 3.14159265
var float radius  = 2.5
var float area
var float mean
var float ratio
var sdword scaled
var volatile byte checks = 0

procedure print_flt(float in v) is
   print_float_exact(serial_data, v)
end procedure

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC16F1825 demo: float math (2 of 2)\r\n")
print_string(serial_data, "  IEEE-754 single precision, soft-float\r\n")
print_string(serial_data, "  routines (no FPU)\r\n")
print_string(serial_data, "========================================\r\n")


-- section setup (part 1 carried the add/sub chain): recompute mean
mean = pi - 4.0 + 1.0
-- float to integer truncation
print_string(serial_data, "--- float to int truncation ---------------\r\n")
scaled = sdword(pi * 1000.0)
print_string(serial_data, "pi * 1000 truncated = ")
print_sdword_dec(serial_data, scaled)
if scaled == 3141 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 3141)\r\n")
end if

-- integer to float in an expression
print_string(serial_data, "--- int to float in an expression ---------\r\n")
var float fi = 7
fi = fi / 2
print_string(serial_data, "7 / 2 (inttofloat)  = ")
print_flt(fi)
if fi > 3.4999 then
   if fi < 3.5001 then
      checks = checks + 1
      print_string(serial_data, "  OK\r\n")
   else
      print_string(serial_data, "  WRONG (want 3.5)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want 3.5)\r\n")
end if

-- comparisons
print_string(serial_data, "--- comparisons ---------------------------\r\n")
if pi > radius then
   checks = checks + 1
   print_string(serial_data, "pi > radius:        true  OK\r\n")
else
   print_string(serial_data, "pi > radius:        false  WRONG\r\n")
end if
if mean < 1.0 then
   checks = checks + 1
   print_string(serial_data, "mean < 1:           true  OK\r\n")
else
   print_string(serial_data, "mean < 1:           false  WRONG\r\n")
end if
if radius <= 2.5 then
   checks = checks + 1
   print_string(serial_data, "radius <= 2.5:      true  OK\r\n")
else
   print_string(serial_data, "radius <= 2.5:      false  WRONG\r\n")
end if
print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 5\r\n")
if checks == 5 then
   print_string(serial_data, "ALL FLOAT CHECKS PASSED (part 2)\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

