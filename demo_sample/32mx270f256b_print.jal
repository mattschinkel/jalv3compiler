-- Title: PIC32MX270F256B print-library demo (PFM + boot block, 40 MHz)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Print-library demo on a self-sourced PIC32MX270F256B image:
--    the compiler solves 40 MHz from the internal FRC, emits the
--    DEVCFG words, and lays out a program-flash app at 0x9D000000 with
--    its boot block in the 3 KB boot flash (`pragma target image pfm`).
--    Prints a banner, byte/word/dword dec+hex self-checks, then a
--    once-per-second heartbeat at 115200 8N1.
--
-- Notes:
--    - UART wiring used here: RPB0 = U1TX, RPB2 = U1RX (U1RXR code
--      0b0100), 115200 8N1.  Change the aliases for your board.
--    - PBCLK = SYSCLK/2 (FPBDIV=1 in the solved fuse word), so the
--      serial library's default uart clock (target_clock/2) is right.
--    - PFM shape: the boot flash is only 3 KB, so the app lives in
--      program flash.  For a boot-flash-only image see the blink samples.
--    - Build:
--        ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' this file
--      The HEX carries boot block + app + DEVCFG words in one file.
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 40_000_000      -- oscillator frequency
pragma target OSC    FRC_SPLL       -- internal 8 MHz FRC through the system PLL (/2 x20 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

alias led is pin_B5
pin_B5_direction = OUTPUT

const serial_hw_baudrate = 115_200
alias serial_hw_pin_tx is pin_B0
alias serial_hw_pin_tx_direction is pin_B0_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2

include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 6

include print

var byte  demo_b = 42
var word  demo_w = 65_535
var dword demo_d = 123_456_789
var byte  seconds = 0
var byte  checks  = 0

-- 3 s grace period: time to open a serial terminal after power-up
for 3 loop
   led = ON
   _usec_delay(80_000)
   led = OFF
   _usec_delay(920_000)
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 print demo - PIC32MX270F256B\r\n")
print_string(serial_data, "boot: compiler boot block, SYSCLK 40 MHz, 115200 8N1\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "byte  dec: ")
print_byte_dec(serial_data, demo_b)
print_string(serial_data, "  hex: 0x")
print_byte_hex(serial_data, demo_b)
print_string(serial_data, "\r\n")

print_string(serial_data, "word  dec: ")
print_word_dec(serial_data, demo_w)
print_string(serial_data, "  hex: 0x")
print_word_hex(serial_data, demo_w)
print_string(serial_data, "\r\n")

print_string(serial_data, "dword dec: ")
print_dword_dec(serial_data, demo_d)
print_string(serial_data, "  hex: 0x")
print_dword_hex(serial_data, demo_d)
print_string(serial_data, "\r\n")

if demo_b == 42 then checks = checks + 1 end if
if demo_w == 65_535 then checks = checks + 1 end if
if demo_d == 123_456_789 then checks = checks + 1 end if
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 3\r\n\r\n")

forever loop
   led = ON
   print_string(serial_data, "alive - ")
   print_byte_dec(serial_data, seconds)
   print_string(serial_data, " s\r\n")
   seconds = seconds + 1
   _usec_delay(500_000)
   led = OFF
   _usec_delay(500_000)
end loop

