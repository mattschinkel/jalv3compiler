-- Title: PIC32MZ1024EFH064 print demo over software serial (9600)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Print-library demo using the software (bit-banged) serial library on
--    RF0 (TX) and RF1 (RX) at 9600 8N1, with the LED on RB14 blinking
--    2 s on / 2 s off.  Runs at 40 MHz from the internal FRC.
--
--    The PIC32 software-serial library subtracts the fixed _usec_delay()
--    call overhead (~29 us at 40 MHz) from each bit time.  Without that
--    correction 1200 works but 9600 is garbage.  115200 cannot be reached
--    with _usec_delay (the bit time would be negative); use the hardware
--    UART sample for high baud rates.
--
-- Notes:
--    - Wiring: RF0 (pin 4) -> USB-UART RXD, RF1 (pin 6) <- USB-UART TXD,
--      GND common, 3.3 V TTL.
--    - RF0 is also PGED1; keep the programmer on PGED2/PGEC2 (RB10/RB11)
--      or disconnect PGED1 when using this sample.
--    - Build:
--        ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' this file
--    - Program with your PICkit, then release the target from the tool's
--      hold-in-reset state (`ipecmd ... -OK -OL`) or detach the programmer.
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

const serial_sw_baudrate = 9600
alias serial_sw_tx_pin is pin_F0
alias serial_sw_rx_pin is pin_F1
pin_F0_direction = OUTPUT
pin_F1_direction = INPUT
include serial_software_pic32
serial_sw_init()

alias serial_write is serial_sw_write
alias serial_read is serial_sw_read
alias serial_data is serial_sw_data

const PRINT_MAX_VAR_SIZE = 6
include print
include format

alias led is pin_E1
pin_E1_direction = OUTPUT

var byte n = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 software-serial print demo - PIC32MZ1024EFH064\r\n")
print_string(serial_data, "9600 8N1, TX=RF0, RX=RF1, SYSCLK 200 MHz\r\n")
print_string(serial_data, "========================================\r\n")

forever loop
   led = ON
   print_string(serial_data, "alive ")
   print_byte_dec(serial_data, n)
   print_crlf(serial_data)
   n = n + 1
   _usec_delay(2_000_000)
   led = OFF
   _usec_delay(2_000_000)
end loop

