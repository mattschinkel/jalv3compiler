-- Title: PIC18F67J50 watchdog — classic PIC18 (16-bit) feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: the watchdog on the PIC18F67J50: armed through WDTCON.SWDTEN
--              (the fuse stays CONTROL), serviced with `clrwdt`.  Phase 1
--              services it every pass so the part keeps running; phase 2
--              stops servicing, so on silicon the WDT reset fires and the
--              serial log restarts.
--
--              Compile-checked only: gpsim does not model the PIC18 WDT.

include 18f67j50

pragma target clock     48_000_000
pragma target OSC       INTOSC_NOCLKOUT_PLL
pragma target PLLDIV    P2
pragma target CPUDIV    P1
pragma target WDT       CONTROL
pragma target XINST     DISABLED
pragma target DEBUG     DISABLED
pragma target FCMEN     DISABLED
pragma target IESO      DISABLED
--
WDTCON_SWDTEN = OFF
OSCCON_SCS = 0
OSCTUNE_PLLEN = TRUE
--
enable_digital_io()
_usec_delay(100_000)
--
alias led1 is pin_G2
pin_G2_direction = OUTPUT
--
const serial_hw_baudrate = 115200
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4
include print
include format
--

var volatile byte phase = 0
var byte beat
--
print_string(serial_data, "JALv2 PIC18F67J50: watchdog\r\n")
print_string(serial_data, "fuse CONTROL + SWDTEN on\r\n")
WDTCON_SWDTEN = 1
phase = 1
--
beat = 0
while beat < 5 loop
   beat = beat + 1
   asm clrwdt
   print_string(serial_data, "serviced ")
   print_byte_dec(serial_data, beat)
   print_crlf(serial_data)
   led1 = ON
   _usec_delay(100_000)
   led1 = OFF
   _usec_delay(100_000)
end loop
--
print_string(serial_data, "##HANG## no more clrwdt - reset expected\r\n")
phase = 2
forever loop
   print_string(serial_data, "hang beat\r\n")
   led1 = ON
   _usec_delay(100_000)
   led1 = OFF
   _usec_delay(100_000)
end loop
