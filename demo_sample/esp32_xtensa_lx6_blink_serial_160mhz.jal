-- Title: Blink + serial heartbeat -- self-proving blink sample
-- Author: Matthew Schinkel
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Blinks the board LED once per second AND prints a ##BLINK## marker
--    over serial every cycle, so the sample proves its own clock/serial
--    wiring: on a simulator the marker is the runtime test.
--
--
-- Notes:
--    - Generated.
--
-- -----------------------------------------------------------------------------
-- Requires: serial_hardware,serial_software,serial_uart1,esp32_uart0
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 160_000_000     -- oscillator frequency (BBPLL 480 / 3)
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- board LED -- pin values come from blocks/boards/<board>.pins
alias led is pin_2_out
pin_2_direction = OUTPUT

-- ESP32 UART0 -- the port wired to the dev board's USB serial bridge,
-- 115200 8N1 as programmed by the boot ROM (do not touch UART0_CLKDIV:
-- an application write wedges the USB bridge into a garbage flood).
include esp32_serial_hw
alias serial_write is serial_hw_putc
alias serial_data is serial_hw_data
--
include print

var dword blinks = 0

print_string(serial_data, "##BLINK## boot")
print_crlf(serial_data)

-- board wiring (LED pin, serial pins) comes from blocks/boards/*.pins
-- via the blink_pins and serial_uart1 includes
forever loop
   led = ON
   _usec_delay(500_000)             -- 500 ms
   led = OFF
   _usec_delay(500_000)
   blinks = blinks + 1
   print_string(serial_data, "##BLINK## ")
   print_dword_dec(serial_data, blinks)
   print_crlf(serial_data)
end loop