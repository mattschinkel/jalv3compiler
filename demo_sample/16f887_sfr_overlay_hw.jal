-- Title: PIC16F887 SFR bit overlay — classic midrange (14-bit) feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: an SFR seen through a `var bit [...] at <register>` overlay on
--              the classic midrange PIC16F887: writing overlay bit N must
--              set/clear bit N of the real port register, including a
--              RUNTIME index, and reading the overlay must return what the
--              register holds.
--
--              Results are printed on the EUSART and mirrored on the LED.
--

include 16f887                      -- target PICmicro
--
pragma target clock 8_000_000       -- oscillator frequency
pragma target OSC      INTOSC_NOCLKOUT
pragma target WDT      CONTROL
pragma target DEBUG    DISABLED
pragma target BROWNOUT DISABLED
pragma target FCMEN    DISABLED
pragma target IESO     DISABLED
pragma target LVP      DISABLED
pragma target MCLR     EXTERNAL
--
WDTCON_SWDTEN = OFF
OSCCON_SCS = 0
OSCCON_IRCF = 0b111
enable_digital_io()
_usec_delay(100_000)
--
const serial_hw_baudrate = 115200
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4
include print
include format
--
alias led is pin_D0
pin_D0_direction = OUTPUT
--
-- PORTD bit overlay: one bit per pin, addressed through the register
var bit portd_bits[8] at PORTD
var byte pin
var byte bad = 0
--
TRISD = 0                          -- port D all outputs
PORTD = 0                          -- materialise the latch
--
print_string(serial_data, "JALv2 PIC16F887: SFR bit overlay\r\n")
--
-- runtime-indexed set: bit 5
pin = 5
portd_bits[pin] = ON
if (PORTD & 0x20) == 0 then
   bad = bad + 1
end if
--
-- runtime-indexed readback
if portd_bits[5] == 0 then
   bad = bad + 1
end if
--
-- runtime-indexed clear
portd_bits[pin] = OFF
if (PORTD & 0x20) != 0 then
   bad = bad + 1
end if
--
-- two bits in one byte, constant indexes
portd_bits[0] = ON
portd_bits[7] = ON
if (PORTD & 0x81) != 0x81 then
   bad = bad + 1
end if
--
print_string(serial_data, "SFR overlay checks: ")
if bad == 0 then
   print_string(serial_data, "OK")
else
   print_string(serial_data, "FAIL")
end if
print_crlf(serial_data)
led = bad == 0
--
forever loop
end loop
