-- Title: PIC16F1825 tasks feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: tasks demo for the enhanced-midrange PIC16F1825 (32 MHz
--              INTOSC+PLL, serial on EUSART). The test body lives in
--              the f1825_tasks_body include block.
--
-- Requires: f1825_tasks_body
-- This file has been generated by Matt's sample generator.
--

include 16f1825                      -- target PICmicro
--
-- This program uses the internal oscillator at 8 MHz through the
-- 4x PLL: 32 MHz (the PLL is software-enabled below).
pragma target clock 32_000_000      -- oscillator frequency
--
pragma target OSC      INTOSC_NOCLKOUT           -- internal oscillator
pragma target PLLEN    DISABLED                  -- PLL software controlled
pragma target CLKOUTEN DISABLED                  -- no clock output
pragma target WDT      DISABLED                  -- watchdog
pragma target DEBUG    DISABLED                  -- no debugging
pragma target BROWNOUT DISABLED                  -- no brownout reset
pragma target FCMEN    DISABLED                  -- no clock monitoring
pragma target IESO     DISABLED                  -- no int/ext osc switching
pragma target LVP      ENABLED                   -- low voltage programming
pragma target MCLR     EXTERNAL                  -- external reset
--
OSCCON_SCS = 0                      -- clock selected by fuse OSC
OSCCON_IRCF = 0b1110                -- internal oscillator to 8 MHz
OSCCON_SPLLEN = TRUE                -- enable PLL, multiply by 4 -> 32 MHz
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay (100_000) -- wait for power to stablilize

-- 16f1825 port of the tasks demo (enhanced midrange PIC16, 32 MHz
--   INTOSC+PLL; LED on A0, serial on EUSART @115200)
alias led1 is pin_A0
alias led2 is pin_A1
pin_A0_direction = OUTPUT
pin_A1_direction = OUTPUT

-- setup uart for communication (EUSART on the part's fixed TX/RX pins)
const serial_hw_baudrate  = 115200
-- EUSART pin pair (APFCON-selectable on this part; RC4/RC5 chosen)
alias pin_TX is pin_C4
alias pin_TX_direction is pin_C4_direction
alias pin_RX is pin_C5
alias pin_RX_direction is pin_C5_direction

include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format
pragma task 4          -- main + three workers

-- Task bodies share the starter's stack (leaf frames): keep state in
-- globals, never in task-local variables.
var volatile byte ta_count = 0
var volatile byte tb_count = 0
var byte main_count = 0
var volatile byte checks = 0

--------------------------------------------------------------------------------
-- Description: Worker A: three slices, yields between each, then ends
task worker_a() is
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 1")
   print_crlf(serial_data)
   _task_yield
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 2")
   print_crlf(serial_data)
   _task_yield
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 3 (last)")
   print_crlf(serial_data)
end task

--------------------------------------------------------------------------------
-- Description: Worker B: two slices, yields between each, then ends
task worker_b() is
   tb_count = tb_count + 1
   print_string(serial_data, "task B slice 1")
   print_crlf(serial_data)
   _task_yield
   tb_count = tb_count + 1
   print_string(serial_data, "task B slice 2 (last)")
   print_crlf(serial_data)
end task

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC18F67J50 demo: cooperative tasks\r\n")
print_string(serial_data, "  round-robin scheduler: _task_start,\r\n")
print_string(serial_data, "  _task_yield, tasks end by falling off\r\n")
print_string(serial_data, "========================================\r\n")
print_string(serial_data, "starting task A + task B\r\n")

_task_start worker_a()
_task_start worker_b()

for 3 loop
   main_count = main_count + 1
   if main_count == 3 then
      print_string(serial_data, "main slice 3 (last)")
   else
      print_string(serial_data, "main slice ")
      print_byte_dec(serial_data, main_count)
   end if
   print_crlf(serial_data)
   _task_yield
end loop

print_string(serial_data, "task A ran ")
print_byte_dec(serial_data, ta_count)
print_string(serial_data, " slices")
print_crlf(serial_data)

print_string(serial_data, "task B ran ")
print_byte_dec(serial_data, tb_count)
print_string(serial_data, " slices")
print_crlf(serial_data)

if ta_count == 3 then
   checks = checks + 1
   if tb_count == 2 then
      checks = checks + 1
      print_string(serial_data, "TASKS: PASS")
   else
      print_string(serial_data, "TASKS: FAIL (B count)")
   end if
else
   print_string(serial_data, "TASKS: FAIL (A count)")
end if
print_crlf(serial_data)

-- Task control from main: _task_suspend parks a task while others
-- keep running; _task_resume continues it; _task_kill removes it;
-- _task_restart re-runs it from its entry. A third worker counts its
-- slices in a global.
var volatile byte tc_count = 0
var volatile byte tc_frozen = 0

task worker_c() is
   forever loop
      tc_count = tc_count + 1
      _task_yield
   end loop
end task

print_string(serial_data, "--- task control -------------------------\r\n")
_task_start worker_c()
for 3 loop
   _task_yield
end loop
print_string(serial_data, "worker C ticks:    ")
print_byte_dec(serial_data, tc_count)
print_crlf(serial_data)

_task_suspend worker_c()
tc_frozen = tc_count
for 3 loop
   _task_yield
end loop
if tc_count == tc_frozen then
   checks = checks + 1
   print_string(serial_data, "suspended: frozen OK\r\n")
else
   print_string(serial_data, "suspended: WRONG (still running)\r\n")
end if

_task_resume worker_c()
for 3 loop
   _task_yield
end loop
if tc_count > tc_frozen then
   checks = checks + 1
   print_string(serial_data, "resumed: running OK\r\n")
else
   print_string(serial_data, "resumed: WRONG (still frozen)\r\n")
end if

_task_kill worker_c()
tc_frozen = tc_count
for 3 loop
   _task_yield
end loop
if tc_count == tc_frozen then
   checks = checks + 1
   print_string(serial_data, "killed: dead OK\r\n")
else
   print_string(serial_data, "killed: WRONG (zombie)\r\n")
end if

_task_restart worker_c()
for 3 loop
   _task_yield
end loop
if tc_count > tc_frozen then
   checks = checks + 1
   print_string(serial_data, "restarted: from entry OK\r\n")
else
   print_string(serial_data, "restarted: WRONG (not restarted)\r\n")
end if

_task_kill worker_c()

print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 6\r\n")
if checks == 6 then
   print_string(serial_data, "ALL TASK CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

