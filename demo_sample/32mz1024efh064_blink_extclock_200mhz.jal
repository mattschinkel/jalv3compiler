--
-- Description:
--    Blinks the board LED once per second (500 ms on / 500 ms off).
--
-- Notes:
--    - Generated.
--
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target oscillator 20_000_000 -- external source frequency (crystal or clock module)
pragma target OSC      EC_SPLL      -- external clock module through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

-- board LED -- pin values come from blocks/boards/<board>.pins
alias led is pin_E1
pin_E1_direction = OUTPUT

--
-- board wiring (the LED pin) comes from blocks/boards/*.pins via the
-- blink_pins include.
forever loop
   led = ON
   _usec_delay(500_000)             -- 500 ms
   led = OFF
   _usec_delay(500_000)
end loop