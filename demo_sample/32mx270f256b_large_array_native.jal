-- Title: PIC32MX270F256B large native array (512 elements, no large_array library)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    PIC32 port of the ESP32 large-array demo: proves native arrays with
--    more than 256 elements work WITHOUT the large_array library:
--    512 bytes filled and checksummed through element indexes 0..511,
--    plus distinct boundary markers straddling index 255/256. If
--    element addressing truncated to 8 bits (the classic-PIC limitation
--    the large_array library works around), arr[256] would alias arr[0]
--    and the marker readback would fail. On PIC32 flat RAM addressing
--    it is native. A 16 x 24 multi-dimensional grid (384 elements,
--    runtime double indexing, COUNT() per dimension) extends the same
--    proof. The serial output uses the sd-card-sample pattern: the
--    driver's serial_hw_data pseudo-variable aliased as serial_data, so
--    every print_*() call works unchanged.
--
-- Notes:
--    - Ported from demo_sample/esp32_large_array_native.jal (same
--      sections and self-check expectations; GPIO_OUT LED writes became
--      led1/led2 pin writes). No clock bring-up needed.
--    - Compile: ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' -no-codfile this file
--    - QEMU gate: ./tests/jal_sim_validate.sh --compiler ./bin/jalv3-x86-64 this file
--
-- @sim_validate begin
-- duration_s: 8
-- uart_contains: ##DONE##
-- machine: pic32mx7-explorer16
-- expect byte v_checks 5
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 40_000_000      -- oscillator frequency
pragma target OSC    FRC_SPLL       -- internal 8 MHz FRC through the system PLL (/2 x20 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_B14
alias led2 is pin_B13
pin_B14_direction = OUTPUT
pin_B13_direction = OUTPUT

-- setup uart for communication (board wiring: RPB3 = U1TX, RPB2 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_B3
alias serial_hw_pin_tx_direction is pin_B3_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB3R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2             -- U1RXR code for RPB2

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format

var volatile byte checks = 0
var byte arr[512]   -- native array: 2 x 256 index pages, no bank shadowing
var word idx
var word sum = 0

-- fill with the index pattern over all 512 elements
for count(arr) using idx loop
   arr[idx] = byte(idx)
end loop
-- checksum: byte(idx) for 0..511 = 2 x sum(0..255) = 2 x 32640 = 65280
for count(arr) using idx loop
   sum = sum + arr[idx]
end loop

-- distinct markers at, below and above the 255/256 index boundary:
-- aliasing (index truncated mod 256) would overwrite earlier markers
arr[0]   = 0x11
arr[255] = 0x22
arr[256] = 0x33
arr[257] = 0x44
arr[300] = 0x55
arr[511] = 0x66

const word MK_IDX[6] = { 0, 255, 256, 257, 300, 511 }
const byte MK_VAL[6] = { 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 }
var word m
var byte bad = 0

for 6 using m loop
   if arr[MK_IDX[m]] != MK_VAL[m] then
      bad = bad + 1
   end if
end loop

-- multi-dimensional native array: 16 x 24 = 384 elements in one flat
-- RAM block, runtime double indexing -- again with no large_array
-- library. Elements past flat index 255 (grid[11][0] = flat 264)
-- prove the second dimension addresses beyond one 8-bit index page.
var byte grid[16][24]
var byte gi
var byte gj
var word flat = 0
var word gsum = 0

for 16 using gi loop
   for 24 using gj loop
      grid[gi][gj] = byte(flat)
      flat = flat + 1
   end loop
end loop
for 16 using gi loop
   for 24 using gj loop
      gsum = gsum + grid[gi][gj]
   end loop
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC32 demo: native large arrays\r\n")
print_string(serial_data, "  512-element array + 16x24 grid,\r\n")
print_string(serial_data, "  no large_array library needed\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- 512-element array ---------------------\r\n")
print_string(serial_data, "elements:          ")
print_word_dec(serial_data, count(arr))
print_crlf(serial_data)
print_string(serial_data, "checksum:          ")
print_word_dec(serial_data, sum)
if sum == 65280 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 65280)\r\n")
end if
print_string(serial_data, "past-255 readback: ")
print_byte_hex(serial_data, arr[256])
print_string(serial_data, " ")
print_byte_hex(serial_data, arr[300])
print_string(serial_data, " ")
print_byte_hex(serial_data, arr[511])
if arr[256] == 0x33 then
   if arr[300] == 0x55 then
      if arr[511] == 0x66 then
         checks = checks + 1
         print_string(serial_data, "  OK\r\n")
      else
         print_string(serial_data, "  WRONG\r\n")
      end if
   else
      print_string(serial_data, "  WRONG\r\n")
   end if
else
   print_string(serial_data, "  WRONG\r\n")
end if
print_string(serial_data, "boundary markers:  ")
if bad == 0 then
   checks = checks + 1
   print_string(serial_data, "PASS\r\n")
else
   print_string(serial_data, "FAIL ")
   print_byte_dec(serial_data, bad)
   print_crlf(serial_data)
end if

print_string(serial_data, "--- 16x24 grid ----------------------------\r\n")
print_string(serial_data, "grid 16x24:        ")
print_word_dec(serial_data, count(grid))
print_string(serial_data, " x ")
print_word_dec(serial_data, count(grid[0]))
print_string(serial_data, " = ")
print_word_dec(serial_data, count(grid) * count(grid[0]))
print_crlf(serial_data)
print_string(serial_data, "grid checksum:     ")
print_word_dec(serial_data, gsum)
if gsum == 40768 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 40768)\r\n")
end if
print_string(serial_data, "grid [10][10] / [11][0]: ")
print_byte_dec(serial_data, grid[10][10])
print_string(serial_data, " / ")
print_byte_dec(serial_data, grid[11][0])
if grid[10][10] == 250 then
   if grid[11][0] == 8 then
      checks = checks + 1
      print_string(serial_data, "  OK\r\n")
   else
      print_string(serial_data, "  WRONG (want 250 / 8)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want 250 / 8)\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 5\r\n")
if checks == 5 then
   print_string(serial_data, "ALL ARRAY CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   led1 = ON
   _usec_delay(500_000)
   led1 = OFF
   _usec_delay(500_000)
end loop

