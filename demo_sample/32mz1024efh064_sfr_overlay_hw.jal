-- Title: PIC32MZ1024EFH064 SFR bit-overlay witness, own-boot bare metal
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Silicon proof of `var bit x[32] at SFR dword`: a LATB overlay's
--    runtime-indexed stores/reads drive the real latch (the QEMU
--    witness proved addressing; only silicon proves the register).
--    Same own-boot pairing as print.  115200 8N1.
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
alias led2 is pin_E0
pin_E1_direction = OUTPUT
pin_E0_direction = OUTPUT

-- setup uart for communication
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

var bit latb_bits[32] at LATB
var byte checks = 0
var byte pin

for 5 loop
   led1 = ON
   _usec_delay(80_000)
   led1 = OFF
   _usec_delay(920_000)
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 SFR overlay witness - PIC32MZ\r\n")
print_string(serial_data, "boot: own boot init, SYSCLK 200 MHz\r\n")
print_string(serial_data, "========================================\r\n")

TRISB = 0                      -- port B all outputs
LATB = 0                       -- materialize the latch

pin = 11
latb_bits[pin] = 1             -- runtime-indexed store into the SFR
if (LATB & 0x800) != 0 then
   print_string(serial_data, "OK   latb_bits[11] = 1 to LATB bit 11\r\n")
   checks = checks + 1
end if
if latb_bits[pin] == 1 then
   print_string(serial_data, "OK   overlay readback bit 11\r\n")
   checks = checks + 1
end if

latb_bits[pin] = 0
if (LATB & 0x800) == 0 then
   print_string(serial_data, "OK   clear to LATB bit 11 low\r\n")
   checks = checks + 1
end if

-- byte 0 RMW through the overlay (QEMU's RAZ gap made this unverifiable)
latb_bits[3] = 1
latb_bits[7] = 1
if (LATB & 0x88) == 0x88 then
   print_string(serial_data, "OK   bits 3+7 via overlay\r\n")
   checks = checks + 1
end if

print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 4\r\n")
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##\r\n")

var byte seconds = 0
forever loop
   led1 = ON
   led2 = ON
   print_string(serial_data, "alive - ")
   print_byte_dec(serial_data, seconds)
   print_string(serial_data, " s\r\n")
   seconds = seconds + 1
   _usec_delay(100_000)
   led1 = OFF
   led2 = OFF
   _usec_delay(900_000)
end loop

