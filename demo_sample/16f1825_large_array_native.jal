-- Title: PIC16F1825 large_array_native feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: native large-array demo (300-element multibank array + 8x12 grid) for the enhanced-midrange PIC16F1825 (32 MHz
--              INTOSC+PLL, serial on EUSART). The test body lives in
--              the f1825_large_array_native_body include block.
--
-- Requires: f1825_large_array_native_body
-- This file has been generated by Matt's sample generator.
--

include 16f1825                      -- target PICmicro
--
-- This program uses the internal oscillator at 8 MHz through the
-- 4x PLL: 32 MHz (the PLL is software-enabled below).
pragma target clock 32_000_000      -- oscillator frequency
--
pragma target OSC      INTOSC_NOCLKOUT           -- internal oscillator
pragma target PLLEN    DISABLED                  -- PLL software controlled
pragma target CLKOUTEN DISABLED                  -- no clock output
pragma target WDT      DISABLED                  -- watchdog
pragma target DEBUG    DISABLED                  -- no debugging
pragma target BROWNOUT DISABLED                  -- no brownout reset
pragma target FCMEN    DISABLED                  -- no clock monitoring
pragma target IESO     DISABLED                  -- no int/ext osc switching
pragma target LVP      ENABLED                   -- low voltage programming
pragma target MCLR     EXTERNAL                  -- external reset
--
OSCCON_SCS = 0                      -- clock selected by fuse OSC
OSCCON_IRCF = 0b1110                -- internal oscillator to 8 MHz
OSCCON_SPLLEN = TRUE                -- enable PLL, multiply by 4 -> 32 MHz
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay (100_000) -- wait for power to stablilize

-- 16f1825 port of the native large arrays demo (enhanced midrange PIC16,
--   32 MHz INTOSC+PLL; LED on A0, serial on EUSART @115200)
alias led1 is pin_A0
alias led2 is pin_A1
pin_A0_direction = OUTPUT
pin_A1_direction = OUTPUT

-- setup uart for communication (EUSART on the part's fixed TX/RX pins)
const serial_hw_baudrate  = 115_200
-- setup uart for communication
-- EUSART pin pair (APFCON-selectable on this part; RC4/RC5 chosen)
alias pin_TX is pin_C4
alias pin_TX_direction is pin_C4_direction
alias pin_RX is pin_C5
alias pin_RX_direction is pin_C5_direction

include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format

var volatile byte checks = 0
var byte arr[300]   -- native multibank array: chunked across banks, no large_array library
var word idx
var word sum = 0

-- fill with the index pattern over all 300 elements
for count(arr) using idx loop
   arr[idx] = byte(idx)
end loop
-- checksum: byte(idx) for 0..299 = sum(0..255) + sum(0..43) = 32640 + 946 = 33586
for count(arr) using idx loop
   sum = sum + arr[idx]
end loop

-- distinct markers at, below and above the 255/256 index boundary:
-- aliasing (index truncated mod 256) would overwrite earlier markers
arr[0]   = 0x11
arr[255] = 0x22
arr[256] = 0x33
arr[257] = 0x44
arr[299] = 0x66

-- explicit boundary-marker checks (a const ROM table with a
-- runtime index does not compile on the CLASSIC 8-bit cores
-- yet -- jalv3compiler backlog item, repro tmp/const_table_classic.jal)
var byte bad = 0

if arr[0] != 0x11 then
   bad = bad + 1
end if
if arr[255] != 0x22 then
   bad = bad + 1
end if
if arr[256] != 0x33 then
   bad = bad + 1
end if
if arr[257] != 0x44 then
   bad = bad + 1
end if
if arr[299] != 0x66 then
   bad = bad + 1
end if

-- multi-dimensional native array: 8 x 12 = 96 elements in one flat
-- RAM block, runtime double indexing -- again with no large_array
-- library (sized for the part's 1 KB RAM).
var byte grid[8][12]
var byte gi
var byte gj
var word flat = 0
var word gsum = 0

for 8 using gi loop
   for 12 using gj loop
      grid[gi][gj] = byte(flat)
      flat = flat + 1
   end loop
end loop
for 8 using gi loop
   for 12 using gj loop
      gsum = gsum + grid[gi][gj]
   end loop
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC16F1825 demo: native large arrays\r\n")
print_string(serial_data, "  300-element array + 8x12 grid,\r\n")
print_string(serial_data, "  no large_array library needed\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- 300-element array ---------------------\r\n")
print_string(serial_data, "elements:          ")
print_word_dec(serial_data, count(arr))
print_crlf(serial_data)
print_string(serial_data, "checksum:          ")
print_word_dec(serial_data, sum)
if sum == 33586 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 33586)\r\n")
end if
print_string(serial_data, "past-255 readback: ")
print_byte_hex(serial_data, arr[256])
print_string(serial_data, " ")
print_byte_hex(serial_data, arr[257])
print_string(serial_data, " ")
print_byte_hex(serial_data, arr[299])
if arr[256] == 0x33 then
   if arr[257] == 0x44 then
      if arr[299] == 0x66 then
         checks = checks + 1
         print_string(serial_data, "  OK\r\n")
      else
         print_string(serial_data, "  WRONG\r\n")
      end if
   else
      print_string(serial_data, "  WRONG\r\n")
   end if
else
   print_string(serial_data, "  WRONG\r\n")
end if
print_string(serial_data, "boundary markers:  ")
if bad == 0 then
   checks = checks + 1
   print_string(serial_data, "PASS\r\n")
else
   print_string(serial_data, "FAIL ")
   print_byte_dec(serial_data, bad)
   print_crlf(serial_data)
end if

print_string(serial_data, "--- 8x12 grid -----------------------------\r\n")
print_string(serial_data, "grid 8x12:         ")
print_word_dec(serial_data, count(grid))
print_string(serial_data, " x ")
print_word_dec(serial_data, count(grid[0]))
print_string(serial_data, " = ")
print_word_dec(serial_data, count(grid) * count(grid[0]))
print_crlf(serial_data)
print_string(serial_data, "grid checksum:     ")
print_word_dec(serial_data, gsum)
if gsum == 4560 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 4560)\r\n")
end if
print_string(serial_data, "grid [5][5] / [6][0]:    ")
print_byte_dec(serial_data, grid[5][5])
print_string(serial_data, " / ")
print_byte_dec(serial_data, grid[6][0])
if grid[5][5] == 65 then
   if grid[6][0] == 72 then
      checks = checks + 1
      print_string(serial_data, "  OK\r\n")
   else
      print_string(serial_data, "  WRONG (want 65 / 72)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want 65 / 72)\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 5\r\n")
if checks == 5 then
   print_string(serial_data, "ALL ARRAY CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   led1 = ON
   _usec_delay(500_000)
   led1 = OFF
   _usec_delay(500_000)
end loop

