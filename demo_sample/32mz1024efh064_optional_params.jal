-- Title: PIC32MZ1024EFH064 optional-parameters demo, fully own-boot bare metal
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Demonstrates optional parameters (`optional type in name
--    default const`) on hardware: calls at every arity (defaults fill
--    in), bit and volatile-formal defaults, and an open-array default
--    (string literal, materialized once -- COUNT() inside the procedure
--    sees the default's length).  Same own-boot pairing as
--    32mz1024efh064_print: compiler-emitted boot-flash init +
--    self-derived DEVCFG2 (0x400131A0 to boot SPLL 200.0 MHz) + a
--    pragma-200 PFM app with ZERO clock code.  115200 8N1.
--
-- Notes:
--    - PAIRING RULE and fuse derivation: see blink_200mhz_ownboot.jal
--      and fixes/fix_pic32_loader_boot_init_compiler.md.
--    - UART: PBCLK2 = 100 MHz (PB2DIV reset /2), BRGH = 1 to
--      BRG 216 = 115200 baud.
--    - Build & program:
--        ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' this file
--        python3 scripts/pic32_program_hex_build.py this.hex out.hex \
--          --alias-only --devcfg0 0x41000000 --devcfg1 0x400131A0 \
--          --devcfg2 0x5F740439 --devcfg3 0x403FF753
--        # then: ipecmd -E, then one -YS -M -OL program of out.hex,
--        # then POWER CYCLE the board
--
-- QEMU/harness contract (@sim_validate): duration generous for the flash
--   loop + heartbeat; the tally line is checked via uart_contains.
-- @sim_validate begin
-- machine: pic32mz-explorer16
-- duration_s: 150.0
-- expect byte v_checks 7
-- uart_contains: ##DONE##
-- @sim_validate end

-----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
alias led2 is pin_E0
pin_E1_direction = OUTPUT
pin_E0_direction = OUTPUT

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1             -- U1RXR code for RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

-- ---------------------------------------------------------------------------
-- the feature under test: procedures with optional parameters
-- ---------------------------------------------------------------------------

var byte r_lo = 0
var byte r_hi = 0

-- three-formal signature, two of them optional
procedure led_flash(byte in times, optional word in ms default 250,
    optional bit in invert default false) is
   var byte n
   for times using n loop
      if invert then
         led2 = ON
      else
         led1 = ON
      end if
      var word ms_left
      ms_left = ms
      while ms_left > 0 loop          -- _usec_delay takes a CONST on PIC32
         _usec_delay(1000)            -- ms x 1 ms units instead
         ms_left = ms_left - 1
      end loop
      led1 = OFF
      led2 = OFF
      _usec_delay(20_000)
   end loop
   r_lo = byte(times)          -- expose the inputs for the self-checks
   r_hi = byte(ms)
end procedure

-- volatile formal with a default
procedure report(optional byte in level default 7) is
   print_string(serial_data, "level=")
   print_byte_dec(serial_data, level)
   print_string(serial_data, "\r\n")
   r_lo = level
end procedure

-- open-array (string literal) default: COUNT() inside sees its length
procedure tag(optional byte in txt[] default "jal") is
   print_string(serial_data, "tag=")
   print_string(serial_data, txt)
   print_string(serial_data, " (len ")
   print_byte_dec(serial_data, byte(COUNT(txt)))
   print_string(serial_data, ")\r\n")
   r_hi = byte(COUNT(txt))
end procedure

var byte checks = 0

-- 5 s grace period: time to open a serial terminal after power-up
for 5 loop
   led1 = ON
   _usec_delay(80_000)
   led1 = OFF
   _usec_delay(920_000)
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 optional-params demo - PIC32MZ\r\n")
print_string(serial_data, "boot: own boot init, SYSCLK 200 MHz, 115200 8N1\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- scalar defaults, every arity ---\r\n")
led_flash(2, 100, true)               -- full arity
if (r_lo == 2) & (r_hi == 100) then checks = checks + 1 end if
print_string(serial_data, "full arity:   ") ; print_byte_dec(serial_data, checks)
print_string(serial_data, " (r_lo/r_hi ok)\r\n")

led_flash(3, 90)                      -- omit the bit to default false
if (r_lo == 3) & (r_hi == 90) then checks = checks + 1 end if
print_string(serial_data, "word omitted default fills: ok\r\n")

led_flash(4)                          -- both defaults: 250 ms, false
if (r_lo == 4) & (r_hi == 250) then checks = checks + 1 end if
print_string(serial_data, "all omitted defaults fill: ok\r\n")

print_string(serial_data, "--- scalar byte default ---\r\n")
report()                              -- level = 7
if r_lo == 7 then checks = checks + 1 end if
report(9)                             -- explicit
if r_lo == 9 then checks = checks + 1 end if

print_string(serial_data, "--- open-array default ---\r\n")
tag()                                 -- "jal", len 3
if r_hi == 3 then checks = checks + 1 end if
tag("custom-tag")                     -- len 10
if r_hi == 10 then checks = checks + 1 end if

print_string(serial_data, "\r\nchecks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 7\r\n")
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##\r\n")

var byte seconds = 0
forever loop
   led1 = ON
   led2 = ON
   print_string(serial_data, "alive - ")
   print_byte_dec(serial_data, seconds)
   print_string(serial_data, " s\r\n")
   seconds = seconds + 1
   _usec_delay(100_000)
   led1 = OFF
   led2 = OFF
   _usec_delay(900_000)
end loop

