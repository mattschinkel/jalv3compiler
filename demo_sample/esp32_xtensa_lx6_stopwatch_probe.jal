-- Title: ESP32 stopwatch probe (delay exactness on silicon)
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Sample-kit speed probe, ESP32 twin of
--    32mz1024efh064_stopwatch_probe.jal: stopwatch-bracketed 1 s
--    _usec_delay printing real-time TIMG0 ticks per heartbeat.  The
--    delay polls TIMG1 (hardware-timed, CPU-independent), the stopwatch
--    reads TIMG0 (25 ns real-time ticks), so an exact delay reads
--    exactly 40_000_000 ticks (plus the measurement bracket) whatever
--    the CPU is doing.  The LED is ON for the measured second and OFF
--    for the idle second, so a slow clock shows as both a slow LED and
--    an inflated tick count.
--
-- Sources:
--    fixes/fix_esp32_delay_timer_based.md (the TIMG1 delay rewrite)
--    fixes/fix_stopwatch_32bit_port.md (the stopwatch library)
--
-- Notes:
--    - BENCH CAVEAT (2026-10-23): keep the serial MONITOR connection
--      open during long observations (the host's /dev/ttyUSBx session,
--      e.g. a terminal or serial-monitor program -- not physical USB:
--      the cable stays plugged in either way).  With no program holding
--      the port open (~1 min+), the CP2102 bridge enters a closed state
--      that glitches this board's auto-reset/EN circuit -- at the 240 MHz
--      1.25 V margin the core takes a transient execution hit (a self-
--      recovering print-block spin with frozen timer reads); opening a
--      serial session again clears it.  Not USB autosuspend (disabled
--      at interface and device level -- still occurs) and not DTR/RTS
--      state (held asserted -- still occurs).
--    - esptool write_flash 0x1000 (image sliced from the hex2flashbin
--      full-flash bin; see fixes/fix_pic32_physical_hex_default.md for
--      the slicing recipe).  After flashing, POWER CYCLE the board
--      before trusting speed readings (RTS-only resets leave this
--      board in a degraded state -- see the bench note in the fix doc).
--    - UART0 115200 8N1 (USB serial).
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

include stopwatch

alias led is pin_2_out
pin_2_direction = TRUE   -- GPIO_ENABLE: TRUE = output

var word beat = 0

print_string(serial_data, "ESP32 timing probe 240 MHz\r\n")

forever loop
   led = ON
   stopwatch_init()
   stopwatch_start()
   _usec_delay(1_000_000)
   var dword d1 = stopwatch_read_cycles()
   print_string(serial_data, "delay_1s ticks=")
   print_dword_dec(serial_data, d1)
   print_string(serial_data, " beat=")
   print_word_dec(serial_data, beat)
   print_string(serial_data, "\r\n")
   beat = beat + 1
   led = OFF
   _usec_delay(1_000_000)
end loop

