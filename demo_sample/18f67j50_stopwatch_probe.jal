-- Title: PIC18F67J50 stopwatch probe — classic PIC18 (16-bit) tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: a timer-based timing probe on the PIC18F67J50.  TMR0 runs
--              from the instruction clock with a 1:256 prescaler; the sample
--              zeroes it, waits 1 ms with `_usec_delay`, and prints the
--              elapsed tick count.  At 48 MHz one instruction cycle is
--              20.83 ns, so 1 ms is 48000 cycles = ~187 ticks.
--
--              Results are printed on UART1 and the LED shows in-window.

include 18f67j50

pragma target clock     48_000_000
pragma target OSC       INTOSC_NOCLKOUT_PLL
pragma target PLLDIV    P2
pragma target CPUDIV    P1
pragma target WDT       CONTROL
pragma target XINST     DISABLED
pragma target DEBUG     DISABLED
pragma target FCMEN     DISABLED
pragma target IESO      DISABLED
--
WDTCON_SWDTEN = OFF
OSCCON_SCS = 0
OSCTUNE_PLLEN = TRUE
--
enable_digital_io()
_usec_delay(100_000)
--
alias led1 is pin_G2
pin_G2_direction = OUTPUT
--
const serial_hw_baudrate = 115200
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4
include print
include format
--

var byte ticks
var byte bad = 0
--
print_string(serial_data, "JALv2 PIC18F67J50: stopwatch probe\r\n")
--
T0CON_T0CS = 0
T0CON_PSA  = 0
T0CON_T0PS = 0b111                  -- 1:256
T0CON_T08BIT = 1                    -- 8-bit counter
--
forever loop
   TMR0L = 0
   _usec_delay(1000)                -- 1 ms
   ticks = TMR0L
   print_string(serial_data, "1 ms -> TMR0 ticks: ")
   print_byte_dec(serial_data, ticks)
   print_crlf(serial_data)
   if (ticks >= 180) & (ticks <= 195) then
      led1 = ON
   else
      led1 = OFF
      bad = bad + 1
   end if
   _usec_delay(500_000)
end loop
