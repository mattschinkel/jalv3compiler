-- Title: ESP32 soft-float math (IEEE-754 single precision)
-- Author: Matthew Schinkel
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: Shows IEEE-754 single-precision support added since jalv2 2.5r9:
-- `var float` arithmetic (add/sub/mul/div), mixed float/integer
-- expressions, all six comparisons, and the float-to-int /
-- int-to-float conversions. The ESP32 has no FPU in this
-- configuration, so all operations run the compiler's outlined
-- soft-float routines. Output on UART0 at 115200.
--
-- Sources:
--
--
--
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw

_usec_delay(1_000_000) -- start delay: open the terminal BEFORE powering (bench rule); 1 s is enough and keeps QEMU runs sane

var byte serial_data = 0
procedure serial_data'put(byte in v) is
   serial_hw_putc(v)
end procedure

include print

var float pi      = 3.14159265
var float radius  = 2.5
var float area
var float mean
var float ratio
var sdword scaled
var byte checks = 0

procedure print_flt(float in v) is
   print_float(serial_data, v)
end procedure

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 ESP32 demo: float math\r\n")
print_string(serial_data, "  IEEE-754 single precision, soft-float\r\n")
print_string(serial_data, "  routines (no FPU)\r\n")
print_string(serial_data, "========================================\r\n")

-- multiply, mixed with an integer constant
print_string(serial_data, "--- multiply: pi * r * r -----------------\r\n")
area = pi * radius * radius
print_string(serial_data, "area (pi*r*r)       = ")
print_flt(area)
if area > 19.6 then
   if area < 19.7 then
      checks = checks + 1
      print_string(serial_data, "  OK (~19.63)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~19.63)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~19.63)\r\n")
end if

-- divide
print_string(serial_data, "--- divide: r / pi -----------------------\r\n")
ratio = radius / pi
print_string(serial_data, "radius / pi         = ")
print_flt(ratio)
if ratio > 0.79 then
   if ratio < 0.80 then
      checks = checks + 1
      print_string(serial_data, "  OK (~0.796)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~0.796)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~0.796)\r\n")
end if

-- add/sub chain with a negative-adjacent result
print_string(serial_data, "--- add / subtract chain ------------------\r\n")
mean = pi - 4.0 + 1.0
print_string(serial_data, "pi - 4 + 1          = ")
print_flt(mean)
if mean > 0.14 then
   if mean < 0.15 then
      checks = checks + 1
      print_string(serial_data, "  OK (~0.142)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~0.142)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~0.142)\r\n")
end if

-- float to integer truncation
print_string(serial_data, "--- float to int truncation ---------------\r\n")
scaled = sdword(pi * 1000.0)
print_string(serial_data, "pi * 1000 truncated = ")
print_sdword_dec(serial_data, scaled)
if scaled == 3141 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 3141)\r\n")
end if

-- integer to float in an expression
print_string(serial_data, "--- int to float in an expression ---------\r\n")
var float fi = 7
fi = fi / 2
print_string(serial_data, "7 / 2 (inttofloat)  = ")
print_flt(fi)
if fi > 3.4999 then
   if fi < 3.5001 then
      checks = checks + 1
      print_string(serial_data, "  OK\r\n")
   else
      print_string(serial_data, "  WRONG (want 3.5)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want 3.5)\r\n")
end if

-- comparisons
print_string(serial_data, "--- comparisons ---------------------------\r\n")
if pi > radius then
   checks = checks + 1
   print_string(serial_data, "pi > radius:        true  OK\r\n")
else
   print_string(serial_data, "pi > radius:        false  WRONG\r\n")
end if
if mean < 1.0 then
   checks = checks + 1
   print_string(serial_data, "mean < 1:           true  OK\r\n")
else
   print_string(serial_data, "mean < 1:           false  WRONG\r\n")
end if
if radius <= 2.5 then
   checks = checks + 1
   print_string(serial_data, "radius <= 2.5:      true  OK\r\n")
else
   print_string(serial_data, "radius <= 2.5:      false  WRONG\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 8\r\n")
if checks == 8 then
   print_string(serial_data, "ALL FLOAT CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

