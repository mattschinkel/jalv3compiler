-- Title: PIC32MZ1024EFH064 hardware interrupt sample (own-boot, single vector)
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Generic interrupt demo for the PIC32MZ1024EFH064 bench board.  One
--    `pragma interrupt` handler owns IRQ0; main raises the flag eight
--    times, and after each raise waits for the handler to clear it.  So
--    `hits` reaches 8 only if every request went flag -> EIC -> vector
--    -> handler -> clear -> ERET -> main.
--
--    Output (UART1, 115200, TX RPF0 / RX RPF1) uses the shared probe
--    tokens so the same capture script works on every architecture:
--        ##ISR## boot irq0
--        ##ISR## hits=8 done=1
--        ##ISR-OK## hits=8 done=1        (heartbeat, repeats)
--
--    The QEMU gate for this program is
--    sims/pic32/32mz1024efh064_isr_dispatch.jal (same body + the
--    @sim_validate block); the MX twin is
--    demo_sample/32mx270f256b_isr_hw.jal, the PIC18 twin
--    demo_sample/18f67j50_isr_hw.jal, the ESP32 twin
--    demo_sample/esp32_isr_hw.jal.
--
-- Notes:
--    Board: 32MZ1024EFH064 (PK5).  The arming clears the power-on
--    Cause.IP[1:0] request before releasing the exception level, and
--    every handler entry clears it again -- without that, ISR images are
--    dark on this part (fixes/fix_pic32_mz_isr_state_clear.md).
--    Flash:  python3 pic_programmer.py program --board mini32 --file <hex>
--    Capture: python3 jal-private/ftdi_usb_serial.py --seconds 5 --baud 115200
--
-- -----------------------------------------------------------------------------
include 32mz1024efh064                -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 100_000_000        -- FRC + SPLL
pragma target OSC    FRC_SPLL
pragma target image pfm                -- PFM app + compiler boot block
pragma target WDT   DISABLED
pragma target DMT   DISABLED
--
enable_digital_io()
_usec_delay(100_000)
--
-- UART1 (bench wiring: TX RPF0, RX RPF1)
const serial_hw_baudrate = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1
include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
--
include print
--
var volatile byte hits = 0
var volatile byte done = 0
--
procedure _ct_isr() is
   pragma interrupt                  -- single vector, SRS path

   IFS0CLR = 1                       -- clear IRQ0
   hits = hits + 1
end procedure
--
print_string(serial_data, "##ISR## boot irq0")
print_crlf(serial_data)
--
IPC0 = 0x1C                          -- IRQ0: priority 7, subpriority 0
IEC0SET = 1                          -- enable IRQ0
--
var word guard = 0
for 8 loop
   IFS0SET = 1                       -- raise IRQ0
   guard = 0
   while ((IFS0 & 1) == 1) & (guard < 20000) loop
      guard = guard + 1              -- dispatch must clear the flag
   end loop
end loop
--
if hits == 8 then
   done = 1
end if
--
print_string(serial_data, "##ISR## hits=")
print_dword_dec(serial_data, hits)
print_string(serial_data, " done=")
print_dword_dec(serial_data, done)
print_crlf(serial_data)

if done == 1 then
   print_string(serial_data, "##ISR-OK##")
else
   print_string(serial_data, "##ISR-FAIL##")
end if
print_crlf(serial_data)
--
forever loop
   if done == 1 then
      print_string(serial_data, "##ISR-OK##")
   else
      print_string(serial_data, "##ISR-FAIL##")
   end if
   print_string(serial_data, " hits=")
   print_dword_dec(serial_data, hits)
   print_string(serial_data, " done=")
   print_dword_dec(serial_data, done)
   print_crlf(serial_data)
   _usec_delay(500_000)
end loop
