-- Title: PIC32MZ1024EFH064 hardware interrupt sample (Timer1 IRQ, own-boot)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    PIC32 interrupt-path demo (QEMU-proven; not yet working on
--    hardware possible due to a bad address on my chip.
--    See fixes/fix_pic32_loader_isr_vector.md).  The T1
--    vector (IRQ 4) is enabled and prioritized, then the flag is
--    software-set (IFS0SET): under QEMU the pragma-interrupt handler
--    dispatches through the single vector (EBASE+0x200 to stub),
--    clears the flag, bumps the counter, and returns -- the main
--    loop's wait exits and heartbeats print forever.  On the MZ EF
--    silicon bench the Status EXL/ERL clear needed for dispatch hangs
--    the core in loader images (bisection in the fix doc), so this
--    sample is the QEMU gate for the path.  Also documented there:
--    Timer1 counts but its PR1 period match never fires on this part
--    (Type-A quirk, open).  Own-boot recipe throughout.
--
-- Sources:
--    fixes/fix_pic32_phase3g_isr.md (EIC vector + ERET)
--
-- Notes:
--    EXPECTED OUTPUT TODAY (both QEMU direct and silicon): the banner and
--    the two "arming:" lines print, then the program parks silently in
--    the dispatch wait -- NO "ISR FIRED", no heartbeats.  That is the
--    documented open item (Status EXL/ERL enable sequence hangs silicon
--    loader images; QEMU's EVIC does not self-dispatch loader images
--    either), NOT a build error.  Do not chase a "fix" on this sample
--    until fixes/fix_pic32_loader_isr_vector.md's open item lands.
--    - Build & program (no splice needed; physical addresses default):
--        ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' this file
--        python3 pic_programmer.py program --file this.hex
--    - 115200 8N1 on UART1 (RPF0/RPF1), same wiring as print.
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
pin_E1_direction = OUTPUT

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1             -- U1RXR code for RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

var volatile word isr_tick = 0
var word last_seen = 0
var byte checks = 0
var byte seconds = 0

--------------------------------------------------------------------------------
-- Description: Timer1 interrupt handler (fires every 500 us)
-- Parameters: none (pragma interrupt)
-- Returns: none
-- Notes: clears T1IF (IFS0 bit 4) so ERET does not re-enter, then
-- - bumps the counter the main loop observes.
--------------------------------------------------------------------------------
procedure _t1_isr() is
   pragma interrupt
   IFS0CLR = 0x0010          -- T1IF: write-1-to-clear
   isr_tick = isr_tick + 1
end procedure

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 PIC32 hardware interrupt demo\r\n")
print_string(serial_data, "Timer1 IRQ @ ~2000 Hz, own-boot 200 MHz\r\n")
print_string(serial_data, "========================================\r\n")

-- arm the T1 vector, then software-trigger the flag
print_string(serial_data, "arming: enable T1 vector\r\n")
IPC0    = 0x00000004          -- T1 priority 1
IFS0CLR = 0x0010              -- clear any stale T1IF
IEC0SET = 0x0010              -- T1 interrupt enable
print_string(serial_data, "arming: software trigger\r\n")
IFS0SET = 0x0010              -- set T1IF: dispatch must follow

-- first dispatch: reachable only if the vector + EVIC path works.
-- the delay keeps this loop self-invalidating (a hung wait still
-- crash-recovers into the next reprogram on this board)
while isr_tick == 0 loop
   _usec_delay(1_000)
end loop
print_string(serial_data, "ISR FIRED, first tick in flight\r\n")
checks = checks + 1
print_string(serial_data, "OK  interrupt dispatch\r\n")

for 5 loop
   led1 = ON
   _usec_delay(80_000)
   led1 = OFF
   _usec_delay(920_000)
end loop

forever loop
   _usec_delay(1_000_000)
   seconds = seconds + 1
   print_string(serial_data, "isr_tick=")
   print_word_dec(serial_data, isr_tick)
   if isr_tick >= 1 then
      checks = checks + 1
      print_string(serial_data, " OK\r\n")
   else
      print_string(serial_data, " WRONG (want >= 1)\r\n")
   end if
   if seconds == 10 then
      print_string(serial_data, "checks passed: ")
      print_byte_dec(serial_data, checks)
      print_string(serial_data, "\r\nSample complete.\r\n##DONE##\r\n")
   end if
end loop

