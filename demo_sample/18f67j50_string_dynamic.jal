-- Title: PIC18F67J50 string dynamic feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: string dynamic demo for the classic PIC18F67J50 bench
--              board (48 MHz INTOSC+PLL, serial on UART1). The test body
--              lives in the j50_string_dynamic_body include block.
--
-- Requires: j50_string_dynamic_body
-- This file has been generated by Matt's sample generator.
--

include 18f67j50                      -- target PICmicro
--
-- This program uses the internal oscillator with PLL active.
pragma target clock 48_000_000      -- oscillator frequency
--
pragma target OSC      INTOSC_NOCLKOUT_PLL       -- internal oscillator
pragma target PLLDIV   P2                        -- 8 MHz -> 4 MHz
pragma target CPUDIV   P1                        -- Fosc divisor
pragma target WDT      CONTROL                   -- watchdog
pragma target XINST    DISABLED                  -- extended instruction set
pragma target DEBUG    DISABLED                  -- debugging
pragma target FCMEN    DISABLED                  -- clock monitoring
pragma target IESO     DISABLED                  -- int/ext osc. switch
--
-- The configuration bit settings above are only a selection, sufficient
-- for this program. Other programs may need more or different settings.
--
WDTCON_SWDTEN = OFF                 -- disable WDT
OSCCON_SCS = 0                      -- select primary oscillator
OSCTUNE_PLLEN = TRUE                -- use PLL
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay (100_000) -- wait for power to stablilize

-- 18f67j50 port of the string_dynamic demo (classic PIC18, 48 MHz INTOSC+PLL;
--   LED on RG2, serial on UART1 @115200 via the bench FTDI)
alias led1 is pin_G2
alias led2 is pin_G3
pin_G2_direction = TRUE
pin_G3_direction = TRUE

-- setup uart for communication (FTDI on UART1: TX=RC6, RX=RC7, fixed pins)
const serial_hw_baudrate  = 115200
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format
const word _string_heap_size = 255
pragma string index byte

include strings_dynamic

var string greeting
var string name = "JALv2 ESP32!"
var string out
var string expected
var byte src[4]
var byte cnt
var dword addr
var sqword big_signed
var volatile byte checks = 0

var string greeting2 = "Test"

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC18F67J50 demo: dynamic strings\r\n")
print_string(serial_data, "  var string on a compacting heap,\r\n")
print_string(serial_data, "  & chains, COUNT(), == compares\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- basics: assign + COUNT --------------\r\n")
-- name = "JAL" & "v2 " & "ESP32!"   -- literals-only chains were already legal;

print_string(serial_data, "name:            ")
print_string(serial_data, name)
print_crlf(serial_data)

print_string(serial_data, "greeting length: ")
print_byte_dec(serial_data, COUNT(greeting))
print_crlf(serial_data)

print_string(serial_data, "name length:     ")
print_byte_dec(serial_data, COUNT(name))
print_crlf(serial_data)

-- Concatenate onto an existing string and compare with a literal
print_string(serial_data, "--- assignment chain + compare ----------\r\n")
greeting = "Hello, " & name          -- assignment chains: string operands
if greeting == "Hello, JALv2 ESP32!" then
   checks = checks + 1
   print_string(serial_data, "combined:        MATCH (")
   print_byte_dec(serial_data, COUNT(greeting))
   print_string(serial_data, " chars)\r\n")
else
   print_string(serial_data, "combined:        MISMATCH\r\n")
end if

-- Stage 1: `&` chains in EXPRESSION position -- compare operands on
-- either side of `==`, and procedure arguments
print_string(serial_data, "--- & chains in expression position ------\r\n")
if greeting == "Hello, " & name then
   checks = checks + 1
   print_string(serial_data, "expr-chain ==:   MATCH\r\n")
else
   print_string(serial_data, "expr-chain ==:   MISMATCH\r\n")
end if
if "Hello, " & name == greeting then
   checks = checks + 1
   print_string(serial_data, "chain-LHS ==:    MATCH\r\n")
else
   print_string(serial_data, "chain-LHS ==:    MISMATCH\r\n")
end if
if greeting != "A" & name & "B" then
   checks = checks + 1
   print_string(serial_data, "expr-chain !=:   MATCH\r\n")
else
   print_string(serial_data, "expr-chain !=:   MISMATCH\r\n")
end if
print_string(serial_data, "arg-chain:       ")
print_string(serial_data, "arg-" & name)   -- "prefix-" & name as an argument
print_crlf(serial_data)

-- Stages 2a/2b: integer operands render ASCII decimal in chains
print_string(serial_data, "--- integer operands in chains -----------\r\n")
cnt = 42
addr = 4294967295
big_signed = -1234567890
out = "cnt=" & cnt & " addr=" & addr
print_string(serial_data, out)
print_crlf(serial_data)
out = "neg: " & -42 & " sqw: " & big_signed
print_string(serial_data, out)
print_crlf(serial_data)
if out == "neg: -42 sqw: -1234567890" then
   checks = checks + 1
   print_string(serial_data, "int-chain ==:    MATCH\r\n")
else
   print_string(serial_data, "int-chain ==:    MISMATCH\r\n")
end if

-- Stage 2d: float constants, shortest-round-trip decimal
print_string(serial_data, "--- float constants in chains ------------\r\n")
out = "pi~ " & 1.5 & " neg " & -2.25 & " hun " & 100.0
print_string(serial_data, out)
print_crlf(serial_data)
if out == "pi~ 1.5 neg -2.25 hun 100" then
   checks = checks + 1
   print_string(serial_data, "float-chain ==:  MATCH\r\n")
else
   print_string(serial_data, "float-chain ==:  MISMATCH\r\n")
end if

-- Text casts: string(x) / hex(x) / bin(x) on runtime values.
-- Const operands fold at compile time; runtime scalars render through
-- the cast machinery into a heap string; cast results compose with
-- chains like any string value.
print_string(serial_data, "--- text casts: dec/hex/bin/string --------\r\n")
cnt = 26
out = "dec:  " & cnt & " (" & -7 & ")"
print_string(serial_data, out)
print_crlf(serial_data)
out = "hex:  " & hex(cnt) & " pad4 " & hex(cnt, 4)
print_string(serial_data, out)
print_crlf(serial_data)
out = "bin:  " & bin(5) & " pad8 " & bin(5, 8)
print_string(serial_data, out)
print_crlf(serial_data)
if (string(cnt) == "26") & (hex(cnt) == "1a") & (hex(cnt, 4) == "001a") then
   checks = checks + 1
   print_string(serial_data, "dec/hex ==:      MATCH\r\n")
else
   print_string(serial_data, "dec/hex ==:      MISMATCH\r\n")
end if
-- string() copies a byte array's bytes as characters; a const byte
-- array folds at compile time (TBL to the three chars 1,2,3)
src[0] = "*"
src[1] = "+"
src[2] = "!"
src[3] = "?"
out = string(src) & "END"
if out == "*+!?END" then
   checks = checks + 1
   print_string(serial_data, "string(arr):     MATCH\r\n")
else
   print_string(serial_data, "string(arr):     MISMATCH\r\n")
end if
const byte TBL[3] = {1, 2, 3}
print_string(serial_data, "hex(TBL):        ")
print_string(serial_data, hex(TBL))
print_crlf(serial_data)
if hex(TBL) == "010203" then
   checks = checks + 1
   print_string(serial_data, "hex(arr) ==:     MATCH\r\n")
else
   print_string(serial_data, "hex(arr) ==:     MISMATCH\r\n")
end if

-- Build a string from a byte array
print_string(serial_data, "--- string_from_array --------------------\r\n")
src[0] = "d"
src[1] = "o"
src[2] = "n"
src[3] = "e"
if string_from_array(name, src) then
   if name == "done" then
      checks = checks + 1
      print_string(serial_data, "from array:      ok\r\n")
   else
      print_string(serial_data, "from array:      WRONG CONTENT\r\n")
   end if
else
   print_string(serial_data, "from array:      FAILED\r\n")
end if

-- Subscripts: str[i] reads and writes the i-th CHARACTER (payload
-- through the heap handle; unchecked like array subscripts)
print_string(serial_data, "--- subscripts: str[i] chars --------------\r\n")
out = "hello world"
if out[0] == "h" then
   checks = checks + 1
   print_string(serial_data, "read str[0]:     MATCH\r\n")
else
   print_string(serial_data, "read str[0]:     MISMATCH\r\n")
end if
cnt = out[6]                -- runtime position read into a byte
if cnt == "w" then
   checks = checks + 1
   print_string(serial_data, "read str[6]:     MATCH\r\n")
else
   print_string(serial_data, "read str[6]:     MISMATCH\r\n")
end if
out[6] = "W"                -- char-literal write
cnt = 4
out[cnt] = "O"              -- runtime-index write
if (out[6] == "W") & (out[4] == "O") then
   checks = checks + 1
   print_string(serial_data, "write back:      MATCH\r\n")
else
   print_string(serial_data, "write back:      MISMATCH\r\n")
end if
if COUNT(out) == 11 then
   checks = checks + 1
   print_string(serial_data, "COUNT unchanged: MATCH\r\n")
else
   print_string(serial_data, "COUNT unchanged: MISMATCH\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 14\r\n")
if checks == 14 then
   print_string(serial_data, "ALL STRING CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

