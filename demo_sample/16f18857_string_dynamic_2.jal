-- Title: PIC16F18857 string_dynamic_2 feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: string_dynamic demo for the enhanced-midrange PIC16F18857 (32 MHz
--              INTOSC+PLL, serial on EUSART). The test body lives in
--              the f18857_string_dynamic_body include block.
--
-- Requires: f18857_string_dynamic_2_body
-- This file has been generated by Matt's sample generator.
--

include 16f18857                     -- target PICmicro
pragma target clock 32_000_000
pragma target OSC      OFF           -- internal oscillator
pragma target RSTOSC   HFINT32       -- power-up clock select (32 MHz)
pragma target CLKOUTEN DISABLED      -- no clock output
pragma target WDT      DISABLED      -- watchdog
pragma target BROWNOUT DISABLED      -- no brownout reset
pragma target FCMEN    DISABLED      -- no clock monitoring
pragma target CSWEN    ENABLED       -- allow OSCCON1 writes
pragma target LVP      ENABLED       -- low voltage programming
pragma target MCLR     EXTERNAL      -- external reset
--
enable_digital_io()                  -- make all pins digital I/O
_usec_delay (100_000)                -- wait for power to stabilize

-- 16f18857 port of the string_dynamic demo (enhanced midrange PIC16, 32 MHz
--   HFINTOSC; LED on A0, serial on EUSART @115200)
alias led1 is pin_A0
alias led2 is pin_A1
pin_A0_direction = OUTPUT
pin_A1_direction = OUTPUT

-- setup uart for communication (C6/C7 via PPS, the JALPIC One wiring)
const serial_hw_baudrate  = 115200
include pps
pps_control_lock(FALSE)
RC6PPS = PPS_TX
RXPPS  = PPS_RC7
pps_control_lock(TRUE)
alias pin_TX is pin_C6
alias pin_TX_direction is pin_C6_direction
alias pin_RX is pin_C7
alias pin_RX_direction is pin_C7_direction

include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format
pragma target string_heap_size 80
pragma string index byte

include strings_dynamic
var string name = "JALv2!"
var string out
var byte src[4]
var byte cnt
var volatile byte checks = 0
print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC16F1825 demo: dynamic strings (2 of 2)\r\n")
print_string(serial_data, "  text casts (hex), string_from_array, subscripts\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- text casts: dec/hex/string ------------\r\n")
cnt = 26
out = "dec:  " & cnt & " (" & -7 & ")"
print_string(serial_data, out)
print_crlf(serial_data)
out = "hex:  " & hex(cnt)
print_string(serial_data, out)
print_crlf(serial_data)
if (string(cnt) == "26") & (hex(cnt) == "1a") then
   checks = checks + 1
   print_string(serial_data, "dec/hex ==:      MATCH\r\n")
else
   print_string(serial_data, "dec/hex ==:      MISMATCH\r\n")
end if
const byte TBL[3] = {1, 2, 3}
print_string(serial_data, "hex(TBL):        ")
print_string(serial_data, hex(TBL))
print_crlf(serial_data)
if hex(TBL) == "010203" then
   checks = checks + 1
   print_string(serial_data, "hex(arr) ==:     MATCH\r\n")
else
   print_string(serial_data, "hex(arr) ==:     MISMATCH\r\n")
end if
-- Build a string from a byte array
print_string(serial_data, "--- string_from_array --------------------\r\n")
src[0] = "d"
src[1] = "o"
src[2] = "n"
src[3] = "e"
if string_from_array(name, src) then
   if name == "done" then
      checks = checks + 1
      print_string(serial_data, "from array:      ok\r\n")
   else
      print_string(serial_data, "from array:      WRONG CONTENT\r\n")
   end if
else
   print_string(serial_data, "from array:      FAILED\r\n")
end if

-- Subscripts: str[i] reads and writes the i-th CHARACTER (payload
-- through the heap handle; unchecked like array subscripts)
print_string(serial_data, "--- subscripts: str[i] chars --------------\r\n")
out = "hello world"
if out[0] == "h" then
   checks = checks + 1
   print_string(serial_data, "read str[0]:     MATCH\r\n")
else
   print_string(serial_data, "read str[0]:     MISMATCH\r\n")
end if
cnt = out[6]                -- runtime position read into a byte
if cnt == "w" then
   checks = checks + 1
   print_string(serial_data, "read str[6]:     MATCH\r\n")
else
   print_string(serial_data, "read str[6]:     MISMATCH\r\n")
end if
out[6] = "W"                -- char-literal write
cnt = 4
out[cnt] = "O"              -- runtime-index write
if (out[6] == "W") & (out[4] == "O") then
   checks = checks + 1
   print_string(serial_data, "write back:      MATCH\r\n")
else
   print_string(serial_data, "write back:      MISMATCH\r\n")
end if
if COUNT(out) == 11 then
   checks = checks + 1
   print_string(serial_data, "COUNT unchanged: MATCH\r\n")
else
   print_string(serial_data, "COUNT unchanged: MISMATCH\r\n")
end if
print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 7\r\n")
if checks == 7 then
   print_string(serial_data, "ALL STRING CHECKS PASSED (part 2)\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

