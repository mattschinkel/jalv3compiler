-- Title: PIC32MZ1024EFH064 stopwatch probe (internal_osc_8mhz clock)
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Speed probe variant of 32mz1024efh064_stopwatch_probe.jal for the
--    32mz1024efh064_blink_internal_osc_8mhz.jal clock configuration: stopwatch-bracketed 1 s delays printing
--    PBCLK ticks per heartbeat.  An exact delay reads ~100_000_000 ticks
--    (+ the fixed measurement bracket) at ANY solved clock speed --
--    exact = 100_000_000 ticks (T2/T3 counts PBCLK = SYSCLK/2, independent of the FRC/PLL
-- absolute accuracy; only the tick RATE scales with the solved tree)
--    LED on = measured second, LED off = idle second.
--
-- Notes:
--    Program + verify + genuine POR, then read (see the stopwatch
--    probe sample for the bench rules).
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 8_000_000       -- oscillator frequency
pragma target OSC      FRC          -- internal 8 MHz FRC oscillator, no PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
pin_E1_direction = OUTPUT

-- setup uart for communication
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

include stopwatch

var word beat = 0

print_string(serial_data, "PIC32 timing probe 8 MHz\r\n")

forever loop
   led1 = ON
   stopwatch_init()
   stopwatch_start()
   _usec_delay(1_000_000)
   var dword d1 = stopwatch_read_cycles()
   print_string(serial_data, "delay_1s ticks=")
   print_dword_dec(serial_data, d1)
   print_string(serial_data, " beat=")
   print_word_dec(serial_data, beat)
   print_string(serial_data, "\r\n")
   beat = beat + 1
   led1 = OFF
   _usec_delay(1_000_000)
end loop

