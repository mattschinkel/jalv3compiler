-- Title: ESP32 serial hello (UART0 banner + blink)
-- Author: Matthew Schinkel
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: Prints a banner over UART0 (USB-serial, 115200) at startup,
-- then blinks the GPIO 2 LED and prints a per-second "still alive"
-- heartbeat line forever. The banner is a const literal
-- served through the const-pool DRAM load segment, so this sample
-- exercises that path end to end.
--
--
-- Sources:
-- esptool write-flash 0x1000 esp32_serial_hello.hex
--
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

_usec_delay(1_000_000) -- start delay: open the terminal BEFORE powering (bench rule); 1 s is enough and keeps QEMU runs sane

alias led is pin_2_out              -- device-file per-pin alias (RMW; W1TS stays the atomic idiom)
pin_2_direction = TRUE   -- GPIO_ENABLE: TRUE = output

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 ESP32 demo: hello world\r\n")
print_string(serial_data, "  UART0 115200 8N1 (USB serial)\r\n")
print_string(serial_data, "  LED on GPIO 2 blinks as a heartbeat\r\n")
print_string(serial_data, "========================================\r\n")

var word uptime = 0

forever loop
   led = ON         -- alias write (RMW; W1TS stays the atomic idiom)
   _usec_delay(500000)
   led = OFF
   _usec_delay(500000)

   uptime = uptime + 1
   print_string(serial_data, "still alive - ")
   print_word_dec(serial_data, uptime)
   print_string(serial_data, " s\r\n")
end loop

