-- Title: ESP32 cooperative tasks (_task_start / suspend / _task_suspend / _task_resume / _task_kill / _task_restart) with serial feedback
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: Shows the cooperative multitasking added since jalv2 2.5r9:
-- `pragma task N`, `task ... end task`, `_task_start proc()` and `_task_yield`.
-- The scheduler is a deterministic round-robin: every `suspend` hands
-- control to the next live task, and a task that falls off its end
-- removes itself. Two worker tasks print per-slice lines interleaved
-- with main-slice lines, then main tallies the per-task counters and
-- prints PASS/FAIL + ##DONE## so the run validates from the serial log
-- alone (115200 on UART0, parks when done).
--
-- Expected transcript (round-robin preserves start order:
-- main to A to B to main ...; QEMU-verified 2026-09-26):
--   ========================================
--     JALv2 ESP32 demo: cooperative tasks
--     round-robin scheduler: task_start,
--     _task_yield, tasks end by falling off
--   ========================================
--   starting task A + task B
--   main slice 1
--   task A slice 1
--   task B slice 1
--   main slice 2
--   task A slice 2
--   task B slice 2 (last)
--   main slice 3 (last)
--   task A slice 3 (last)
--   task A ran 3 slices
--   task B ran 2 slices
--   TASKS: PASS
--   Sample complete.
--   ##DONE##
--
-- Sources:
-- (task port)
--

-- @sim_validate begin
-- duration_s: 25
-- icount: 6
-- machine: esp32
-- expect byte v_ta_count 3
-- expect byte v_tb_count 2
-- expect byte v_tc_count 9
-- uart_contains: ##DONE##
-- @sim_validate end
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

_usec_delay(1_000_000) -- start delay: open the terminal BEFORE powering (bench rule); 1 s is enough and keeps QEMU runs sane

pragma task 4          -- main + three workers

-- Task bodies share the starter's stack (leaf frames): keep state in
-- globals, never in task-local variables.
var volatile byte ta_count = 0
var volatile byte tb_count = 0
var byte main_count = 0

--------------------------------------------------------------------------------
-- Description: Worker A: three slices, yields between each, then ends
task worker_a() is
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 1")
   print_crlf(serial_data)
   _task_yield
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 2")
   print_crlf(serial_data)
   _task_yield
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 3 (last)")
   print_crlf(serial_data)
end task

--------------------------------------------------------------------------------
-- Description: Worker B: two slices, yields between each, then ends
task worker_b() is
   tb_count = tb_count + 1
   print_string(serial_data, "task B slice 1")
   print_crlf(serial_data)
   _task_yield
   tb_count = tb_count + 1
   print_string(serial_data, "task B slice 2 (last)")
   print_crlf(serial_data)
end task

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 ESP32 demo: cooperative tasks\r\n")
print_string(serial_data, "  round-robin scheduler: task_start,\r\n")
print_string(serial_data, "  _task_yield, tasks end by falling off\r\n")
print_string(serial_data, "========================================\r\n")
print_string(serial_data, "starting task A + task B\r\n")

_task_start worker_a()
_task_start worker_b()

for 3 loop
   main_count = main_count + 1
   if main_count == 3 then
      print_string(serial_data, "main slice 3 (last)")
   else
      print_string(serial_data, "main slice ")
      print_byte_dec(serial_data, main_count)
   end if
   print_crlf(serial_data)
   _task_yield
end loop

print_string(serial_data, "task A ran ")
print_byte_dec(serial_data, ta_count)
print_string(serial_data, " slices")
print_crlf(serial_data)

print_string(serial_data, "task B ran ")
print_byte_dec(serial_data, tb_count)
print_string(serial_data, " slices")
print_crlf(serial_data)

if ta_count == 3 then
   if tb_count == 2 then
      print_string(serial_data, "TASKS: PASS")
   else
      print_string(serial_data, "TASKS: FAIL (B count)")
   end if
else
   print_string(serial_data, "TASKS: FAIL (A count)")
end if
print_crlf(serial_data)

-- Task control from main: _task_suspend parks a task while others
-- keep running; _task_resume continues it; _task_kill removes it;
-- _task_restart re-runs it from its entry. A third worker counts its
-- slices in a global.
var volatile byte tc_count = 0
var volatile byte tc_gen = 0

task worker_c() is
   tc_gen = tc_gen + 1
   forever loop
      tc_count = tc_count + 1
      _task_yield
   end loop
end task

print_string(serial_data, "--- task control -------------------------\r\n")
_task_start worker_c()
for 3 loop
   _task_yield
end loop
print_string(serial_data, "worker C ticks:    ")
print_byte_dec(serial_data, tc_count)
print_crlf(serial_data)

_task_suspend worker_c()
var volatile byte tc_frozen = 0
tc_frozen = tc_count
for 3 loop
   _task_yield
end loop
print_string(serial_data, "suspended ticks:   ")
print_byte_dec(serial_data, tc_count)
if tc_count == tc_frozen then
   print_string(serial_data, "  OK (frozen)\r\n")
else
   print_string(serial_data, "  WRONG (still running)\r\n")
end if

_task_resume worker_c()
for 3 loop
   _task_yield
end loop
print_string(serial_data, "resumed ticks:     ")
print_byte_dec(serial_data, tc_count)
if tc_count > tc_frozen then
   print_string(serial_data, "  OK (running)\r\n")
else
   print_string(serial_data, "  WRONG (still frozen)\r\n")
end if

_task_kill worker_c()
tc_frozen = tc_count
for 3 loop
   _task_yield
end loop
print_string(serial_data, "killed ticks:      ")
print_byte_dec(serial_data, tc_count)
if tc_count == tc_frozen then
   print_string(serial_data, "  OK (dead)\r\n")
else
   print_string(serial_data, "  WRONG (zombie)\r\n")
end if

_task_restart worker_c()
for 3 loop
   _task_yield
end loop
print_string(serial_data, "restarted ticks:   ")
print_byte_dec(serial_data, tc_count)
if tc_count > tc_frozen then
   print_string(serial_data, "  OK (restarted from entry)\r\n")
else
   print_string(serial_data, "  WRONG (not restarted)\r\n")
end if

_task_kill worker_c()

print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

