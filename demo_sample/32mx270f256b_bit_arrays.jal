-- Title: PIC32MX270F256B native bit arrays and bit fields
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    PIC32 port of the ESP32 bit-array demo: native bit arrays and
--    multi-bit field overlays added since jalv2 2.5r9. `var bit flags[N]`
--    packs N bits into bytes (no RAM waste of one byte per flag),
--    indexed bits read/write like array elements, 2D `var bit
--    grid[R][C]` packs the whole matrix (64 bits = 8 bytes for an 8x8
--    grid), and `var bit*W name at reg : pos` overlays a W-bit field
--    inside a register or variable. Output on UART1 at 115200.
--
-- Notes:
--    - Ported from demo_sample/esp32_bit_arrays.jal (same sections and
--      self-check expectations). No clock bring-up: the compiler-emitted
--      boot init + DEVCFG fuses boot straight at 200 MHz.
--    - Compile: ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' -no-codfile this file
--    - QEMU gate: ./tests/jal_sim_validate.sh --compiler ./bin/jalv3-x86-64 this file
--
-- @sim_validate begin
-- duration_s: 8
-- uart_contains: ##DONE##
-- machine: pic32mx7-explorer16
-- expect byte v_checks 4
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 40_000_000      -- oscillator frequency
pragma target OSC    FRC_SPLL       -- internal 8 MHz FRC through the system PLL (/2 x20 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_B14
alias led2 is pin_B13
pin_B14_direction = OUTPUT
pin_B13_direction = OUTPUT

-- setup uart for communication (board wiring: RPB3 = U1TX, RPB2 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_B3
alias serial_hw_pin_tx_direction is pin_B3_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB3R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2             -- U1RXR code for RPB2

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format

-- Sieve of Eratosthenes over a native bit array: 64 flags = 8 bytes
const byte N = 64
var bit composite[N]
var byte i
var byte j
var byte primes = 0
var volatile byte checks = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC32 demo: bit arrays\r\n")
print_string(serial_data, "  packed var bit arrays, multi-bit\r\n")
print_string(serial_data, "  field overlays, 2D bit grid\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- sieve of Eratosthenes (64 flags) ------\r\n")
for N using i loop
   composite[i] = false
end loop
i = 2
while i * i < N loop
   if ! composite[i] then
      j = i * i
      while j < N loop
         composite[j] = true
         j = j + i
      end loop
   end if
   i = i + 1
end loop
for N using i loop
   if i >= 2 then
      if ! composite[i] then
         primes = primes + 1
      end if
   end if
end loop

print_string(serial_data, "primes below 64:  ")
print_byte_dec(serial_data, primes)
if primes == 18 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 18)\r\n")
end if

-- Multi-bit field overlays: carve a byte into named fields
print_string(serial_data, "--- multi-bit field overlays --------------\r\n")
var byte config_shadow = 0
var bit*3 speed_fld at config_shadow : 0    -- bits 2:0
var bit*2 mode_fld   at config_shadow : 3    -- bits 4:3
var bit*1 enable_fld at config_shadow : 5    -- bit  5

speed_fld  = 5         -- 101b
mode_fld   = 2         -- 10b
enable_fld = true      -- 1b

print_string(serial_data, "fields to byte:   0x")
print_byte_hex(serial_data, config_shadow)
if config_shadow == 0x35 then
   checks = checks + 1
   print_string(serial_data, "  OK (0011 0101)\r\n")
else
   print_string(serial_data, "  WRONG (want 35)\r\n")
end if

-- Read a field back
speed_fld = speed_fld + 1
print_string(serial_data, "speed now:        ")
print_byte_dec(serial_data, byte(speed_fld))
if byte(speed_fld) == 6 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 6)\r\n")
end if

-- 2D bit array: an 8x8 matrix grid, 64 bits packed into 8 bytes
-- (LED-matrix style)
print_string(serial_data, "--- 8x8 bit grid --------------------------\r\n")
var bit matrix[8][8]
var byte row
var byte col
var byte bits_set = 0

-- checkerboard fill through nested loops
for 8 using row loop
   for 8 using col loop
      matrix[row][col] = (row + col) % 2 == 0
   end loop
end loop

-- single-bit edit with a runtime index
matrix[5][3] = ! matrix[5][3]

-- render the grid row by row (X = set, . = clear)
print_string(serial_data, "8x8 grid (X = set, . = clear);\r\n")
print_string(serial_data, "row 5 has [5][3] toggled off:\r\n")
for 8 using row loop
   for 8 using col loop
      if matrix[row][col] then
         print_string(serial_data, "X")
      else
         print_string(serial_data, ".")
      end if
   end loop
   print_crlf(serial_data)
end loop

-- count the set bits
for 8 using row loop
   for 8 using col loop
      if matrix[row][col] then
         bits_set = bits_set + 1
      end if
   end loop
end loop
print_string(serial_data, "grid bits set:    ")
print_byte_dec(serial_data, bits_set)
if bits_set == 31 then
   checks = checks + 1
   print_string(serial_data, "  OK (32 minus the toggle)\r\n")
else
   print_string(serial_data, "  WRONG (want 31)\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 4\r\n")
if checks == 4 then
   print_string(serial_data, "ALL BIT-ARRAY CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

