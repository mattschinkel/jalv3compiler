-- Title: ESP32 two cores (pragma target enable_cores, _task_start core(...), _task_core) with serial feedback
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: Shows the JALv3 multi-core surface on the ESP32.
-- `pragma target enable_cores 2` releases the second (APP) core, and both
-- cores run the same cooperative task scheduler. `_task_start core(2)
-- proc()` pins a task to a core (1 = PRO, 2 = APP), and `_task_core(proc())`
-- reports the core that last ran it.
-- Worker A is pinned to the APP core and worker B to the PRO core.  Only
-- A prints its slices: two cores writing UART0 at once interleave
-- mid-line on silicon, so B runs silently and its two slices are
-- reported by the summary.  Main yields until both workers are done,
-- then checks the slice counts and the reported cores and prints
-- PASS/FAIL + ##DONE## so the run validates from the serial log alone
-- (115200 on UART0, parks when done).
--
-- Expected transcript:
--   ========================================
--     JALv3 ESP32 demo: two cores
--     enable_cores 2, core pinning, _task_core
--   ========================================
--   starting task A on core 2 + task B on core 1
--   task A slice 1 (core 2)
--   task A slice 2 (core 2)
--   task A slice 3 (last, core 2)
--   task A ran 3 slices on core 2
--   task B ran 2 slices on core 1
--   CORES: PASS
--   Sample complete.
--   ##DONE##
--
-- Sources:
-- (task port; two-core extension)
--

-- @sim_validate begin
-- duration_s: 25
-- icount: 6
-- machine: esp32
-- smp: 2
-- expect byte v_ca_count 3
-- expect byte v_cb_count 2
-- uart_contains: ##DONE##
-- @sim_validate end
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

_usec_delay(1_000_000) -- start delay: open the terminal BEFORE powering (bench rule); 1 s is enough and keeps QEMU runs sane

-- two cores: PRO (1) + APP (2).  The pragma must precede the core(...)
-- clauses below (pragmas are read top-down).
pragma target enable_cores 2

-- Task bodies share the starter's stack (leaf frames): keep state in
-- globals, never in task-local variables.
var volatile byte ca_count = 0
var volatile byte cb_count = 0
var volatile byte ca_done = 0
var volatile byte cb_done = 0
var volatile dword guard = 0

--------------------------------------------------------------------------------
-- Description: Worker A: three slices, pinned to the APP core (2)
task worker_a() is
   ca_count = ca_count + 1
   print_string(serial_data, "task A slice 1 (core 2)")
   print_crlf(serial_data)
   _task_yield
   ca_count = ca_count + 1
   print_string(serial_data, "task A slice 2 (core 2)")
   print_crlf(serial_data)
   _task_yield
   ca_count = ca_count + 1
   print_string(serial_data, "task A slice 3 (last, core 2)")
   print_crlf(serial_data)
   ca_done = 1
end task

--------------------------------------------------------------------------------
-- Description: Worker B: two slices, pinned to the PRO core (1).  Only A
-- prints: two cores writing UART0 at once interleave mid-line on silicon,
-- so B's progress is reported by the summary instead.
task worker_b() is
   cb_count = cb_count + 1
   _task_yield
   cb_count = cb_count + 1
   cb_done = 1
end task

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv3 ESP32 demo: two cores\r\n")
print_string(serial_data, "  enable_cores 2, core pinning, _task_core\r\n")
print_string(serial_data, "========================================\r\n")
print_string(serial_data, "starting task A on core 2 + task B on core 1\r\n")

_task_start core(2) worker_a()
_task_start core(1) worker_b()

-- main runs on whichever core is free and yields until both workers are
-- done.  The QEMU dual-core model schedules the APP core only after the
-- PRO has run for a while, so the wait is bounded and prints nothing
-- (15000+ yields are normal under QEMU, microseconds on silicon).
while ((ca_done == 0) | (cb_done == 0)) & (guard < 200000) loop
   guard = guard + 1
   _task_yield
end loop

print_string(serial_data, "task A ran ")
print_byte_dec(serial_data, ca_count)
print_string(serial_data, " slices on core ")
print_byte_dec(serial_data, _task_core(worker_a()))
print_crlf(serial_data)

print_string(serial_data, "task B ran ")
print_byte_dec(serial_data, cb_count)
print_string(serial_data, " slices on core ")
print_byte_dec(serial_data, _task_core(worker_b()))
print_crlf(serial_data)

if (ca_count == 3) & (cb_count == 2) & (_task_core(worker_a()) == 2) & (_task_core(worker_b()) == 1) then
   print_string(serial_data, "CORES: PASS")
else
   print_string(serial_data, "CORES: FAIL")
end if
print_crlf(serial_data)

print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop
