-- Title: PIC32MZ1024EFH064 wide-integer math (qword / oword)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    PIC32 port of the ESP32 wide-integer demo: wide-integer support
--    added since jalv2 2.5r9. 64-bit `var qword` arithmetic (add,
--    subtract, multiply, divide, modulo, shifts, compares) and 128-bit
--    `var oword` storage composed/inspected through overlays (`var ...
--    at` is itself a post-r9 feature). Values print as hex, bytes read
--    through a byte array overlaid on the wide storage.
--    Output on UART1 at 115200.
--    Note: 64-bit multiply/divide/modulo with runtime operands landed
--    2026-09-24 through the shared wide kernel (src/libcore/wide_alg.c);
--    both the const-folded and the runtime forms are shown below.
--
-- Notes:
--    - Ported from demo_sample/esp32_wide_math.jal (same sections and
--      self-check expectations). No clock bring-up: boots straight at
--      200 MHz.
--    - Compile: ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' -no-codfile this file
--    - QEMU gate: ./tests/jal_sim_validate.sh --compiler ./bin/jalv3-x86-64 this file
--
-- @sim_validate begin
-- duration_s: 8
-- machine: pic32mz-explorer16
-- expect byte v_checks 9
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
alias led2 is pin_E0
pin_E1_direction = OUTPUT
pin_E0_direction = OUTPUT

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1             -- U1RXR code for RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print

include format

const qword KGR = 0x9E3779B97F4A7C15   -- 64-bit golden-ratio constant
var qword a = 0x9E3779B97F4A7C15
var qword q
var byte k
var volatile byte checks = 0

procedure print_qhex(byte in v[]) is
   for 8 using k loop
      print_byte_hex(serial_data, v[7 - k])
   end loop
end procedure

-- byte views of the qwords via `var ... at` overlays
var byte aview[8] at a
var byte qview[8] at q

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC32 demo: wide integers\r\n")
print_string(serial_data, "  64-bit qword math + 128-bit oword,\r\n")
print_string(serial_data, "  hex output via byte overlays\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- qword add / subtract / shift ---------\r\n")
print_string(serial_data, "a                       = 0x")
print_qhex(aview)
print_crlf(serial_data)

-- 64-bit add and subtract
q = a + 0x1111111111111111
print_string(serial_data, "a + 0x1111111111111111  = 0x")
print_qhex(qview)
if q == 0xAF488ACA905B8D26 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want AF488ACA905B8D26)\r\n")
end if

q = q - a
print_string(serial_data, "(that sum) - a          = 0x")
print_qhex(qview)
if q == 0x1111111111111111 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 1111111111111111)\r\n")
end if

-- 64-bit shifts, both directions
q = a << 8
print_string(serial_data, "a << 8                  = 0x")
print_qhex(qview)
if q == 0x3779B97F4A7C1500 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 3779B97F4A7C1500)\r\n")
end if

q = a >> 24
print_string(serial_data, "a >> 24                 = 0x")
print_qhex(qview)
if q == 0x0000009E3779B97F then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 0000009E3779B97F)\r\n")
end if

-- 64-bit compare + constant-folded 64-bit math still works at full width
print_string(serial_data, "--- compare + folded math ----------------\r\n")
if a > 0x8000000000000000 then
   checks = checks + 1
   print_string(serial_data, "a > 2^63                = true  OK\r\n")
else
   print_string(serial_data, "a > 2^63                = false  WRONG\r\n")
end if

q = (KGR * 3) >> 8
print_string(serial_data, "(a*3) >> 8 (folded)     = 0x")
print_qhex(qview)
if q == 0x00DAA66D2C7DDF74 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 00DAA66D2C7DDF74)\r\n")
end if

-- runtime-operand 64-bit multiply / divide / modulo (landed 2026-09-24;
-- operands are volatile so nothing folds at compile time)
print_string(serial_data, "--- runtime mul / div / mod ---------------\r\n")
var volatile qword rmul = 0x100000001
var volatile qword rden = 1_000_000_007

q = a * rmul
print_string(serial_data, "a * 0x100000001 (rt)    = 0x")
print_qhex(qview)
if q == 0x1D81F5CE7F4A7C15 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 1D81F5CE7F4A7C15)\r\n")
end if

q = a / rden
print_string(serial_data, "a / 1000000007 (rt)     = 0x")
print_qhex(qview)
if q == 0x00000002A78919F3 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 00000002A78919F3)\r\n")
end if

q = a % rden
print_string(serial_data, "a % 1000000007 (rt)     = 0x")
print_qhex(qview)
if q == 0x000000001EE30870 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 000000001EE30870)\r\n")
end if

-- 128-bit oword built from two qwords, inspected through overlays
print_string(serial_data, "--- 128-bit oword + dword ----------------\r\n")
var oword w128
var qword wlo at w128
var qword whi at w128 + 8
var byte wview[16] at w128
whi = a
wlo = a << 8
print_string(serial_data, "oword (hi:a, lo:a<<8)\r\n          = 0x")
for 16 using k loop
   print_byte_hex(serial_data, wview[15 - k])
end loop
print_crlf(serial_data)

-- dword for scale
print_string(serial_data, "dword                   = 0x")
print_dword_hex(serial_data, 0xDEADBEEF)
print_crlf(serial_data)

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 9\r\n")
if checks == 9 then
   print_string(serial_data, "ALL WIDE CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

