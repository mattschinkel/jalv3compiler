-- Title: PIC16F1825 float_math feature tour, part 1 of 2
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: float_math demo part 1 of 2 for the enhanced-midrange PIC16F1825
--              (32 MHz INTOSC+PLL, serial on EUSART): float math part 1: multiply, divide, add/sub (soft-float IEEE-754). The 8K-word part
--              cannot hold the whole tour in one image, so it ships as two parts.
--              The test body lives in the f1825_float_math_1_body include block.
--
-- Requires: f1825_float_math_1_body
-- This file has been generated by Matt's sample generator.
--

include 16f1825                      -- target PICmicro
--
-- This program uses the internal oscillator at 8 MHz through the
-- 4x PLL: 32 MHz (the PLL is software-enabled below).
pragma target clock 32_000_000      -- oscillator frequency
--
pragma target OSC      INTOSC_NOCLKOUT           -- internal oscillator
pragma target PLLEN    DISABLED                  -- PLL software controlled
pragma target CLKOUTEN DISABLED                  -- no clock output
pragma target WDT      DISABLED                  -- watchdog
pragma target DEBUG    DISABLED                  -- no debugging
pragma target BROWNOUT DISABLED                  -- no brownout reset
pragma target FCMEN    DISABLED                  -- no clock monitoring
pragma target IESO     DISABLED                  -- no int/ext osc switching
pragma target LVP      ENABLED                   -- low voltage programming
pragma target MCLR     EXTERNAL                  -- external reset
--
OSCCON_SCS = 0                      -- clock selected by fuse OSC
OSCCON_IRCF = 0b1110                -- internal oscillator to 8 MHz
OSCCON_SPLLEN = TRUE                -- enable PLL, multiply by 4 -> 32 MHz
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay (100_000) -- wait for power to stablilize

-- 16f1825 port of the float_math demo (enhanced midrange PIC16, 32 MHz
--   INTOSC+PLL; LED on A0, serial on EUSART @115200)
alias led1 is pin_A0
alias led2 is pin_A1
pin_A0_direction = OUTPUT
pin_A1_direction = OUTPUT

-- setup uart for communication (EUSART on the part's fixed TX/RX pins)
const serial_hw_baudrate  = 115200
-- EUSART pin pair (APFCON-selectable on this part; RC4/RC5 chosen)
alias pin_TX is pin_C4
alias pin_TX_direction is pin_C4_direction
alias pin_RX is pin_C5
alias pin_RX_direction is pin_C5_direction

include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include format
include print_float_exact
var float pi      = 3.14159265
var float radius  = 2.5
var float area
var float mean
var float ratio
var sdword scaled
var volatile byte checks = 0

procedure print_flt(float in v) is
   print_float_exact(serial_data, v)
end procedure

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC16F1825 demo: float math (1 of 2)\r\n")
print_string(serial_data, "  IEEE-754 single precision, soft-float\r\n")
print_string(serial_data, "  routines (no FPU)\r\n")
print_string(serial_data, "========================================\r\n")

-- multiply, mixed with an integer constant
print_string(serial_data, "--- multiply: pi * r * r -----------------\r\n")
area = pi * radius * radius
print_string(serial_data, "area (pi*r*r)       = ")
print_flt(area)
if area > 19.6 then
   if area < 19.7 then
      checks = checks + 1
      print_string(serial_data, "  OK (~19.63)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~19.63)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~19.63)\r\n")
end if

-- divide
print_string(serial_data, "--- divide: r / pi -----------------------\r\n")
ratio = radius / pi
print_string(serial_data, "radius / pi         = ")
print_flt(ratio)
if ratio > 0.79 then
   if ratio < 0.80 then
      checks = checks + 1
      print_string(serial_data, "  OK (~0.796)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~0.796)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~0.796)\r\n")
end if

-- add/sub chain with a negative-adjacent result
print_string(serial_data, "--- add / subtract chain ------------------\r\n")
mean = pi - 4.0 + 1.0
print_string(serial_data, "pi - 4 + 1          = ")
print_flt(mean)
if mean > 0.14 then
   if mean < 0.15 then
      checks = checks + 1
      print_string(serial_data, "  OK (~0.142)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~0.142)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~0.142)\r\n")
end if
print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 3\r\n")
if checks == 3 then
   print_string(serial_data, "ALL FLOAT CHECKS PASSED (part 1)\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop
