-- Title: PIC32MZ1024EFH064 print-library demo, fully own-boot bare metal
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    jallib print-library demo on a fully self-sourced bare-metal image:
--    the compiler-emitted boot-flash init (scripts see
--    fixes/fix_pic32_loader_boot_init_compiler.md), our own DEVCFG2 fuse
--    integer (0x400131A0 = FRC /1 x50 /2 to boot SPLL 200.0 MHz), and a
--    pragma-200 PFM app with ZERO clock code.  Prints a banner, integer
--    dec/hex conversions with self-checks, then one "alive - N s"
--    heartbeat per second while both LEDs blink at 1 Hz.  115200 8N1.
--
-- Notes:
--    - Same pairing as blink_200mhz_ownboot: SPLL-boot fuse words +
--      pragma-200 app, no switch code.  PAIRING RULE and fuse derivation
--      notes live in that sample's header and the fix docs.
--    - UART: PBCLK2 = 100 MHz (PB2DIV reset /2), BRGH = 1 to
--      BRG 216 = 115200 baud.
--    - Build & program:
--        ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' this file
--        python3 scripts/pic32_program_hex_build.py this.hex out.hex \
--          --alias-only --devcfg0 0x41000000 --devcfg1 0x400131A0 \
--          --devcfg2 0x5F740439 --devcfg3 0x403FF753
--        # then: ipecmd -E, then one -YS -M -OL program of out.hex,
--        # then POWER CYCLE the board
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
alias led2 is pin_E0
pin_E1_direction = OUTPUT
pin_E0_direction = OUTPUT

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1             -- U1RXR code for RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 6

include print

include format

var byte  demo_b = 42
var word  demo_w = 65_535
var dword demo_d = 123_456_789
var byte  seconds = 0
var byte  checks  = 0

-- 5 s grace period: time to open a serial terminal after power-up
for 5 loop
   led1 = ON
   _usec_delay(80_000)
   led1 = OFF
   _usec_delay(920_000)
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 print demo - PIC32MZ1024EFH064\r\n")
print_string(serial_data, "boot: own boot init, SYSCLK 200 MHz, 115200 8N1\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "byte  dec: ")
print_byte_dec(serial_data, demo_b)
print_string(serial_data, "  hex: 0x")
print_byte_hex(serial_data, demo_b)
print_string(serial_data, "\r\n")

print_string(serial_data, "word  dec: ")
print_word_dec(serial_data, demo_w)
print_string(serial_data, "  hex: 0x")
print_word_hex(serial_data, demo_w)
print_string(serial_data, "\r\n")

print_string(serial_data, "dword dec: ")
print_dword_dec(serial_data, demo_d)
print_string(serial_data, "  hex: 0x")
print_dword_hex(serial_data, demo_d)
print_string(serial_data, "\r\n")

if demo_b == 42 then checks = checks + 1 end if
if demo_w == 65_535 then checks = checks + 1 end if
if demo_d == 123_456_789 then checks = checks + 1 end if
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 3\r\n\r\n")

forever loop
   led1 = ON
   led2 = ON
   print_string(serial_data, "alive - ")
   print_byte_dec(serial_data, seconds)
   print_string(serial_data, " s\r\n")
   seconds = seconds + 1
   _usec_delay(100_000)
   led1 = OFF
   led2 = OFF
   _usec_delay(900_000)
end loop

