-- Title: ESP32 serial banner at 240 MHz (self-contained, no bootloader)
-- Author: Matthew Schinkel
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: pragma target clock 240_000_000 brings the chip up from the cold
-- 40 MHz crystal state: BBPLL reprogrammed to 480 MHz over the
-- internal regi2c bus, core voltage raised, PLL/2 selected, UART
-- fixed for the 80 MHz APB. A banner prints once, then a per-second
-- heartbeat line repeats forever; UART stays 115200 at any CPU speed
-- (APB-derived). Power-cycle the board after flashing -- boot-time
-- flash reads are marginal right after a write; a power cycle boots
-- first try.
--
-- Sources:
-- esptool write-flash 0x1000 esp32_serial_240mhz.hex
--
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

_usec_delay(1_000_000) -- start delay: open the terminal BEFORE powering (bench rule); 1 s is enough and keeps QEMU runs sane

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 ESP32 demo: 240 MHz heartbeat\r\n")
print_string(serial_data, "  cold bring-up: 40 MHz crystal to PLL\r\n")
print_string(serial_data, "  UART0 stays 115200 at any CPU clock\r\n")
print_string(serial_data, "========================================\r\n")

var word uptime = 0

forever loop
   uptime = uptime + 1
   print_string(serial_data, "running at 240 MHz - ")
   print_word_dec(serial_data, uptime)
   print_string(serial_data, " s\r\n")
   _usec_delay(1_000_000)
end loop

