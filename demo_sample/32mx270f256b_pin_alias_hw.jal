-- ------------------------------------------------------
-- Title: ESP32 pin-alias hardware witness (ELEGOO ESP32-WROOM-32)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Silicon counterpart of the QEMU pin-alias body: the synthesized
--    device-file aliases (pin_N / pin_N_out / pin_N_direction) write
--    GPIO_OUT/GPIO_ENABLE and READ BACK on real hardware, and the
--    runtime-indexed `var bit out_bits[32] at GPIO_OUT` overlay
--    composes with them.  espressif QEMU models GPIO read-as-zero, so
--    only silicon can prove the VALUES; this sample prints one OK line
--    per passing check plus a tally over UART0 (115200 8N1).  240 MHz
--    via the proven esp32_clock bring-up skeleton.
--
-- Notes:
--    LED (board) is on GPIO 2 -- it blinks during the loop.
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 40_000_000      -- oscillator frequency
pragma target OSC    FRC_SPLL       -- internal 8 MHz FRC through the system PLL (/2 x20 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication (board wiring: RPB3 = U1TX, RPB2 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_B3
alias serial_hw_pin_tx_direction is pin_B3_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB3R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2

include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

_usec_delay(5_000_000) -- start delay: time to open a serial terminal

var byte checks = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 pin-alias witness - PIC32MX270F256B\r\n")
print_string(serial_data, "========================================\r\n")

-- plain pin alias: the pin write lands in LATB, the read returns the pin level
pin_B14 = 1
if (LATB & 0x4000) != 0 then
   print_string(serial_data, "OK   LED bit set in LATB after pin write\r\n")
   checks = checks + 1
end if

-- fixed-function pin alias (the PGED3/PGEC3 debug pair share RA0): the same port
-- bit through its friendly name, plus the _direction twin in TRIS
pin_PGED3 = 1
pin_PGED3_direction = OUTPUT
if pin_PGED3 == 1 then
   print_string(serial_data, "OK   pin_PGED3 alias readback\r\n")
   checks = checks + 1
end if

-- runtime-indexed bit overlay over LATB (the sibling SFR-overlay idiom).
-- Bits {4,5,13,15} only: B2/B3 are the UART, and B6/B12 are held by the
-- bench (ICSP lines fight the latch -- even a bare `LATB = 0xFFFF` will
-- not stick on them with the tool attached).
var bit lat_bits[16] at LATB
var byte i
for 2 using i loop
   lat_bits[i + 4] = 1
end loop
for 2 using i loop
   lat_bits[i * 2 + 13] = 1
end loop
if (LATB & 0xA030) == 0xA030 then
   print_string(serial_data, "OK   overlay lat_bits sets bits 4,5,13,15\r\n")
   checks = checks + 1
end if
lat_bits[5] = 0
if ((LATB & 0x0020) == 0) & (lat_bits[5] == 0) & (lat_bits[4] == 1) then
   print_string(serial_data, "OK   overlay+alias single-bit views agree\r\n")
   checks = checks + 1
end if

print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 4\r\n")
print_string(serial_data, "##DONE##\r\n")

-- heartbeat: LED blink at ~1 Hz through the plain pin alias
forever loop
   pin_B14 = 1
   _usec_delay(500_000)
   pin_B14 = 0
   _usec_delay(500_000)
end loop

