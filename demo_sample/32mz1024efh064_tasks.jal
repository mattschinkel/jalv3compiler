-- Title: PIC32MZ1024EFH064 cooperative tasks (_task_start / suspend / _task_suspend / _task_resume / _task_kill / _task_restart) with serial feedback
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    PIC32 port of the ESP32 cooperative-multitasking demo added since
--    jalv2 2.5r9: `pragma task N`, `task ... end task`, `_task_start
--    proc()` and `suspend`. The scheduler is a deterministic
--    round-robin: every `suspend` hands control to the next live task,
--    and a task that falls off its end removes itself. Two worker
--    tasks print per-slice lines interleaved with main-slice lines,
--    then main tallies the per-task counters and prints PASS/FAIL +
--    ##DONE## so the run validates from the serial log alone (115200
--    on UART1, parks when done).
--
--    Expected transcript (round-robin preserves start order:
--    main to A to B to main ...):
--      ========================================
--        JALv2 PIC32 demo: cooperative tasks
--        round-robin scheduler: _task_start,
--        _task_yield, tasks end by falling off
--      ========================================
--      starting task A + task B
--      main slice 1
--      task A slice 1
--      task B slice 1
--      main slice 2
--      task A slice 2
--      task B slice 2 (last)
--      main slice 3 (last)
--      task A slice 3 (last)
--      task A ran 3 slices
--      task B ran 2 slices
--      TASKS: PASS
--      Sample complete.
--      ##DONE##
--
-- Notes:
--    - Ported from demo_sample/esp32_tasks.jal (same sections and
--      expectations; `start name()` in the ESP32 source predates the
--      `_task_start` keyword rename -- this port uses `_task_start`).
--      No clock bring-up: boots straight at 200 MHz.
--    - Compile: ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' -no-codfile this file
--    - QEMU gate: ./tests/jal_sim_validate.sh --compiler ./bin/jalv3-x86-64 this file
--
-- @sim_validate begin
-- duration_s: 8
-- machine: pic32mz-explorer16
-- expect byte v_checks 6
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
alias led2 is pin_E0
pin_E1_direction = OUTPUT
pin_E0_direction = OUTPUT

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1             -- U1RXR code for RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print

include format

pragma task 4          -- main + three workers

-- Task bodies share the starter's stack (leaf frames): keep state in
-- globals, never in task-local variables.
var volatile byte ta_count = 0
var volatile byte tb_count = 0
var byte main_count = 0
var volatile byte checks = 0

--------------------------------------------------------------------------------
-- Description: Worker A: three slices, yields between each, then ends
task worker_a() is
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 1")
   print_crlf(serial_data)
   _task_yield
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 2")
   print_crlf(serial_data)
   _task_yield
   ta_count = ta_count + 1
   print_string(serial_data, "task A slice 3 (last)")
   print_crlf(serial_data)
end task

--------------------------------------------------------------------------------
-- Description: Worker B: two slices, yields between each, then ends
task worker_b() is
   tb_count = tb_count + 1
   print_string(serial_data, "task B slice 1")
   print_crlf(serial_data)
   _task_yield
   tb_count = tb_count + 1
   print_string(serial_data, "task B slice 2 (last)")
   print_crlf(serial_data)
end task

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC32 demo: cooperative tasks\r\n")
print_string(serial_data, "  round-robin scheduler: _task_start,\r\n")
print_string(serial_data, "  _task_yield, tasks end by falling off\r\n")
print_string(serial_data, "========================================\r\n")
print_string(serial_data, "starting task A + task B\r\n")

_task_start worker_a()
_task_start worker_b()

for 3 loop
   main_count = main_count + 1
   if main_count == 3 then
      print_string(serial_data, "main slice 3 (last)")
   else
      print_string(serial_data, "main slice ")
      print_byte_dec(serial_data, main_count)
   end if
   print_crlf(serial_data)
   _task_yield
end loop

print_string(serial_data, "task A ran ")
print_byte_dec(serial_data, ta_count)
print_string(serial_data, " slices")
print_crlf(serial_data)

print_string(serial_data, "task B ran ")
print_byte_dec(serial_data, tb_count)
print_string(serial_data, " slices")
print_crlf(serial_data)

if ta_count == 3 then
   checks = checks + 1
   if tb_count == 2 then
      checks = checks + 1
      print_string(serial_data, "TASKS: PASS")
   else
      print_string(serial_data, "TASKS: FAIL (B count)")
   end if
else
   print_string(serial_data, "TASKS: FAIL (A count)")
end if
print_crlf(serial_data)

-- Task control from main: _task_suspend parks a task while others
-- keep running; _task_resume continues it; _task_kill removes it;
-- _task_restart re-runs it from its entry. A third worker counts its
-- slices in a global.
var volatile byte tc_count = 0
var volatile byte tc_frozen = 0

task worker_c() is
   forever loop
      tc_count = tc_count + 1
      _task_yield
   end loop
end task

print_string(serial_data, "--- task control -------------------------\r\n")
_task_start worker_c()
for 3 loop
   _task_yield
end loop
print_string(serial_data, "worker C ticks:    ")
print_byte_dec(serial_data, tc_count)
print_crlf(serial_data)

_task_suspend worker_c()
tc_frozen = tc_count
for 3 loop
   _task_yield
end loop
if tc_count == tc_frozen then
   checks = checks + 1
   print_string(serial_data, "suspended: frozen OK\r\n")
else
   print_string(serial_data, "suspended: WRONG (still running)\r\n")
end if

_task_resume worker_c()
for 3 loop
   _task_yield
end loop
if tc_count > tc_frozen then
   checks = checks + 1
   print_string(serial_data, "resumed: running OK\r\n")
else
   print_string(serial_data, "resumed: WRONG (still frozen)\r\n")
end if

_task_kill worker_c()
tc_frozen = tc_count
for 3 loop
   _task_yield
end loop
if tc_count == tc_frozen then
   checks = checks + 1
   print_string(serial_data, "killed: dead OK\r\n")
else
   print_string(serial_data, "killed: WRONG (zombie)\r\n")
end if

_task_restart worker_c()
for 3 loop
   _task_yield
end loop
if tc_count > tc_frozen then
   checks = checks + 1
   print_string(serial_data, "restarted: from entry OK\r\n")
else
   print_string(serial_data, "restarted: WRONG (not restarted)\r\n")
end if

_task_kill worker_c()

print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 6\r\n")
if checks == 6 then
   print_string(serial_data, "ALL TASK CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

