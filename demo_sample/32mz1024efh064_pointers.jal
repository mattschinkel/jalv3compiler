--
-- Description:
--    PIC32 port of the ESP32 pointers demo: pointer syntax demos:
--    basic pointers, function pointers, pointer calls with out / in out
--    formals and function returns, variable aliasing, array pointers,
--    const array pointers, pointer slots with WHEREIS,
--    procedure-pointer array dispatch, and a pointer-to-heap-string
--    finale (assign + concat through the pointer). LED is pin_E1
--    (led1) and serial output goes to UART1 at 115200 through the
--    jallib print library (the driver's serial_hw_data pseudo-variable
--    aliased as serial_data).
--
-- Notes:
--    - Ported from demo_sample/esp32_pointers.jal (same sections and
--      self-check expectations; GPIO_OUT LED writes became led1 pin
--      writes). No clock bring-up: boots straight at 200 MHz.
--    - Compile: ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' -no-codfile this file
--    - QEMU gate: ./tests/jal_sim_validate.sh --compiler ./bin/jalv3-x86-64 this file
--
-- @sim_validate begin
-- duration_s: 8
-- uart_contains: ##DONE##
-- machine: pic32mz-explorer16
-- expect byte v_checks 23
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_E1
alias led2 is pin_E0
pin_E1_direction = OUTPUT
pin_E0_direction = OUTPUT

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1             -- U1RXR code for RPF1

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print

include format

procedure led_on() is
   led1 = ON
end procedure
procedure led_off() is
   led1 = OFF
end procedure

-- ========================================
-- Basic pointer variable (points at a byte)
-- ========================================
-- "Pointer to byte x": use  var pointer var byte x  or  var pointer x(as var byte).
var byte basic_for_x = 10
var pointer x as var byte
x is basic_for_x

-- Constant scalar: you cannot use "ptr is const_byte" (compiler); bind to a
-- byte variable or use a const array below. Here we only read the constant.
const byte basic_const_byte = 77

-- Variable array: pointer to whole array — **`as var byte[N]`** matches **`N`** elements.
var byte basic_var_arr[3]
basic_var_arr[0] = 1
basic_var_arr[1] = 2
basic_var_arr[2] = 3
var pointer ptr_var_arr as var byte[3]
ptr_var_arr is basic_var_arr
basic_var_arr[0] = 9

-- Constant array: pointer may bind to const array; reads are read-only.
const byte basic_const_arr[3] = {10, 20, 30}
var pointer ptr_const_arr as const byte[3]
ptr_const_arr is basic_const_arr
var byte snap_from_const_arr
snap_from_const_arr = basic_const_arr[1]

var volatile byte checks = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC32 demo: pointers\r\n")
print_string(serial_data, "  var pointer tour: aliasing, function\r\n")
print_string(serial_data, "  pointers, arrays, heap strings\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- basic pointers -----------------------\r\n")
print_string(serial_data, "const byte (direct):  ")
print_byte_dec(serial_data, basic_const_byte)
if basic_const_byte == 77 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 77)\r\n")
end if
print_string(serial_data, "var arr[0] via ptr:   ")
print_byte_dec(serial_data, basic_var_arr[0])
if basic_var_arr[0] == 9 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 9)\r\n")
end if
print_string(serial_data, "const arr[1] via ptr: ")
print_byte_dec(serial_data, snap_from_const_arr)
if snap_from_const_arr == 20 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 20)\r\n")
end if

-- ========================================
-- Pointer signatures (required on var pointer)
-- ========================================
-- Preferred pointer syntax puts the pointee contract after `as`, e.g.
--   var pointer p as procedure(byte in)
--   var pointer f as function(byte in) return word
--   var pointer d as var byte
--   var pointer a as var byte[4]              -- one pointer to byte[4]
--   var pointer slots[4] as procedure(byte in) -- four procedure-pointer slots
-- ========================================
-- Simple Function Pointer Example
-- ========================================

-- Define two procedures
procedure proc_a(byte in value) is
   print_string(serial_data, "Proc A: ")
   print_byte_dec(serial_data, value)
   print_crlf(serial_data)
end procedure

procedure proc_b(byte in value) is
   print_string(serial_data, "Proc B: ")
   print_byte_dec(serial_data, value)
   print_crlf(serial_data)
end procedure

-- Function pointer variable (signature required)
var pointer my_proc as procedure (byte in)

-- Demonstrate function pointers
print_string(serial_data, "--- function pointers --------------------\r\n")

-- Assign and call
my_proc is proc_a
my_proc(42)

-- Reassign and call
my_proc is proc_b
my_proc(100)

-- Pointer calls with `out` / `in out` formals and function-pointer
-- returns: the call site marshals an `out`/`in out` actual back into
-- the caller's variable after the call.
print_string(serial_data, "--- pointer call forms --------------------\r\n")

procedure set_victim(byte out value) is
   value = 21
end procedure

procedure bump(byte in out value) is
   value = value + 1
end procedure

function add_two(byte in value) return byte is
   return value + 2
end function

var pointer set_ptr as procedure (byte out)
var pointer bump_ptr as procedure (byte in out)
var pointer fptr as function (byte in) return byte

var byte victim = 0
var byte counter = 25
var byte fret = 0

set_ptr is set_victim
set_ptr(victim)
print_string(serial_data, "out via ptr:      ")
print_byte_dec(serial_data, victim)
if victim == 21 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 21)\r\n")
end if

bump_ptr is bump
bump_ptr(counter)
print_string(serial_data, "in out via ptr:   ")
print_byte_dec(serial_data, counter)
if counter == 26 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 26)\r\n")
end if

fptr is add_two
fret = fptr(40)
print_string(serial_data, "return via fptr:  ")
print_byte_dec(serial_data, fret)
if fret == 42 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 42)\r\n")
end if

-- Dynamic Variable Switching
print_string(serial_data, "--- dynamic variable switching -----------\r\n")

var byte sensor1_data = 0
var byte sensor2_data = 0
var byte sensor3_data = 0
var pointer current_sensor as var byte

current_sensor is sensor1_data
current_sensor = 42
print_string(serial_data, "sensor1 (via ptr): ")
print_byte_dec(serial_data, sensor1_data)
if sensor1_data == 42 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 42)\r\n")
end if

current_sensor is sensor2_data
current_sensor = 75
print_string(serial_data, "sensor2 (via ptr): ")
print_byte_dec(serial_data, sensor2_data)
if sensor2_data == 75 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 75)\r\n")
end if

-- Array Element Aliasing
print_string(serial_data, "--- array element aliasing ---------------\r\n")

var byte sensor_data[4]
sensor_data[0] = 10
sensor_data[1] = 20
sensor_data[2] = 30
sensor_data[3] = 40
-- Whole-array vs single-element aliasing need different pointee shapes.
var pointer sensor_data_pt as var byte[4]
var pointer sensor_elem_pt as var byte

sensor_data_pt is sensor_data
sensor_data_pt[0] = 50
print_string(serial_data, "array[0] via array-ptr: ")
print_byte_dec(serial_data, sensor_data[0])
if sensor_data[0] == 50 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 50)\r\n")
end if

sensor_elem_pt is sensor_data[2]
sensor_elem_pt = 80
print_string(serial_data, "array[2] via elem-ptr:  ")
print_byte_dec(serial_data, sensor_data[2])
if sensor_data[2] == 80 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 80)\r\n")
end if

-- Change to different index in same array
sensor_elem_pt is sensor_data[3]
sensor_elem_pt = 99
print_string(serial_data, "array[3] via elem-ptr:  ")
print_byte_dec(serial_data, sensor_data[3])
if sensor_data[3] == 99 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 99)\r\n")
end if

-- Back to first element via pointer-to-array
sensor_data_pt is sensor_data
sensor_data_pt[0] = 25
print_string(serial_data, "array[0] rewritten:     ")
print_byte_dec(serial_data, sensor_data[0])
if sensor_data[0] == 25 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 25)\r\n")
end if

-- Memory-Mapped Register Aliasing
print_string(serial_data, "--- register aliasing --------------------\r\n")

-- Simulate hardware registers
var byte port_a = 0x00
var byte port_b = 0x00
var pointer current_port as var byte

current_port is port_a
current_port = 0xFF
print_string(serial_data, "port A: 0x")
print_byte_hex(serial_data, port_a)
if port_a == 0xFF then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want FF)\r\n")
end if

current_port is port_b
current_port = 0xAA
print_string(serial_data, "port B: 0x")
print_byte_hex(serial_data, port_b)
if port_b == 0xAA then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want AA)\r\n")
end if

-- ========================================
-- Array Pointer Example
-- ========================================

print_string(serial_data, "--- array pointers -----------------------\r\n")

var byte data[4]
data[0] = 1
data[1] = 2
data[2] = 3
data[3] = 4
var pointer current_element as var byte[4]

-- Point to array
current_element is data

-- Process each element
var byte storage_var
var byte i
for 4 using i loop
   storage_var = current_element[i]           -- Read element
   storage_var = storage_var + 2              -- Add 2
   current_element[i] = storage_var           -- Write back
   print_string(serial_data, "element ")
   print_byte_dec(serial_data, i)
   print_string(serial_data, ": ")
   print_byte_dec(serial_data, storage_var)
   if storage_var == i + 3 then
      checks = checks + 1
      print_string(serial_data, "  OK\r\n")
   else
      print_string(serial_data, "  WRONG\r\n")
   end if
end loop

-- ========================================
-- Constant Array Pointer Example
-- ========================================

print_string(serial_data, "--- const array pointers -----------------\r\n")

-- Constant lookup table
const byte lookup_table[4] = {10, 20, 30, 40}
var pointer table_ptr as const byte[4]

-- Point to constant array
table_ptr is lookup_table

-- Read from constant array (read-only)
var byte value = lookup_table[2]     -- Reads 30
print_string(serial_data, "lookup[2]: ")
print_byte_dec(serial_data, value)
if value == 30 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 30)\r\n")
end if

var byte first = lookup_table[0]     -- Reads 10
print_string(serial_data, "lookup[0]: ")
print_byte_dec(serial_data, first)
if first == 10 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 10)\r\n")
end if

-- Pointer slots: three pointer slots bound to different variables,
-- then WHEREIS queries a slot's bound target address (0 if unbound).
-- (Store/load through indexed slots is supported on the 32-bit back
-- ends since 2026-09-29; this tour only binds and queries.)
print_string(serial_data, "--- pointer slots + WHEREIS ---------------\r\n")

var byte da_a = 0
var byte da_b = 0
var byte da_c = 0
var pointer slots[3] as var byte
var dword slot_addr
var dword target_addr

slots[0] is da_a
slots[1] is da_b
slots[2] is da_c

-- WHEREIS: query the target address of a pointer
slot_addr = WHEREIS(slots[0])
target_addr = WHEREIS(da_a)
print_string(serial_data, "whereis slots[0]:  0x")
print_dword_hex(serial_data, slot_addr)
print_string(serial_data, "\r\nwhereis da_a:      0x")
print_dword_hex(serial_data, target_addr)
if slot_addr == target_addr then
   if slot_addr != 0 then
      checks = checks + 1
      print_string(serial_data, "  OK (same target)\r\n")
   else
      print_string(serial_data, "  WRONG (zero address)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (addresses differ)\r\n")
end if


-- Runtime-index BIND into a pointer-slot array (slots[k] is <var>): a
-- silent no-op on the classic cores until 2026-10-28 (the staging wrote
-- the target address into a scratch instead of slot k's bytes).
print_string(serial_data, "--- runtime-index slot bind -------------\r\n")
var byte rti = 1
slots[rti] is da_c        -- retarget slot 1 at a runtime index
da_c = 88
var byte rti_snap = slots[rti]
print_string(serial_data, "bind via slots[k]:  ")
print_byte_dec(serial_data, rti_snap)
if rti_snap == 88 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 88)\r\n")
end if
da_c = 0

-- Blink LED to indicate completion
for 5 loop
   led_on()
   _usec_delay(100_000)
   led_off()
   _usec_delay(400_000)
end loop

--

--------------------------------------------------------------------------------
procedure proc_c(byte in test) is
   var byte value = 123
   print_string(serial_data, "Proc C: ")
   print_byte_dec(serial_data, value)
   print_crlf(serial_data)
end procedure

procedure proc_d(byte in test) is
   var byte value = 124
   print_string(serial_data, "Proc D: ")
   print_byte_dec(serial_data, value)
   print_crlf(serial_data)
end procedure

-- Array of procedure pointers: `slots[N] as procedure(...)` declares two
-- independent pointer slots sharing the same procedure signature.
var pointer proc_slots[2] as procedure (byte in)
proc_slots[0] is proc_c
proc_slots[1] is proc_d

var byte my_array[10]
my_array[5] = 5

-- dispatch through the procedure-pointer array by runtime index
var byte step2 = 0
print_string(serial_data, "--- procedure-pointer array --------------\r\n")
while step2 < 2 loop
   proc_slots[step2](0)
   step2 = step2 + 1
end loop

-- ========================================
-- Pointer to heap dynamic string (`var string` + `const word _string_heap_size`)
-- (Kept at end: **`const word _string_heap_size`** + **`include strings_dynamic`** must precede first **`var string`**.)
-- ========================================
print_string(serial_data, "--- pointer to heap string ----------------\r\n")
const word _string_heap_size = 128

include strings_dynamic
var string _ptr_ds_t
var pointer _ptr_ds_p as var string
_ptr_ds_t = "ab"
_ptr_ds_p is _ptr_ds_t
-- write through the pointer-to-string: plain assignment and concat
-- (same indirect addressing model as other data pointers)
_ptr_ds_p = "abc"
if _ptr_ds_t == "abc" then
   checks = checks + 1
   print_string(serial_data, "string via pointer: abc (")
   print_byte_dec(serial_data, COUNT(_ptr_ds_t))
   print_string(serial_data, " chars)  OK\r\n")
else
   print_string(serial_data, "string via pointer: MISMATCH\r\n")
end if

_ptr_ds_p = _ptr_ds_p & "XY"
if _ptr_ds_t == "abcXY" then
   checks = checks + 1
   print_string(serial_data, "concat via pointer: abcXY (")
   print_byte_dec(serial_data, COUNT(_ptr_ds_t))
   print_string(serial_data, " chars)  OK\r\n")
else
   print_string(serial_data, "concat via pointer: MISMATCH\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 24\r\n")
if checks == 24 then
   print_string(serial_data, "ALL POINTER CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

-- Park: keep the program alive after the finale
forever loop
   _usec_delay(1_000_000)
end loop

