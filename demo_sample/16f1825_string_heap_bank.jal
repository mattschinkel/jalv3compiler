-- ------------------------------------------------------
-- Title: Testing strings across a multi-bank string heap
-- Author: Rob Jansen (report), Matthew Schinkel (fork)
-- Compiler: jalv3-x86-64
--
-- The 2026-11-02 report program, kept as a demo: `_string_heap_size` is
-- larger than one 16F1825 RAM bank, so every `print_string(dev, <heap
-- string>)` marshals the text into a multi-bank `_strargN` buffer.  The
-- callee used to address the first call site's chunks for every call and
-- printed the first string's text for the rest; the runtime chunk map
-- (fixes/fix_openarray_formal_chunk_map.md, Addendum 3) fixed it.
-- Expected output, repeated every second:
--    Const string that does it.
--    Var string that does it.
--    My string
--    Yet another string
--    My string1
--    My string2
-- ------------------------------------------------------
include 16f1825                     -- target PICmicro
pragma target clock    16_000_000      -- oscillator frequency
pragma target OSC      INTOSC_NOCLKOUT -- Internal Clock
pragma target PLLEN    DISABLED        -- No PLL
pragma target WDT      DISABLED        -- No Watchdog
pragma target PWRTE    ENABLED         -- Power up timer enabled
pragma target BROWNOUT DISABLED        -- No brownout reset
pragma target FCMEN    DISABLED        -- No clock monitoring
pragma target IESO     DISABLED        -- int/ext osc. switch
pragma target LVP      DISABLED        -- No low voltage programming
pragma target MCLR     EXTERNAL        -- Reset internal
OSCCON_IRCF   = 0b1111                 -- Set 16 MHz
OSCCON_SCS    = 0b00                   -- Clock determined by FOSC

WPUA = 0b0000_0111       -- Weak pull-up for unused pins.
WPUC = 0b0011_1000       -- Weak pull-up for unused pins.
OPTION_REG_WPUEN = FALSE -- Enable Weak Pull-Up
enable_digital_io()               -- make all pins digital I/O

const serial_hw_baudrate = 115200
alias pin_RX_direction is pin_c5_direction -- Receive pin.
alias pin_TX_direction is pin_c4_direction -- Transmit pin.
include serial_hardware
serial_hw_init()
alias serial is serial_hw_data

include print                              -- output library
include delay

pragma target string_heap_size 100
const string another_string = "Yet another string"
const byte okc_string[] = "Const string that does it."
var byte okv_string[] = "Var string that does it."

var pointer svalue as var string
var word index
var string my_string = "My string"
var string my_string1 = "My string" & 1
var byte two = 2
var string my_string2 = "My string" & two

forever loop

   -- string from a const byte array (ROM): the linear lookup path
   print_string(serial, okc_string)
   print_crlf(serial)

   -- string from a var byte array (RAM, single chunk)
   print_string(serial, okv_string)
   print_crlf(serial)

   -- heap strings: marshalled into multi-bank buffers, walked at run time
   print_string(serial, my_string)
   print_crlf(serial)

   print_string(serial, another_string)
   print_crlf(serial)

   -- the same text through a string pointer, character by character
   var byte step = 0
   svalue is my_string1
   for COUNT(svalue) loop
      serial = svalue[step]
      step = step + 1
   end loop
   print_crlf(serial)

   -- and through print_string's own marshalling
   svalue is my_string2
   print_string(serial, svalue)

   delay_1s(1)

end loop
