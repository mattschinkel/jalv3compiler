-- Title: FAT32 library for reading fat32 filesystem
-- Author: Matthew Schinkel, copyright (c) 2009, all rights reserved.
-- Adapted-by:
-- Compiler: >=2.4q5
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: this example creates files & directories on a fat32
--              formatted sd card, reads them back through the fat32
--              library, lists directories and changes between them.
--              Bench-proven on the DIYmalls ESP32-2432S032C_I with a
--              64 GB SDXC card (self-formatted FAT32, 32 KB clusters).
--
-- Sources:
-- http://www.microsoft.com/whdc/system/platform/firmware/fatgen.mspx
-- http://www.pjrc.com/tech/8051/ide/fat32.html
-- http://en.wikipedia.org/wiki/File_Allocation_Table
--
-- Requires: esp_sd_card, esp_fat32
--
-- Notes: entry creation + cluster allocation are done directly by this
-- sample (jallib's fat32_file_create leaves the first cluster at 0 and
-- the write path does not allocate); the numbers used with cd()/open()
-- assume a freshly formatted card.
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

-- setup spi + sd card: the ESP32-2432S032 microSD slot (CS=GPIO5,
-- SCK=GPIO18, MISO=GPIO19, MOSI=GPIO23) driven by the HSPI engine
-- through the GPIO matrix. The ESP32-adapted storage stack lives in the
-- jalv3compiler sample_lib overlay (sd_card.jal with a native sector
-- buffer) -- compile with sample_lib on the include path.
include esp32_spi_master
alias spi_master is spi_master_hw
alias sd_chip_select is pin_5_out

esp32_spi_init()                    -- matrix routing + SPI2 (HSPI) master bring-up
spi_master_hw_set_mode_11()         -- SD card SPI mode is 1,1
spi_master_hw_set_speed(ESP32_SPI_SPEED_INIT)   -- 400 kHz until the card is initialized

const bit SD_NATIVE_SECTOR_BUFFER = TRUE -- flat RAM: plain 512-byte buffer
const bit SD_ENABLE_ERASE = TRUE         -- erase fast path bench-proven on this target
include sd_card
include fat32_format

-- initialize the card (SDXC cards can need ~1s of power-up before the
-- first CMD0 leaves their internal-busy state; the library's own ~150 ms
-- retry window is too short, so retry here)
var byte sd_tries = 0
sd_init()
while sd_has_error loop
   _usec_delay(500_000)
   sd_init()
   sd_tries = sd_tries + 1
   if sd_tries == 20 then
      exit loop
   end if
end loop
if sd_has_error then
   print_string(serial_data, "SD INIT FAILED\r\n")
   sd_print_error(serial_data)
   print_crlf(serial_data)
else
   print_string(serial_data, "SD OK, sectors: ")
   print_dword_dec(serial_data, sd_number_of_sectors)
   print_string(serial_data, " (")
   if sd_card_type == SD_HIGH_CAPACITY then
      print_string(serial_data, "block addressed")
   else
      print_string(serial_data, "byte addressed")
   end if
   print_string(serial_data, ")\r\n")
end if

-- full bus speed for everything from here on (20 MHz, bench-proven;
-- the SD spec's 25 MHz default-speed ceiling applies to the CARD side)
spi_master_hw_set_speed(ESP32_SPI_SPEED_FAST)

-- optional on-card format (destructive: erases the card). Flip to TRUE,
-- flash once, flip back to FALSE. Fresh format gives the demo below its
-- deterministic entry numbering.
const bit FORMAT_CARD = FALSE

if FORMAT_CARD then
   print_string(serial_data, "FORMATTING CARD (destructive)...\r\n")
   fat32_format(serial_data)
   if sd_has_error then
      print_string(serial_data, "FORMAT FAILED\r\n")
      sd_print_error(serial_data)
      print_crlf(serial_data)
   else
      print_string(serial_data, "FORMAT OK\r\n")
   end if
end if

-- fat32 mount: full bus speed, file-entry table as a native word array
-- (the jallib large_array chunk library is classic-PIC banking machinery)
spi_master_hw_set_speed(ESP32_SPI_SPEED_FAST)

const bit FAT32_WRITE_LONG_FILE_NAMES = FALSE -- LFN write is not implemented (read-side is supported, patent posture documented in the library)
const word FAT32_FILES_MAX = 20            -- the max number of files allowed in a directory
const byte FAT32_FILE_NAME_SIZE = 80        -- choose max file_name size. if a file_name is longer the this, beginning chars will be cut. short file_names are 12 bytes.
const FAT32_DIR_FRAGMENTS_TO_ALLOW = 5     -- uses 6 bytes memory per fragment allowed (0 not allowed)
const FAT32_FILE_FRAGMENTS_TO_ALLOW = 5    -- uses 8 bytes memory per fragment allowed (0 not allowed)
const byte FAT32_ENTRIES_MAX = 2            -- highest file entry address can be 65535 (2 bytes per entry)
var word _fat32_entry_store[FAT32_FILES_MAX]
alias fat32_entry_location is _fat32_entry_store

include fat32

-- choose file attributes to filter out
fat32_filter_is_read_only  = FALSE
fat32_filter_is_hidden     = FALSE
fat32_filter_is_system     = FALSE
fat32_filter_is_volume_id  = FALSE
fat32_filter_is_directory  = FALSE
fat32_filter_is_archive    = FALSE

-- initialize fat32, go to 1st primary partition's root dir "\"
fat32_init(1)
if fat32_init_ok == TRUE then
   print_string(serial_data, "FAT32 READY!!!\r\n")
else
   print_string(serial_data, "FAT32 FAILED!!!\r\n")
   -- failure forensics: MBR partition entry + library error code
   sd_read_sector_address(0)
   print_string(serial_data, "mbr 446..461 + 510/511: ")
   var word _fi = 446
   for 16 loop
      print_byte_hex(serial_data, sd_sector_buffer[_fi])
      print_string(serial_data, " ")
      _fi = _fi + 1
   end loop
   print_byte_hex(serial_data, sd_sector_buffer[510])
   print_byte_hex(serial_data, sd_sector_buffer[511])
   print_crlf(serial_data)
   if fat32_error != FAT32_ERR_NONE then
      fat32_print_error(serial_data)
      print_crlf(serial_data)
   end if
end if
print_crlf(serial_data)

procedure separator() is
   serial_data = 13
   serial_data = 10
   const byte str3[] = "--------------------------------------------------------------------------------"
   print_string(serial_data, str3)
   print_crlf(serial_data)
end procedure

procedure demo_fat_cache_drop() is
   -- raw storage reads below invalidate the library's FAT-sector cache;
   -- dropping it prevents a stale-buffer flush on the next cluster access
   fat32_cache_valid = FALSE
end procedure

procedure demo_entry_name(word in base, byte in txt[]) is
   var word _i = 0
   for 11 loop
      storage_sector_buffer[base + _i] = txt[_i]
      _i = _i + 1
   end loop
end procedure

-- first free cluster in FAT #1, claimed as end-of-chain (raw sector walk)
function demo_alloc_cluster() return dword is
   var dword c = 3
   var word  o = 0
   var dword sec = 0
   while c < 100_000 loop
      sec = fat32_fat_begin + (c >> 7)
      storage_raw_read_sector_address(sec)
      o = word(c & 127) * 4
      if (storage_sector_buffer[o] == 0) & (storage_sector_buffer[o + 1] == 0) & (storage_sector_buffer[o + 2] == 0) & (storage_sector_buffer[o + 3] == 0) then
         storage_sector_buffer[o] = 0xFF
         storage_sector_buffer[o + 1] = 0xFF
         storage_sector_buffer[o + 2] = 0xFF
         storage_sector_buffer[o + 3] = 0x0F
         storage_raw_write_sector_address(sec)
         return c
      end if
      c = c + 1
   end loop
   return 0
end function

-- write a 32-byte directory entry into a directory's first sector
procedure demo_create_entry(dword in dir_sector, byte in attr, dword in cluster, dword in size, byte in name[]) is
   storage_raw_read_sector_address(dir_sector)
   var word e = 0
   var word base = 0
   var bit done = FALSE
   while (done != TRUE) & (e < 16) loop
      base = e * 32
      if (storage_sector_buffer[base] == 0x00) | (storage_sector_buffer[base] == 0xE5) then
         var word _k = 0
         for 32 loop
            storage_sector_buffer[base + _k] = 0
            _k = _k + 1
         end loop
         demo_entry_name(base, name)
         storage_sector_buffer[base + 11] = attr
         storage_sector_buffer[base + 26] = byte(cluster & 0xFF)
         storage_sector_buffer[base + 27] = byte((cluster >> 8) & 0xFF)
         storage_sector_buffer[base + 28] = byte(size & 0xFF)
         storage_sector_buffer[base + 29] = byte((size >> 8) & 0xFF)
         storage_sector_buffer[base + 30] = byte((size >> 16) & 0xFF)
         storage_sector_buffer[base + 31] = byte((size >> 24) & 0xFF)
         storage_raw_write_sector_address(dir_sector)
         done = TRUE
      end if
      e = e + 1
   end loop
end procedure

-- library convention: cluster N's first sector = cluster_begin + N * spc
-- (cluster_begin is the virtual cluster-0 base; the root directory is
-- cluster 2)
function demo_cluster_sector(dword in cluster) return dword is
   return fat32_cluster_begin + (cluster * fat32_sectors_per_cluster)
end function

const byte _demo_hello[] = "Hello from JALv3 on ESP32!"
const byte _demo_inside[] = "Written in TESTDIR!!"

if fat32_init_ok == TRUE then
   var dword root_sec = fat32_cluster_begin + (2 * dword(fat32_sectors_per_cluster))
   var dword file_cluster = 0
   var dword dir_cluster  = 0
   var dword inner_cluster = 0
   var word  check_i = 0
   var bit   check_ok = TRUE
   var byte  open_rc = 0

   -- 1. create HELLO.TXT: entry + allocated cluster + body, then verify
   --    through the library's open/read path
   demo_fat_cache_drop()
   file_cluster = demo_alloc_cluster()
   demo_create_entry(root_sec, 0x20, file_cluster, 26, "HELLO   TXT ")
   for 512 loop
      storage_sector_buffer[check_i] = 0
      check_i = check_i + 1
   end loop
   check_i = 0
   for 26 loop
      storage_sector_buffer[check_i] = _demo_hello[check_i]
      check_i = check_i + 1
   end loop
   storage_raw_write_sector_address(demo_cluster_sector(file_cluster))
   print_string(serial_data, "created HELLO.TXT (cluster ")
   print_dword_dec(serial_data, file_cluster)
   print_string(serial_data, ")\r\n")

   demo_fat_cache_drop()
   _fat32_read_dir_info()
   open_rc = fat32_file_open(0)
   if open_rc != 0 then
      fat32_read_file_sector_number(0)
      print_string(serial_data, "readback: ")
      check_i = 0
      for 26 loop
         serial_data = storage_sector_buffer[check_i]
         check_i = check_i + 1
      end loop
      print_crlf(serial_data)
      check_i = 0
      check_ok = TRUE
      for 26 loop
         if storage_sector_buffer[check_i] != _demo_hello[check_i] then
            check_ok = FALSE
         end if
         check_i = check_i + 1
      end loop
      if check_ok then
         print_string(serial_data, "FILE RW OK\r\n")
      else
         print_string(serial_data, "FILE RW MISMATCH\r\n")
      end if
      fat32_file_close()
   else
      print_string(serial_data, "open HELLO.TXT failed\r\n")
   end if

   -- 2. create TESTDIR with "." and ".." entries
   demo_fat_cache_drop()
   dir_cluster = demo_alloc_cluster()
   demo_create_entry(root_sec, 0x10, dir_cluster, 0, "TESTDIR    ")
   for 512 loop
      storage_sector_buffer[check_i] = 0
      check_i = check_i + 1
   end loop
   demo_entry_name(0, ".          ")
   storage_sector_buffer[11] = 0x10
   storage_sector_buffer[26] = byte(dir_cluster & 0xFF)
   storage_sector_buffer[27] = byte((dir_cluster >> 8) & 0xFF)
   demo_entry_name(32, "..         ")
   storage_sector_buffer[43] = 0x10
   storage_raw_write_sector_address(demo_cluster_sector(dir_cluster))
   print_string(serial_data, "created TESTDIR (cluster ")
   print_dword_dec(serial_data, dir_cluster)
   print_string(serial_data, ")\r\n")

   -- 3. root listing through the library
   demo_fat_cache_drop()
   _fat32_read_dir_info()
   separator()
   print_string(serial_data, "root directory:\r\n")
   fat32_print_directory(serial_data, FAT32_PRINT_ALL)
   separator()

   -- 4. cd into TESTDIR (entry 1), create INSIDE.TXT, verify through the lib
   demo_fat_cache_drop()
   if fat32_cd(1) then
      print_string(serial_data, "cd TESTDIR ok\r\n")
      demo_fat_cache_drop()
      inner_cluster = demo_alloc_cluster()
      demo_create_entry(demo_cluster_sector(dir_cluster), 0x20, inner_cluster, 20, "INSIDE  TXT ")
      for 512 loop
         storage_sector_buffer[check_i] = 0
         check_i = check_i + 1
      end loop
      check_i = 0
      for 20 loop
         storage_sector_buffer[check_i] = _demo_inside[check_i]
         check_i = check_i + 1
      end loop
      storage_raw_write_sector_address(demo_cluster_sector(inner_cluster))
      print_string(serial_data, "created INSIDE.TXT (cluster ")
      print_dword_dec(serial_data, inner_cluster)
      print_string(serial_data, ")\r\n")

      -- entries inside TESTDIR: 0=".", 1="..", 2=INSIDE.TXT
      demo_fat_cache_drop()
      _fat32_read_dir_info()
      open_rc = fat32_file_open(2)
      if open_rc != 0 then
         fat32_read_file_sector_number(0)
         print_string(serial_data, "inside readback: ")
         check_i = 0
         for 20 loop
            serial_data = storage_sector_buffer[check_i]
            check_i = check_i + 1
         end loop
         print_crlf(serial_data)
         check_i = 0
         check_ok = TRUE
         for 20 loop
            if storage_sector_buffer[check_i] != _demo_inside[check_i] then
               check_ok = FALSE
            end if
            check_i = check_i + 1
         end loop
         if check_ok then
            print_string(serial_data, "DIR FILE RW OK\r\n")
         else
            print_string(serial_data, "DIR FILE RW MISMATCH\r\n")
         end if
         fat32_file_close()
      else
         print_string(serial_data, "open INSIDE.TXT failed\r\n")
      end if
      separator()
      print_string(serial_data, "TESTDIR listing:\r\n")
      fat32_print_directory(serial_data, FAT32_PRINT_ALL)
      separator()

      -- back to the root (".." is entry 1 inside TESTDIR)
      demo_fat_cache_drop()
      if fat32_cd(1) then
         print_string(serial_data, "cd .. ok\r\n")
      end if
   else
      print_string(serial_data, "cd TESTDIR failed\r\n")
   end if
   if fat32_error != FAT32_ERR_NONE then
      fat32_print_error(serial_data)
      print_crlf(serial_data)
   end if
end if

print_string(serial_data, "##DONE##\r\n")

--------------------------------------------------------------------------------
-- heartbeat: the program stays alive for bench observation
--------------------------------------------------------------------------------
var word uptime = 0

forever loop
   _usec_delay(1_000_000)
   uptime = uptime + 1
   print_string(serial_data, "still alive - ")
   print_word_dec(serial_data, uptime)
   print_string(serial_data, " s\r\n")
end loop