-- ------------------------------------------------------
-- Title: ESP32 pin-alias hardware witness (ELEGOO ESP32-WROOM-32)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Silicon counterpart of the QEMU pin-alias body: the synthesized
--    device-file aliases (pin_N / pin_N_out / pin_N_direction) write
--    GPIO_OUT/GPIO_ENABLE and READ BACK on real hardware, and the
--    runtime-indexed `var bit out_bits[32] at GPIO_OUT` overlay
--    composes with them.  espressif QEMU models GPIO read-as-zero, so
--    only silicon can prove the VALUES; this sample prints one OK line
--    per passing check plus a tally over UART0 (115200 8N1).  240 MHz
--    via the proven esp32_clock bring-up skeleton.
--
-- Notes:
--    LED (board) is on GPIO 2 -- it blinks during the loop.
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include esp32_xtensa_lx6            -- target device (Xtensa LX6)
pragma target clock 240_000_000     -- oscillator frequency (part maximum)
pragma target OSC      PLL          -- 480 MHz BBPLL / 2
--
include esp32_clock
esp32_clock_init()                  -- cold bring-up (pragma-solved; no-op at crystal; runs before every delay)
--
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication
include esp32_serial_hw
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

_usec_delay(1_000_000) -- start delay: open the terminal BEFORE powering (bench rule); 1 s is enough and keeps QEMU runs sane

var byte checks = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 pin-alias witness - ESP32 WROOM\r\n")
print_string(serial_data, "boot: ROM clock, UART0 115200 8N1\r\n")
print_string(serial_data, "========================================\r\n")

-- alias writes + readbacks
pin_2_direction = 1                       -- RMW into GPIO_ENABLE
pin_2_out = 1                             -- RMW into GPIO_OUT
if (pin_2_out == 1) & (pin_2_direction == 1) then
   print_string(serial_data, "OK   pin_2_out/pin_2_direction readback\r\n")
   checks = checks + 1
else
   print_string(serial_data, "WRONG alias readback\r\n")
end if
if (GPIO_OUT & 0x04) != 0 then
   print_string(serial_data, "OK   GPIO_OUT bit 2 set after pin_2_out=1\r\n")
   checks = checks + 1
end if

-- bank-1 aliases (GPIO_OUT1: pin 32)
pin_32_direction = 1
pin_32_out = 1
if (GPIO_OUT1 & 0x01) != 0 then
   print_string(serial_data, "OK   pin_32_out bank-1 readback\r\n")
   checks = checks + 1
end if
pin_32_out = 0

-- runtime-indexed overlay over GPIO_OUT (the sibling SFR probe)
var bit out_bits[32] at GPIO_OUT
var byte i
for 8 using i loop
   out_bits[i] = 1
end loop
if (GPIO_OUT & 0xFF) == 0xFF then
   print_string(serial_data, "OK   overlay out_bits[0..7] sets bits 0..7\r\n")
   checks = checks + 1
end if
out_bits[5] = 0
if ((GPIO_OUT & 0xFF) == 0xDF) & (pin_5_out == 0) & (pin_4_out == 1) then
   print_string(serial_data, "OK   overlay+alias single-bit views agree\r\n")
   checks = checks + 1
end if

print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 5\r\n")
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##\r\n")

-- heartbeat: LED blink at ~1 Hz on the pin alias
forever loop
   pin_2_out = 1
   _usec_delay(500_000)
   pin_2_out = 0
   _usec_delay(500_000)
end loop

