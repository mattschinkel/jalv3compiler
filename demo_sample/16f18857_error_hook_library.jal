-- ------------------------------------------------------
-- 16F18857 twin of the retired 16f1825 sample (2026-11-06); the device
-- prelude is the generator-kit convention (HFINT32, EUSART on RC6/RC7 via PPS).
-- Title: Runtime error hook — demo of demo_lib/error_hook.jal
-- Author: Matthew Schinkel, Copyright (c) 2026
-- Compiler: jalv3-x86-64 (16F18857 twin of the retired 16F1825 sample)
--
-- `error_hook.jal` defines `_error_hook()` (the procedure the compiler calls
-- when a runtime error is raised) and lets the application tailor it with two
-- optional aliases defined BEFORE the include:
--
--    alias _error_device is serial_data   -- print the error there
--    alias _error_bit    is led           -- latch a flag/LED, cleared by app
--                                         (set its direction yourself)
--
-- Include it after the libraries it uses (print) and BEFORE the code that can
-- fail.  The heap below is large enough for a few appends: `my_string3`
-- grows 20 -> 40 -> 60 characters, then the heap is full, the handler prints
-- "[heap full]" and raises the LED, and the text stops growing.
-- ------------------------------------------------------
include 16f18857                     -- target PICmicro
pragma target clock 32_000_000
pragma target OSC      OFF           -- internal oscillator
pragma target RSTOSC   HFINT32       -- power-up clock select (32 MHz)
pragma target CLKOUTEN DISABLED      -- no clock output
pragma target WDT      DISABLED      -- watchdog
pragma target BROWNOUT DISABLED      -- no brownout reset
pragma target FCMEN    DISABLED      -- no clock monitoring
pragma target CSWEN    ENABLED       -- allow OSCCON1 writes
pragma target LVP      ENABLED       -- low voltage programming
pragma target MCLR     EXTERNAL      -- external reset
enable_digital_io()                  -- make all pins digital I/O
_usec_delay (100_000)                -- wait for power to stabilize

const serial_hw_baudrate  = 115200
include pps
pps_control_lock(FALSE)
RC6PPS = PPS_TX
RXPPS  = PPS_RC7
pps_control_lock(TRUE)
alias pin_TX is pin_C6
alias pin_TX_direction is pin_C6_direction
alias pin_RX is pin_C7
alias pin_RX_direction is pin_C7_direction
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
alias serial is serial_hw_data

include print
include delay

-- customise the handler, then pull it in.  A real LED pin must be made an
-- output first: the handler only writes the bit, it does not configure it.
alias led is pin_a0
pin_a0_direction = output        -- the direction belongs to the real pin name
led = false

alias _error_device is serial_data
alias _error_bit    is led
include error_hook

pragma target string_heap_size 200
include strings_dynamic

var string my_string1 = "My string" & 1
var byte two = 2
var string my_string2 = "My string" & two
var string my_string3

forever loop
   my_string3 = my_string3 & my_string1 & my_string2
   print_string(serial, my_string3)
   print_crlf(serial)
   delay_1s(1)
end loop
