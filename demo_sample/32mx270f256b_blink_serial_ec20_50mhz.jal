-- Title: Blink + serial heartbeat -- self-proving blink sample
-- Author: Matthew Schinkel
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Blinks the board LED once per second AND prints a ##BLINK## marker
--    over serial every cycle, so the sample proves its own clock/serial
--    wiring: on a simulator the marker is the runtime test.
--
--
-- Notes:
--    - Generated.
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 50_000_000      -- oscillator frequency
pragma target oscillator 20_000_000 -- external clock module on OSC1
pragma target OSC    EC_SPLL        -- external clock through the system PLL (/5 x20 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
BMXCON_BMXWSDRM = 1                -- data-RAM wait state: SRAM needs it above the part's 40 MHz rating
--
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

-- board LED -- pin values come from blocks/boards/<board>.pins
alias led is pin_B14
pin_B14_direction = OUTPUT

-- UART1 wiring for PPS PIC32 parts -- pin values come from
-- blocks/boards/<board>.pins.  Works for MX and MZ (the IOLOCK unlock
-- is a no-op on MZ).  Serial_hw_init() applies the PPS routing inside
-- its own SYSKEY window (including the MX CFGCON.IOLOCK clear) --
-- nothing to unlock here.
--
const serial_hw_baudrate = 115_200
alias serial_hw_pin_tx is pin_B3
alias serial_hw_pin_tx_direction is pin_B3_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB3R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2
--
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
--
include print

var dword blinks = 0

print_string(serial_data, "##BLINK## boot")
print_crlf(serial_data)

-- board wiring (LED pin, serial pins) comes from blocks/boards/*.pins
-- via the blink_pins and serial_uart1 includes
forever loop
   led = ON
   _usec_delay(500_000)             -- 500 ms
   led = OFF
   _usec_delay(500_000)
   blinks = blinks + 1
   print_string(serial_data, "##BLINK## ")
   print_dword_dec(serial_data, blinks)
   print_crlf(serial_data)
end loop