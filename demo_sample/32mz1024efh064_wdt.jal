-- ------------------------------------------------------
-- Title: PIC32MZ1024EFH064 watchdog (WDT CONTROL mode, runtime WDTCON)
-- Author: Matthew Schinkel, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Watchdog demo in CONTROL mode -- the 32-bit equivalent of the
--    classic `pragma target WDT CONTROL` fuse value: the FWDTEN fuse
--    stays DISABLED (no power-cycle latching) and the program switches
--    the watchdog on at runtime through WDTCON (demo_lib/wdt.jal),
--    services it once per loop pass, then deliberately stops
--    servicing: on silicon the WDT resets the board ~4 s later and
--    the whole demo repeats.  QEMU does not model the WDT, so the
--    runtime contract pins the serviced phase + the hang marker; the
--    reset itself is silicon-only.
--
-- Notes:
--    - MZ divider is fuse-owned: `pragma target WDTPS PS4096` sets a
--      ~4.0 s period (measured 2026-10-25); RUNDIV in WDTCON is a
--      read-only mirror of that fuse, so wdt_enable() ignores its
--      divider argument (kept for the shared MX/MZ call shape).
--    - wdt_clear() latches the key with a 16-bit store to WDTCON+2;
--      word-width key writes are ignored by silicon.
--    - LED E1 (MINI-32) blinks during both phases.
--
-- @sim_validate begin
-- duration_s: 6
-- uart_contains: ##HANG##
-- machine: pic32mz-explorer16
-- expect byte v_phase 2
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication (MINI-32 wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1

include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print
include wdt

-- MZ divider is FUSE-OWNED: RUNDIV (WDTCON<12:8>) is a read-only mirror
-- of the DEVCFG1 WDTPS fuse -- set the period here, not at runtime.
pragma target WDTPS PS4096                   -- ~4.0 s (measured on MINI-32)

alias led1 is pin_E1
pin_E1_direction = OUTPUT

_usec_delay(100_000)

const byte WDT_DIV = 12                     -- arg ignored on MZ (kept for the shared call shape)
var volatile byte phase = 0
var byte beat

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 WDT demo - CONTROL mode\r\n")
print_string(serial_data, "========================================\r\n")
print_string(serial_data, "fuses: WDT DISABLED + WDTPS PS4096 (~4 s)\r\n")
print_string(serial_data, "enable WDT at runtime: WDTCON.ON = 1\r\n")
wdt_enable(WDT_DIV)
phase = 1

-- phase 1: service the WDT once per pass -- this section never resets
beat = 0
while beat < 5 loop
   beat = beat + 1
   print_string(serial_data, "serviced ")
   print_byte_dec(serial_data, beat)
   print_string(serial_data, "\r\n")
   led1 = ON
   _usec_delay(250_000)
   led1 = OFF
   _usec_delay(250_000)
   wdt_clear()
end loop

-- phase 2: stop servicing -- on silicon the WDT reset fires in ~4 s
print_string(serial_data, "##HANG## no more wdt_clear - reset expected\r\n")
phase = 2
forever loop
   print_string(serial_data, "hang beat\r\n")
   led1 = ON
   _usec_delay(250_000)
   led1 = OFF
   _usec_delay(250_000)
end loop

