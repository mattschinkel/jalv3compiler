-- Title: PIC18F67J50 pin aliases — classic PIC18 (16-bit) feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: pin aliases on the PIC18F67J50 bench board: the pin name and
--              its `_direction` twin alias the PORT/TRIS registers, two
--              aliases of the same pin address the same bit, and a write
--              through one is visible in the port register.
--
--              Results are printed on UART1 and mirrored on the LED.

include 18f67j50

pragma target clock     48_000_000
pragma target OSC       INTOSC_NOCLKOUT_PLL
pragma target PLLDIV    P2
pragma target CPUDIV    P1
pragma target WDT       CONTROL
pragma target XINST     DISABLED
pragma target DEBUG     DISABLED
pragma target FCMEN     DISABLED
pragma target IESO      DISABLED
--
WDTCON_SWDTEN = OFF
OSCCON_SCS = 0
OSCTUNE_PLLEN = TRUE
--
enable_digital_io()
_usec_delay(100_000)
--
alias led1 is pin_G2
pin_G2_direction = OUTPUT
--
const serial_hw_baudrate = 115200
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4
include print
include format
--

alias led_alias is pin_G2           -- second alias to the same pin
var byte bad = 0
--
print_string(serial_data, "JALv2 PIC18F67J50: pin aliases\r\n")
--
led1 = ON
if (PORTG & 0x04) == 0 then
   bad = bad + 1
end if
--
led_alias = OFF
if (PORTG & 0x04) != 0 then
   bad = bad + 1
end if
--
pin_G2_direction = INPUT
if (TRISG & 0x04) == 0 then
   bad = bad + 1
end if
pin_G2_direction = OUTPUT
if (TRISG & 0x04) != 0 then
   bad = bad + 1
end if
--
print_string(serial_data, "pin alias checks: ")
if bad == 0 then
   print_string(serial_data, "OK")
else
   print_string(serial_data, "FAIL")
end if
print_crlf(serial_data)
led1 = bad == 0
forever loop
end loop
