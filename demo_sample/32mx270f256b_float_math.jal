-- Title: PIC32MX270F256B soft-float math (IEEE-754 single precision)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    PIC32 port of the ESP32 float demo: IEEE-754 single-precision
--    support added since jalv2 2.5r9. `var float` arithmetic
--    (add/sub/mul/div), mixed float/integer expressions, all six
--    comparisons, and the float-to-int / int-to-float conversions.
--    The QEMU PIC32MZ core (EC) has no FPU, so all operations run the
--    compiler's outlined soft-float routines. Output on UART1 at 115200.
--
-- Notes:
--    - Ported from demo_sample/esp32_float_math.jal (same sections and
--      self-check expectations). No clock bring-up: the compiler-emitted
--      boot init + DEVCFG fuses boot straight at 200 MHz.
--    - Compile: ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' -no-codfile this file
--    - QEMU gate: ./tests/jal_sim_validate.sh --compiler ./bin/jalv3-x86-64 this file
--
-- @sim_validate begin
-- duration_s: 8
-- uart_contains: ##DONE##
-- machine: pic32mx7-explorer16
-- expect byte v_checks 8
-- @sim_validate end
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 40_000_000      -- oscillator frequency
pragma target OSC    FRC_SPLL       -- internal 8 MHz FRC through the system PLL (/2 x20 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

alias led1 is pin_B14
alias led2 is pin_B13
pin_B14_direction = OUTPUT
pin_B13_direction = OUTPUT

-- setup uart for communication (board wiring: RPB3 = U1TX, RPB2 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_B3
alias serial_hw_pin_tx_direction is pin_B3_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB3R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2             -- U1RXR code for RPB2

-- setup uart for communication
include serial_hardware
serial_hw_init()
-- aliases so it is easy to change from serial hw to serial sw
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
include print_float_exact
include format

var float pi      = 3.14159265
var float radius  = 2.5
var float area
var float mean
var float ratio
var sdword scaled
var volatile byte checks = 0

procedure print_flt(float in v) is
   print_float_exact(serial_data, v)
end procedure

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC32 demo: float math\r\n")
print_string(serial_data, "  IEEE-754 single precision, soft-float\r\n")
print_string(serial_data, "  routines (no FPU)\r\n")
print_string(serial_data, "========================================\r\n")

-- multiply, mixed with an integer constant
print_string(serial_data, "--- multiply: pi * r * r -----------------\r\n")
area = pi * radius * radius
print_string(serial_data, "area (pi*r*r)       = ")
print_flt(area)
if area > 19.6 then
   if area < 19.7 then
      checks = checks + 1
      print_string(serial_data, "  OK (~19.63)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~19.63)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~19.63)\r\n")
end if

-- divide
print_string(serial_data, "--- divide: r / pi -----------------------\r\n")
ratio = radius / pi
print_string(serial_data, "radius / pi         = ")
print_flt(ratio)
if ratio > 0.79 then
   if ratio < 0.80 then
      checks = checks + 1
      print_string(serial_data, "  OK (~0.796)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~0.796)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~0.796)\r\n")
end if

-- add/sub chain with a negative-adjacent result
print_string(serial_data, "--- add / subtract chain ------------------\r\n")
mean = pi - 4.0 + 1.0
print_string(serial_data, "pi - 4 + 1          = ")
print_flt(mean)
if mean > 0.14 then
   if mean < 0.15 then
      checks = checks + 1
      print_string(serial_data, "  OK (~0.142)\r\n")
   else
      print_string(serial_data, "  WRONG (want ~0.142)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want ~0.142)\r\n")
end if

-- float to integer truncation
print_string(serial_data, "--- float to int truncation ---------------\r\n")
scaled = sdword(pi * 1000.0)
print_string(serial_data, "pi * 1000 truncated = ")
print_sdword_dec(serial_data, scaled)
if scaled == 3141 then
   checks = checks + 1
   print_string(serial_data, "  OK\r\n")
else
   print_string(serial_data, "  WRONG (want 3141)\r\n")
end if

-- integer to float in an expression
print_string(serial_data, "--- int to float in an expression ---------\r\n")
var float fi = 7
fi = fi / 2
print_string(serial_data, "7 / 2 (inttofloat)  = ")
print_flt(fi)
if fi > 3.4999 then
   if fi < 3.5001 then
      checks = checks + 1
      print_string(serial_data, "  OK\r\n")
   else
      print_string(serial_data, "  WRONG (want 3.5)\r\n")
   end if
else
   print_string(serial_data, "  WRONG (want 3.5)\r\n")
end if

-- comparisons
print_string(serial_data, "--- comparisons ---------------------------\r\n")
if pi > radius then
   checks = checks + 1
   print_string(serial_data, "pi > radius:        true  OK\r\n")
else
   print_string(serial_data, "pi > radius:        false  WRONG\r\n")
end if
if mean < 1.0 then
   checks = checks + 1
   print_string(serial_data, "mean < 1:           true  OK\r\n")
else
   print_string(serial_data, "mean < 1:           false  WRONG\r\n")
end if
if radius <= 2.5 then
   checks = checks + 1
   print_string(serial_data, "radius <= 2.5:      true  OK\r\n")
else
   print_string(serial_data, "radius <= 2.5:      false  WRONG\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 8\r\n")
if checks == 8 then
   print_string(serial_data, "ALL FLOAT CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

