-- ------------------------------------------------------
-- Title: ESP32 pin-alias hardware witness (ELEGOO ESP32-WROOM-32)
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    Silicon counterpart of the QEMU pin-alias body: the synthesized
--    device-file aliases (pin_N / pin_N_out / pin_N_direction) write
--    GPIO_OUT/GPIO_ENABLE and READ BACK on real hardware, and the
--    runtime-indexed `var bit out_bits[32] at GPIO_OUT` overlay
--    composes with them.  espressif QEMU models GPIO read-as-zero, so
--    only silicon can prove the VALUES; this sample prints one OK line
--    per passing check plus a tally over UART0 (115200 8N1).  240 MHz
--    via the proven esp32_clock bring-up skeleton.
--
-- Notes:
--    LED (board) is on GPIO 2 -- it blinks during the loop.
--
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mz1024efh064              -- target device (PIC32MZ EF, MIPS32r5)
pragma target clock 200_000_000     -- oscillator frequency
pragma target OSC      FRC_SPLL     -- internal FRC through the system PLL
pragma target image pfm             -- PFM app + compiler boot block
pragma target WDT   DISABLED        -- watchdog
pragma target DMT   DISABLED        -- deadman timer
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay(100_000)                -- wait for power to stabilize

-- setup uart for communication (board wiring: RPF0 = U1TX, RPF1 = U1RX)
const serial_hw_baudrate  = 115_200
alias serial_hw_pin_tx is pin_F0
alias serial_hw_pin_tx_direction is pin_F0_direction
alias serial_hw_pin_rx is pin_F1
alias serial_hw_pin_rx_direction is pin_F1_direction
alias serial_hw_tx_pps is RPF0R
const serial_hw_rx_pps = PPS_IN_U1RX_RPF1

include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
const PRINT_MAX_VAR_SIZE = 4

include print

_usec_delay(5_000_000) -- start delay: time to open a serial terminal

var byte checks = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 pin-alias witness - PIC32MZ1024EFH064\r\n")
print_string(serial_data, "========================================\r\n")

-- plain pin alias: the pin write lands in LATE, the read returns the pin level
pin_E1 = 1
if (LATE & 0x0002) != 0 then
   print_string(serial_data, "OK   LED bit set in LATE after pin write\r\n")
   checks = checks + 1
end if

-- fixed-function pin alias (the PGED2/PGEC2 debug pair share RB7): the same port
-- bit through its friendly name, plus the _direction twin in TRIS
pin_PGED2 = 1
pin_PGED2_direction = OUTPUT
if pin_PGED2 == 1 then
   print_string(serial_data, "OK   pin_PGED2 alias readback\r\n")
   checks = checks + 1
end if

-- runtime-indexed bit overlay over LATE (the sibling SFR-overlay idiom).
-- Bits {5,6} only: E0/E1 are the board LEDs (written elsewhere), E5/E6
-- are free; avoid bits a board may hold (the MX bench showed held latch
-- bits cannot be verified through ANY codegen path).
var bit lat_bits[16] at LATE
var byte i
for 2 using i loop
   lat_bits[i + 5] = 1
end loop
if (LATE & 0x0060) == 0x0060 then
   print_string(serial_data, "OK   overlay lat_bits sets bits 5,6\r\n")
   checks = checks + 1
end if
lat_bits[6] = 0
if ((LATE & 0x0040) == 0) & (lat_bits[6] == 0) & (lat_bits[5] == 1) then
   print_string(serial_data, "OK   overlay+alias single-bit views agree\r\n")
   checks = checks + 1
end if

print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 4\r\n")
print_string(serial_data, "##DONE##\r\n")

-- heartbeat: LED blink at ~1 Hz through the plain pin alias
forever loop
   pin_E1 = 1
   _usec_delay(500_000)
   pin_E1 = 0
   _usec_delay(500_000)
end loop

