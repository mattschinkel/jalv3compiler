-- Title: PIC18F4620 dynamic strings (var string on the heap) + & chains
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Adapted-by:
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: Shows the dynamic string heap on a classic PIC18: `var string`
-- handles live on a compacting heap, `&` concatenates, COUNT() returns the
-- effective length, literals compare with `==`, and the string_* helpers
-- build from / into byte arrays. Serial output uses the jallib print
-- library through the hardware USART (alias serial_data is serial_hw_data);
-- 115200 on TX, prints the whole tour then parks.
--
-- Also demonstrates `&` chains: assignment chains over string operands,
-- integer operands rendered as ASCII decimal ("n=" & 42 to "n=42"; signed
-- values keep the minus sign), float constants in shortest-round-trip
-- decimal ("2.5" to "2.5", "-1.25" to "-1.25"), and a chain in expression
-- position as the right-hand operand of `==`.
--
-- Note: heap `&` chain cells are retained for the life of the program, so
-- this tour keeps the chain count small and runs the byte-array helpers
-- before the chain sections (classic-core heap accounting under many
-- chained allocations is a known open item; see the fix index).
--
-- Sources:
--
-- (dynamic string heap)
-- (stage 1: & chains in expression position)
-- (stages 2a/2b: integer operands)
-- (stage 2d: float constants)
--
-- This file has been generated by Matt's sample generator.
--

include 18f4620                       -- target device

pragma target clock    20_000_000
pragma target OSC      HS
pragma target WDT      CONTROL
pragma target XINST    DISABLED
pragma target DEBUG    DISABLED
pragma target BROWNOUT DISABLED
pragma target FCMEN    DISABLED
pragma target IESO     DISABLED
pragma target LVP      DISABLED
pragma target MCLR     EXTERNAL

enable_digital_io()
_usec_delay(100_000)

-- setup uart for communication
const serial_hw_baudrate = 115_200
include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data

const PRINT_MAX_VAR_SIZE = 4

include print   -- print_string accepts const literals, byte buffers,
                -- and heap var strings (content marshalled + exact
                -- runtime length as the hidden count)

const word _string_heap_size = 240
pragma string index byte

include strings_dynamic

var string greeting
var string name
var string out
var string expected
var byte src[4]
var byte cnt
var dword addr
var sqword big_signed
var byte checks = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "  JALv2 PIC18F4620 demo: dynamic strings\r\n")
print_string(serial_data, "  var string on a compacting heap,\r\n")
print_string(serial_data, "  & chains, COUNT(), == compares\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- basics: assign + COUNT --------------\r\n")
-- name = "JAL" & "v2 " & "ESP32!"   -- literals-only chains were already legal;
name = "JALv2 ESP32!"               -- (kept as the heapfull-suite baseline)

print_string(serial_data, "name:            ")
print_string(serial_data, name)
print_crlf(serial_data)

print_string(serial_data, "greeting length: ")
print_byte_dec(serial_data, COUNT(greeting))
print_crlf(serial_data)

print_string(serial_data, "name length:     ")
print_byte_dec(serial_data, COUNT(name))
print_crlf(serial_data)

-- Concatenate onto an existing string and compare with a literal
print_string(serial_data, "--- assignment chain + compare ----------\r\n")
greeting = "Hello, " & name          -- assignment chains: string operands
if greeting == "Hello, JALv2 ESP32!" then
   checks = checks + 1
   print_string(serial_data, "combined:        MATCH (")
   print_byte_dec(serial_data, COUNT(greeting))
   print_string(serial_data, " chars)\r\n")
else
   print_string(serial_data, "combined:        MISMATCH\r\n")
end if

-- Stage 1: `&` chains in EXPRESSION position -- compare operands on
-- either side of `==`, and procedure arguments
print_string(serial_data, "--- & chains in expression position ------\r\n")
if greeting == "Hello, " & name then
   checks = checks + 1
   print_string(serial_data, "expr-chain ==:   MATCH\r\n")
else
   print_string(serial_data, "expr-chain ==:   MISMATCH\r\n")
end if
if "Hello, " & name == greeting then
   checks = checks + 1
   print_string(serial_data, "chain-LHS ==:    MATCH\r\n")
else
   print_string(serial_data, "chain-LHS ==:    MISMATCH\r\n")
end if
if greeting != "A" & name & "B" then
   checks = checks + 1
   print_string(serial_data, "expr-chain !=:   MATCH\r\n")
else
   print_string(serial_data, "expr-chain !=:   MISMATCH\r\n")
end if
print_string(serial_data, "arg-chain:       ")
print_string(serial_data, "arg-" & name)   -- "prefix-" & name as an argument
print_crlf(serial_data)

-- Stages 2a/2b: integer operands render ASCII decimal in chains
print_string(serial_data, "--- integer operands in chains -----------\r\n")
cnt = 42
addr = 4294967295
big_signed = -1234567890
out = "cnt=" & cnt & " addr=" & addr
print_string(serial_data, out)
print_crlf(serial_data)
out = "neg: " & -42 & " sqw: " & big_signed
print_string(serial_data, out)
print_crlf(serial_data)
if out == "neg: -42 sqw: -1234567890" then
   checks = checks + 1
   print_string(serial_data, "int-chain ==:    MATCH\r\n")
else
   print_string(serial_data, "int-chain ==:    MISMATCH\r\n")
end if

-- Stage 2d: float constants, shortest-round-trip decimal
print_string(serial_data, "--- float constants in chains ------------\r\n")
out = "pi~ " & 1.5 & " neg " & -2.25 & " hun " & 100.0
print_string(serial_data, out)
print_crlf(serial_data)
if out == "pi~ 1.5 neg -2.25 hun 100" then
   checks = checks + 1
   print_string(serial_data, "float-chain ==:  MATCH\r\n")
else
   print_string(serial_data, "float-chain ==:  MISMATCH\r\n")
end if

-- Build a string from a byte array
print_string(serial_data, "--- string_from_array --------------------\r\n")
src[0] = "d"
src[1] = "o"
src[2] = "n"
src[3] = "e"
if string_from_array(name, src) then
   if name == "done" then
      checks = checks + 1
      print_string(serial_data, "from array:      ok\r\n")
   else
      print_string(serial_data, "from array:      WRONG CONTENT\r\n")
   end if
else
   print_string(serial_data, "from array:      FAILED\r\n")
end if

print_string(serial_data, "--- result --------------------------------\r\n")
print_string(serial_data, "checks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 7\r\n")
if checks == 7 then
   print_string(serial_data, "ALL STRING CHECKS PASSED\r\n")
else
   print_string(serial_data, "SOME CHECKS FAILED - see sections above\r\n")
end if
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##")
print_crlf(serial_data)

forever loop
   _usec_delay(1_000_000)
end loop

