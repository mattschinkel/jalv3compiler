-- ------------------------------------------------------
-- Title: Runtime error hook — demo of demo_lib/error_hook.jal
-- Author: Matthew Schinkel, Copyright (c) 2026
-- Compiler: jalv3-x86-64
--
-- `error_hook.jal` defines `_error_hook()` (the procedure the compiler calls
-- when a runtime error is raised) and lets the application tailor it with two
-- optional aliases defined BEFORE the include:
--
--    alias _error_device is serial_data   -- print the error there
--    alias _error_bit    is led           -- latch a flag/LED, cleared by app
--                                         (set its direction yourself)
--
-- Include it after the libraries it uses (print) and BEFORE the code that can
-- fail.  The heap below is large enough for a few appends: `my_string3`
-- grows 20 -> 40 -> 60 characters, then the heap is full, the handler prints
-- "[heap full]" and raises the LED, and the text stops growing.
-- ------------------------------------------------------
include 16f1825
pragma target clock    16_000_000
pragma target OSC      INTOSC_NOCLKOUT
pragma target PLLEN    DISABLED
pragma target WDT      DISABLED
pragma target PWRTE    ENABLED
pragma target BROWNOUT DISABLED
pragma target FCMEN    DISABLED
pragma target IESO     DISABLED
pragma target LVP      DISABLED
pragma target MCLR     EXTERNAL
enable_digital_io()

const serial_hw_baudrate = 115200
alias pin_RX_direction is pin_c5_direction
alias pin_TX_direction is pin_c4_direction
include serial_hardware
serial_hw_init()
alias serial      is serial_hw_data
alias serial_data is serial_hw_data
include print
include delay

-- customise the handler, then pull it in.  A real LED pin must be made an
-- output first: the handler only writes the bit, it does not configure it.
alias led is pin_a0
pin_a0_direction = output        -- the direction belongs to the real pin name
led = false

alias _error_device is serial_data
alias _error_bit    is led
include error_hook

const word _string_heap_size = 200
include strings_dynamic

var string my_string1 = "My string" & 1
var byte two = 2
var string my_string2 = "My string" & two
var string my_string3

forever loop
   my_string3 = my_string3 & my_string1 & my_string2
   print_string(serial, my_string3)
   print_crlf(serial)
   delay_1s(1)
end loop
