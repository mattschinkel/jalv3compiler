-- Title: PIC32MX270F256B print demo, 48 MHz internal FRC, hardware UART
-- Author: Matt, copyright (c) 2026, all rights reserved.
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description:
--    48 MHz (the maximum exact SYSCLK from the internal FRC):
--    8 MHz / FPLLIDIV 2 = 4 MHz, x FPLLMUL 24 = 96 MHz VCO,
--    / FPLLODIV 2 = 48 MHz.  Emitted words: DEVCFG1 0xFF605F59,
--    DEVCFG2 0xFFF9F9F9 (IDIV /2, MUL x24, ODIV /2), DEVCFG0 0x7FFFFFFB.
--
--    Print-library demo on hardware UART1: TX=RB3 (pin 7), RX=RB2
--    (pin 6), 115200 8N1, LED RB14 2 s on/off.  PBCLK = 24 MHz, so
--    U1BRG = 51 (~115.4 kbaud).  One SRAM wait state is enabled.
--
--    RB3 is used instead of RB0 because RB0 is PGED1: UART TX on RB0 is
--    silent while the programmer/debug tool is attached.  CFGCON.IOLOCK
--    is cleared before serial_hw_init() because MX resets PPS locked.
--
--    50 MHz is not reachable from FRC (the PLL has no x25); 48 MHz is
--    the maximum internal result.  The datasheet allows 50 MHz up to
--    +85 C (40 MHz at +105 C), so 48 MHz is within the 85 C rating.
--
-- Notes:
--    - Wiring: RB3 (pin 7) -> USB-UART RXD, RB2 (pin 6) <- USB-UART TXD,
--      GND common, 3.3 V TTL.
--    - Build:
--        ./bin/jalv3-x86-64 -s 'demo_lib;third_party/jallib/lib' this file
--    - Program with your PICkit, then release the target from the tool's
--      hold-in-reset state (`ipecmd ... -OK -OL`) or detach the programmer.
-- -----------------------------------------------------------------------------
-- This file has been generated by Matt's sample generator.
--

include 32mx270f256b                -- target device (PIC32MX1/2, MIPS32 M4K)
pragma target clock 48_000_000      -- oscillator frequency (highest exact FRC speed on this PLL)
pragma target OSC    FRC_SPLL       -- internal FRC through the system PLL (/2 x24 /2)
pragma target image pfm             -- 3 KB boot flash: PFM app + boot block
pragma target WDT   DISABLED        -- watchdog
--
BMXCON_BMXWSDRM = 1                -- data-RAM wait state: SRAM needs it above the part's 40 MHz rating
enable_digital_io()                 -- all pins digital (RB14 has an analog function)
_usec_delay(100_000)                -- wait for power to stabilize

BMXCON_BMXWSDRM = 1          -- one SRAM wait state at 48 MHz

const serial_hw_baudrate = 115_200
alias serial_hw_pin_tx is pin_B3
alias serial_hw_pin_tx_direction is pin_B3_direction
alias serial_hw_pin_rx is pin_B2
alias serial_hw_pin_rx_direction is pin_B2_direction
alias serial_hw_tx_pps is RPB3R
const serial_hw_rx_pps = PPS_IN_U1RX_RPB2

-- MX: clear CFGCON.IOLOCK before the PPS writes inside serial_hw_init().
SYSKEY = 0x00000000
SYSKEY = 0xAA996655
SYSKEY = 0x556699AA
CFGCON_IOLOCK = 0
SYSKEY = 0x00000000

include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data

const PRINT_MAX_VAR_SIZE = 6
include print
include format

alias led is pin_B14
pin_B14_direction = OUTPUT

var byte n = 0

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 hardware-UART print demo - PIC32MX270F256B\r\n")
print_string(serial_data, "115200 8N1, TX=RB3 (pin 7), RX=RB2 (pin 6)\r\n")
print_string(serial_data, "========================================\r\n")

forever loop
   led = ON
   print_string(serial_data, "alive ")
   print_byte_dec(serial_data, n)
   print_crlf(serial_data)
   n = n + 1
   _usec_delay(2_000_000)
   led = OFF
   _usec_delay(2_000_000)
end loop

