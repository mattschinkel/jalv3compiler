-- Title: PIC16F1825 optional_params feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: optional_params demo for the enhanced-midrange PIC16F1825 (32 MHz
--              INTOSC+PLL, serial on EUSART). The test body lives in
--              the f1825_optional_params_body include block.
--
-- Requires: f1825_optional_params_body
-- This file has been generated by Matt's sample generator.
--

include 16f1825                      -- target PICmicro
--
-- This program uses the internal oscillator at 8 MHz through the
-- 4x PLL: 32 MHz (the PLL is software-enabled below).
pragma target clock 32_000_000      -- oscillator frequency
--
pragma target OSC      INTOSC_NOCLKOUT           -- internal oscillator
pragma target PLLEN    DISABLED                  -- PLL software controlled
pragma target CLKOUTEN DISABLED                  -- no clock output
pragma target WDT      DISABLED                  -- watchdog
pragma target DEBUG    DISABLED                  -- no debugging
pragma target BROWNOUT DISABLED                  -- no brownout reset
pragma target FCMEN    DISABLED                  -- no clock monitoring
pragma target IESO     DISABLED                  -- no int/ext osc switching
pragma target LVP      ENABLED                   -- low voltage programming
pragma target MCLR     EXTERNAL                  -- external reset
--
OSCCON_SCS = 0                      -- clock selected by fuse OSC
OSCCON_IRCF = 0b1110                -- internal oscillator to 8 MHz
OSCCON_SPLLEN = TRUE                -- enable PLL, multiply by 4 -> 32 MHz
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay (100_000) -- wait for power to stablilize

-- 16f1825 port of the optional_params demo (enhanced midrange PIC16, 32 MHz
--   INTOSC+PLL; LED on A0, serial on EUSART @115200)
alias led1 is pin_A0
alias led2 is pin_A1
pin_A0_direction = OUTPUT
pin_A1_direction = OUTPUT

-- setup uart for communication (EUSART on the part's fixed TX/RX pins)
const serial_hw_baudrate  = 115200
-- EUSART pin pair (APFCON-selectable on this part; RC4/RC5 chosen)
alias pin_TX is pin_C4
alias pin_TX_direction is pin_C4_direction
alias pin_RX is pin_C5
alias pin_RX_direction is pin_C5_direction

include serial_hardware
serial_hw_init()
alias serial_data is serial_hw_data
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4

include print
-- ---------------------------------------------------------------------------
-- the feature under test: procedures with optional parameters
-- ---------------------------------------------------------------------------

var byte r_lo = 0
var byte r_hi = 0

-- three-formal signature, two of them optional
procedure led_flash(byte in times, optional word in ms default 250,
    optional bit in invert default false) is
   var byte n
   for times using n loop
      if invert then
         led2 = ON
      else
         led1 = ON
      end if
      var word ms_left
      ms_left = ms
      while ms_left > 0 loop          -- note: delay semantics
         _usec_delay(1000)            -- ms x 1 ms units instead
         ms_left = ms_left - 1
      end loop
      led1 = OFF
      led2 = OFF
      _usec_delay(20_000)
   end loop
   r_lo = byte(times)          -- expose the inputs for the self-checks
   r_hi = byte(ms)
end procedure

-- volatile formal with a default
procedure report(optional byte in level default 7) is
   print_string(serial_data, "level=")
   print_byte_dec(serial_data, level)
   print_string(serial_data, "\r\n")
   r_lo = level
end procedure

-- open-array (string literal) default: COUNT() inside sees its length
procedure tag(optional byte in txt[] default "jal") is
   print_string(serial_data, "tag=")
   print_string(serial_data, txt)
   print_string(serial_data, " (len ")
   print_byte_dec(serial_data, byte(COUNT(txt)))
   print_string(serial_data, ")\r\n")
   r_hi = byte(COUNT(txt))
end procedure

var byte checks = 0

-- 5 s grace period: time to open a serial terminal after power-up
for 5 loop
   led1 = ON
   _usec_delay(80_000)
   led1 = OFF
   _usec_delay(920_000)
end loop

print_string(serial_data, "========================================\r\n")
print_string(serial_data, "jalv2 optional-params demo - PIC18F67J50\r\n")
print_string(serial_data, "boot: own boot init, SYSCLK 200 MHz, 115200 8N1\r\n")
print_string(serial_data, "========================================\r\n")

print_string(serial_data, "--- scalar defaults, every arity ---\r\n")
led_flash(2, 100, true)               -- full arity
if (r_lo == 2) & (r_hi == 100) then checks = checks + 1 end if
print_string(serial_data, "full arity:   ") ; print_byte_dec(serial_data, checks)
print_string(serial_data, " (r_lo/r_hi ok)\r\n")

led_flash(3, 90)                      -- omit the bit to default false
if (r_lo == 3) & (r_hi == 90) then checks = checks + 1 end if
print_string(serial_data, "word omitted default fills: ok\r\n")

led_flash(4)                          -- both defaults: 250 ms, false
if (r_lo == 4) & (r_hi == 250) then checks = checks + 1 end if
print_string(serial_data, "all omitted defaults fill: ok\r\n")

print_string(serial_data, "--- scalar byte default ---\r\n")
report()                              -- level = 7
if r_lo == 7 then checks = checks + 1 end if
report(9)                             -- explicit
if r_lo == 9 then checks = checks + 1 end if

print_string(serial_data, "--- open-array default ---\r\n")
tag()                                 -- "jal", len 3
if r_hi == 3 then checks = checks + 1 end if
tag("custom-tag")                     -- len 10
if r_hi == 10 then checks = checks + 1 end if

print_string(serial_data, "\r\nchecks passed: ")
print_byte_dec(serial_data, checks)
print_string(serial_data, " of 7\r\n")
print_string(serial_data, "Sample complete.\r\n")
print_string(serial_data, "##DONE##\r\n")

var byte seconds = 0
forever loop
   led1 = ON
   led2 = ON
   print_string(serial_data, "alive - ")
   print_byte_dec(serial_data, seconds)
   print_string(serial_data, " s\r\n")
   seconds = seconds + 1
   _usec_delay(100_000)
   led1 = OFF
   led2 = OFF
   _usec_delay(900_000)
end loop

