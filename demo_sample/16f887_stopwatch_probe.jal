-- Title: PIC16F887 stopwatch probe — classic midrange (14-bit) feature tour
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- This file is part of jallib (https://github.com/jallib/jallib)
-- Released under the BSD license (http://www.opensource.org/licenses/bsd-license.php)
--
-- Description: a timer-based timing probe on the classic midrange PIC16F887.
--              TMR0 runs from the instruction clock with a 1:256 prescaler;
--              the sample zeroes it, waits a known 2 ms with `_usec_delay`,
--              and prints the elapsed tick count.  At 8 MHz one instruction
--              cycle is 0.5 us, so 2 ms is 4000 cycles = ~15.6 ticks of the
--              1:256 prescaler.
--
--              Results are printed on the EUSART and mirrored on the LED
--              (LED on when the count is inside the expected window).
--

include 16f887                      -- target PICmicro
--
pragma target clock 8_000_000       -- oscillator frequency
pragma target OSC      INTOSC_NOCLKOUT
pragma target WDT      CONTROL
pragma target DEBUG    DISABLED
pragma target BROWNOUT DISABLED
pragma target FCMEN    DISABLED
pragma target IESO     DISABLED
pragma target LVP      DISABLED
pragma target MCLR     EXTERNAL
--
WDTCON_SWDTEN = OFF
OSCCON_SCS = 0
OSCCON_IRCF = 0b111
enable_digital_io()
_usec_delay(100_000)
--
alias led is pin_D0
pin_D0_direction = OUTPUT
--
const serial_hw_baudrate = 115200
include serial_hardware
serial_hw_init()
alias serial_write is serial_hw_write
alias serial_read is serial_hw_read
alias serial_data is serial_hw_data
alias serial_data_available is serial_hw_data_available
const PRINT_MAX_VAR_SIZE = 4
include print
include format
--
var byte ticks
var byte bad = 0
--
print_string(serial_data, "JALv2 PIC16F887: stopwatch probe\r\n")
--
-- TMR0: internal instruction clock, prescaler 1:256, no edge polarity
OPTION_REG_T0CS = 0
OPTION_REG_PSA  = 0                 -- prescaler to TMR0
OPTION_REG_PS   = 0b111             -- 1:256
--
forever loop
   TMR0 = 0
   _usec_delay(2000)                -- 2 ms
   ticks = TMR0
   --
   print_string(serial_data, "2 ms -> TMR0 ticks: ")
   print_byte_dec(serial_data, ticks)
   print_crlf(serial_data)
   --
   -- 4000 instruction cycles / 256 = 15.6 counts; accept a wide window for
   -- the delay routine's own overhead
   if (ticks >= 14) & (ticks <= 20) then
      led = ON
   else
      led = OFF
      bad = bad + 1
   end if
   _usec_delay(500_000)
end loop
