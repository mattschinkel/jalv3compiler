-- ============================================
-- PSEUDO-VARIABLE ARRAYS (large_array)
-- ============================================
-- Based on PSEUDO_ARRAY.md documentation

-- Normal multi-bank arrays (current compiler enhancement)
procedure test_normal_multi_bank_array is
    var byte normal_array[512]  -- OK: Allocated across multiple RAM banks
    normal_array[0] = 1
    normal_array[255] = 2
    normal_array[256] = 3
    normal_array[511] = 4
end procedure

-- Test large_array 'get function usage (actual code from demo_lib/large_array_6.jal)
-- From PSEUDO_ARRAY.md Step 3
-- Tests the 'get function via pseudo-variable syntax
procedure test_large_array_get_function_usage is
    -- Test usage: Read from address 100 (section 0) using pseudo-variable syntax
    -- User code: test_large_array[100]
    -- Compiler translates to: test_large_array'get(100)
    -- address = 100 = 0x0064
    -- address_lo = 0x64 = 100, address_hi = 0x00 = 0
    -- section = 0 → returns _test_large_array_1_01[100]
    var byte result1
    result1 = test_large_array[100]
    
    -- Test usage: Read from address 300 (section 1) using pseudo-variable syntax
    -- User code: test_large_array[300]
    -- Compiler translates to: test_large_array'get(300)
    -- address = 300 = 0x012C
    -- address_lo = 0x2C = 44, address_hi = 0x01 = 1
    -- section = 1 → returns _test_large_array_1_00[44]
    var byte result2
    result2 = test_large_array[300]
end procedure

-- Test large_array 'put procedure usage (actual code from demo_lib/large_array_6.jal)
-- From PSEUDO_ARRAY.md Step 4
-- Tests the 'put procedure via pseudo-variable syntax
procedure test_large_array_put_procedure_usage is
    -- Test usage: Write to address 100 (section 0) using pseudo-variable syntax
    -- User code: test_large_array[100] = 0xAA
    -- Compiler translates to: test_large_array'put(100, 0xAA)
    -- address = 100 = 0x0064
    -- address_lo = 0x64 = 100, address_hi = 0x00 = 0
    -- section = 0 → executes case 00: _test_large_array_1_01[100] = 0xAA
    test_large_array[100] = 0xAA
    
    -- Test usage: Write to address 300 (section 1) using pseudo-variable syntax
    -- User code: test_large_array[300] = 0x42
    -- Compiler translates to: test_large_array'put(300, 0x42)
    -- address = 300 = 0x012C
    -- address_lo = 0x2C = 44, address_hi = 0x01 = 1
    -- section = 1 → executes case 01: _test_large_array_1_00[44] = 0x42
    test_large_array[300] = 0x42
end procedure

-- Test large_array library usage (pseudo-variable syntax)
-- Note: This demonstrates how the library would be used, but library may not be available
procedure test_large_array_usage is
    -- Example: How large_array_6 library would be used
    -- const LARGE_ARRAY_6_SIZE = 512
    -- const LARGE_ARRAY_6_VARIABLE_SIZE = 1
    -- include large_array_6
    -- alias sd_sector_buffer is large_array_6
    --
    -- Example 1: Write to address 100 (section 0)
    -- User code: sd_sector_buffer[100] = 0xAA
    -- Compiler translates to: large_array_6'put(100, 0xAA)
    -- Function executes: section = 0 → _large_array_6_1_01[100] = 0xAA
    --
    -- Example 2: Write to address 300 (section 1)
    -- User code: sd_sector_buffer[300] = 0x42
    -- Compiler translates to: large_array_6'put(300, 0x42)
    -- Function executes: section = 1 → _large_array_6_1_00[44] = 0x42
    --
    -- Example 3: Read from address 100
    -- User code: var byte val = sd_sector_buffer[100]
    -- Compiler translates to: val = large_array_6'get(100)
    
    -- Use our test_large_array instead for actual testing
    test_large_array[100] = 0xAA
    test_large_array[300] = 0x42
    var byte val
    val = test_large_array[100]
end procedure

-- Custom dual-array approach (PATA style)
procedure test_custom_dual_array is
    var byte buffer_low[256]
    var byte buffer_high[256]
    
    function custom_buffer'get(word in address) return byte is
        pragma inline
        if bit(address) == 0 then
            return buffer_low[address / 2]
        else
            return buffer_high[address / 2]
        end if
    end function
    
    procedure custom_buffer'put(word in address, byte in data) is
        pragma inline
        if bit(address) == 0 then
            buffer_low[address / 2] = data
        else
            buffer_high[address / 2] = data
        end if
    end procedure
    
    -- Usage
    custom_buffer[0] = 0xAA
    custom_buffer[1] = 0xBB
    var byte val = custom_buffer[2]
end procedure

