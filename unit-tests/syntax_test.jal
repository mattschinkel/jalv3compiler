    record Point is
        word x
        word y
    end record
    
    var Point points[3] = {
        {10, 20},
        {30, 40},
        {50, 60}
    }
    points[0].x = 11
    points[1].y = points[2].x
    
    record Config is
        byte mode
        word timeout
    end record
    
    var Config configs[2] = {
        {1, 1000},
        {2, 2000}
    }
end procedure

-- ============================================
-- NESTED RECORDS
-- ============================================
procedure test_nested_records is
    record Inner is
        byte value
    end record
    
    record Outer is
        Inner inner
        byte extra
    end record
    
    var Outer outer_var
    outer_var.inner.value = 10
    outer_var.extra = 20
    
    record Complex is
        Inner data[3]
        byte count
    end record
    
    var Complex complex_var = {
        {{1}, {2}, {3}},
        3
    }
    complex_var.data[1].value = 4
    counter = complex_var.data[2].value
end procedure

-- ============================================
-- FOR WITH ROLLOVER (256 USING byte)
-- ============================================
procedure test_for_rollover is
    var byte n
    for 256 using n loop
        counter = counter + 1
    end loop
    -- On exit, n will be zero due to rollover
end procedure

