procedure test_messages is
    _debug "Debug message here"
    _error "Error message here"
    _warn "Warning message here"
    
    if !defined(undefined_var) then
        _warn "undefined_var is not defined"
    end if
end procedure

-- ============================================
-- PSEUDO-VARIABLES
-- ============================================
-- Note: PORTA'get and PORTA'put may already be defined by device file
-- Using a different name to avoid conflicts
var byte my_port_shadow

function my_port'get return byte is
    return my_port_shadow
end function

procedure my_port'put(byte in value) is
    my_port_shadow = value
end procedure

-- Bit-level pseudo-variables (JALv2 syntax)
-- Note: Bit access syntax in return statements may be limited
function my_pin'get return bit is
    var bit result at my_port_shadow : 0
    return result
end function

procedure my_pin'put(bit in value) is
    var bit bit0 at my_port_shadow : 0
    bit0 = value  -- Assign bit value
end procedure

-- ============================================
-- PROCEDURES WITH ARRAY PARAMETERS
-- ============================================
procedure fixed_array_param(byte in str[5]) is
    var byte i
    for 5 using i loop
        counter = str[i]
    end loop
end procedure

procedure flexible_array_param(byte in str[]) is
    var byte i
    var word size = COUNT(str)
    var word size_preferred = COUNT(str)
    var byte scalar_bytes = COUNT(counter)
    counter = scalar_bytes
    counter = byte(size_preferred)
    for size using i loop
        counter = str[i]
    end loop
end procedure

-- ============================================
-- VOLATILE PARAMETERS
-- ============================================
procedure serial_write(VOLATILE byte IN OUT port_var) is
    port_var = "A"
    port_var = "B"
    port_var = "C"
end procedure

procedure read_adc(VOLATILE byte IN channel, byte OUT result) is
    result = channel + 10
end procedure

-- ============================================
-- NESTED PROCEDURES/FUNCTIONS
-- ============================================
procedure outer_proc is
    var byte outer_var = 10
    
    procedure inner_proc is
        var byte inner_var = 20
        outer_var = inner_var
    end procedure
    
    function inner_func(byte in x) return byte is
        return x + outer_var
    end function
    
    inner_proc()
    counter = inner_func(5)
end procedure

-- ============================================
-- IF 0 (BLOCK COMMENTS)
-- ============================================
procedure test_if_zero is
    if FALSE then
        -- this is a block comment
        -- that won't be parsed
        procedure fake_proc is
            var byte fake_var
        end procedure
    end if
end procedure

-- ============================================
-- STRING LITERALS WITH ESCAPE SEQUENCES
-- ============================================
procedure test_string_escapes is
    -- String literal NUL termination
    -- Documentation: "a string literal terminates with the first NUL characters (0x00)"
    var byte str_nul[] = "Hello\0World"  -- Terminates at \0, so only "Hello" is stored
    var byte str_nul2[] = "Test\x00End"  -- Also terminates at \x00
    
    var byte str1[] = "Hello\nWorld"
    var byte str2[] = "Tab\tHere"
    var byte str3[] = "Bell\aBackspace\b"
    var byte str4[] = "Formfeed\fCarriage\r"
    var byte str5[] = "Vertical\vTab"
    var byte str6[] = "Octal\123Hex\xFF"
    var byte str7[] = "Binary\z1010"
    var byte str8[] = "Quote\q123"
    var byte str9[] = "Backslash\\"
    var byte ch1 = "\n"
    var byte ch2 = "\x41"
    var byte ch3 = "\123"
end procedure

-- ============================================
-- ASSEMBLY - LOCAL LABELS
-- ============================================
procedure test_assembly_local is
    assembler
        local loop_start, loop_end
        loop_start:
            movlw 0x10
            movwf counter
            nop
        loop_end:
            goto loop_start
    end assembler
end procedure

-- ============================================
-- ASSEMBLY - BANK AND PAGE DIRECTIVES
-- ============================================
procedure test_assembly_bank_page is
    assembler
        local loop_label
        bank PORTA
        movf PORTA, w
        -- page loop_label  -- PAGE has no meaning on 16-bit cores
        goto loop_label
        loop_label:
            nop
    end assembler
end procedure

-- ============================================
-- PRAGMA KEEP PAGE/BANK
-- ============================================
procedure test_pragma_keep is
    pragma keep page
    pragma keep bank
    var byte test_var
    test_var = 10
end procedure

-- PRAGMA KEEP in procedures (test that it works inside procedures)
procedure test_keep_in_procedure is
    pragma keep page
    pragma keep bank
    assembler
        movlw 0x10
        movwf counter
    end assembler
end procedure

-- ============================================
-- ASSEMBLY DATA DIRECTIVES
-- ============================================
procedure test_assembly_data is
    assembler
        -- Note: Data directives may have different syntax or may not be supported
        -- dblist 1, 2, 3, 4, 5
        -- dwlist 100, 200, 300
        -- dslist 65, 66, 67
        nop
    end assembler
end procedure

-- ============================================
