procedure test_initializers is
    var byte arr1[5] = {1, 2, 3, 4, 5}
    var byte arr2[3] = {10, 20, 30}
    var byte arr3[5] = "Hello"
    -- var byte matrix[2][3] = {  -- JALv2 doesn't support multi-dimensional arrays
    --     {1, 2, 3},
    --     {4, 5, 6}
    -- }
end procedure

-- ============================================
-- NESTED STRUCTURES
-- ============================================
procedure test_nested is
    var byte i
    if counter > 10 then
        while flag loop
            for 6 using i loop
                if i == 3 then
                    exit loop
                end if
            end loop
        end loop
    else
        case counter of
            0: flag = low
            otherwise
                flag = high
        end case
    end if
end procedure

-- ============================================
-- RECORD USAGE
-- ============================================
procedure test_records is
    var Point p1, p2
    var word field_address
    p1.x = 10
    p1.y = 20
    p2 = p1
    field_address = whereis(p1.y)
end procedure

-- ============================================
-- PRAGMA IN PROCEDURES
-- ============================================
procedure interrupt_handler is
    pragma interrupt
    counter = counter + 1
end procedure

procedure inline_proc is
    pragma inline
    counter = counter + 1
end procedure

-- PRAGMA INTERRUPT FAST (assembly only)
procedure fast_interrupt_handler is
    pragma interrupt fast
    -- FAST interrupt handlers can only use assembly, not JAL statements
    asm nop
end procedure

-- ============================================
-- EDGE CASES
-- ============================================
procedure test_edge_cases is
    -- Empty procedure
    procedure empty_proc is
    end procedure
    
    -- Single statement
    procedure single_stmt is
        counter = 0
    end procedure
    
    -- Multiple declarations
    var byte a, b, c
    var word x = 100, y = 200, z = 300
    
    -- Chained assignments (JALv2 doesn't support chained assignments)
    a = 0
    b = 0
    c = 0
    
    -- Complex array indexing (JALv2 doesn't support multi-dimensional arrays)
    var byte arr[50]  -- 10*5 = 50 elements
    arr[0] = 1
    arr[counter + 1] = 2
end procedure

-- ============================================
-- TYPE MULTIPLIERS (BIT*cexpr, BYTE*cexpr)
-- ============================================
procedure test_type_multipliers is
    var bit*2 two_bit_field
    var byte*3 three_byte_value
    
    -- BIT*cexpr vs BYTE*cexpr distinction
    -- Documentation: "BIT*24 is not the same as BYTE*3"
    var bit*24 bit_field_24  -- NOT the same as BYTE*3
    var byte*3 byte_field_3  -- Different from BIT*24
    bit_field_24 = 0x123456
    byte_field_3 = 0x123456
    var byte*24 large_value
    var sbyte*2 signed_two_byte
    two_bit_field = 3
    three_byte_value = 0x123456
end procedure

-- ============================================
-- VARIABLES WITH IS (deprecated alias syntax)
-- ============================================
procedure test_is_var is
    var byte original
    var byte alias_var is original
end procedure

-- ============================================
-- ASSERT STATEMENT
-- ============================================
procedure test_assert is
    assert counter > 0
    assert flag
    assert (counter + 10) < 100
end procedure

-- ============================================
-- MESSAGE GENERATING (_DEBUG, _ERROR, _WARN)
