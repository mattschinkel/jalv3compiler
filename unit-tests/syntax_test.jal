-- large_array segment access patterns
-- Shows how 'get/'put functions handle different segments
procedure test_large_array_access is
    const LARGE_ARRAY_5_SIZE = 1024
    const LARGE_ARRAY_5_VARIABLE_SIZE = 1
    include large_array_5
    alias large_buffer is large_array_5
    
    var word idx  -- Changed to word to handle values up to 1023
    -- Access different segments (compiler translates to 'get/'put calls)
    -- Example: large_buffer[100] = 0x42
    --   address = 100 = 0x0064
    --   address_lo = 0x64 = 100, address_hi = 0x00 = 0
    --   section = 0 → _large_array_5_1_01[100] = 0x42
    
    -- Example: large_buffer[300] = 0xAA
    --   address = 300 = 0x012C
    --   address_lo = 0x2C = 44, address_hi = 0x01 = 1
    --   section = 1 → _large_array_5_1_00[44] = 0xAA
    
    large_buffer[0] = 1      -- Section 0, offset 0
    large_buffer[255] = 2    -- Section 0, offset 255
    large_buffer[256] = 3    -- Section 1, offset 0
    large_buffer[511] = 4   -- Section 1, offset 255
    large_buffer[512] = 5    -- Section 2, offset 0
    large_buffer[1023] = 6   -- Section 3, offset 255
    
    -- Loop example (using word for idx to handle 256 iterations safely)
    for 256 using idx loop
        large_buffer[idx] = BYTE(idx)
    end loop
end procedure

-- PATA-style fast read pattern
procedure test_pata_fast_read is
    var byte buffer_low[256]
    var byte buffer_high[256]
    
    -- Read word 0 (bytes 0 and 1) simultaneously
    buffer_low[0] = 0xAA
    buffer_high[0] = 0xBB
    
    -- Read word 1 (bytes 2 and 3)
    buffer_low[1] = 0xCC
    buffer_high[1] = 0xDD
end procedure

