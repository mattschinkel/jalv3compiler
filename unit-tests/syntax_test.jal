-- syntax_test.jal
-- Comprehensive JAL syntax test file
-- Tests all grammar features to ensure parser works correctly
-- Author: Matthew Schinkel

include 18f67j50                     -- target PICmicro
--
-- This program assumes that a 20 MHz resonator or crystal
-- is connected to pins OSC1 and OSC2.
pragma target clock 20_000_000      -- oscillator frequency
--
pragma target OSC      HS                        -- crystal or resonator
pragma target PLLDIV   P1                        -- clock postscaler
pragma target CPUDIV   P1                        -- Fosc divisor
pragma target WDT      CONTROL                   -- watchdog
pragma target XINST    DISABLED                  -- do not use extended instructionset
pragma target DEBUG    DISABLED                  -- no debugging
pragma target FCMEN    DISABLED                  -- no clock monitoring
pragma target IESO     DISABLED                  -- no int/ext osc switching
--
-- The configuration bit settings above are only a selection, sufficient
-- for this program. Other programs may need more or different settings.
--
WDTCON_SWDTEN = OFF                 -- disable WDT
OSCCON_SCS = 0                      -- select primary oscillator
OSCTUNE_PLLEN = FALSE               -- no PLL
--
enable_digital_io()                 -- make all pins digital I/O
_usec_delay (100_000) -- wait for power to stablilize

-- ============================================
-- INCLUDES
-- ============================================
-- include board_16f877_dwarf  -- commented out, file not found

-- ============================================
-- CONSTANTS
-- ============================================
const byte MAX_COUNT = 100
const word TIMEOUT = 5000
const byte MESSAGE[] = "Hello World"
const byte ARRAY[] = {1, 2, 3, 4, 5}
const byte OCTAL_VAL = 0q12  -- Octal constant (0q prefix)
const byte OCTAL_MAX = 0q77  -- Octal 77 = decimal 63
const byte MULTI[] = {
    1, 2, 3,
    4, 5, 6
}
const byte name = 42
const byte value = 100

-- ============================================
-- VARIABLES - Basic Types
-- ============================================
var byte counter = 0
var word timer_value
var bit flag = 0
-- var sbit status_bit at PORTA : 0  -- SBIT: 1-bit signed value (-1..0) - may need initialization
-- var sbyte signed_value  -- JALv2 doesn't support sbyte initialization
-- var sword signed_word  -- JALv2 doesn't support sword initialization
-- var dword large_value  -- JALv2 doesn't support dword initialization
-- var sdword signed_large = -1000000  -- JALv2 doesn't support negative initialization
-- var float pi  -- JALv2 may not support float type
-- var pointer ptr  -- JALv2 doesn't support pointer type

-- ============================================
-- VARIABLES - Arrays
-- ============================================
var byte buffer[10]
var byte data[3] = {1, 2, 3}
var word values[5] = {100, 200, 300, 400, 500}
var string[8] fixed_string = "syntax"
-- Array with empty dimensions - size determined by initializers
-- Documentation: "If cexpr is omitted, the '=' term must exist and the size
-- of the array will be set to the number of initializers present."
var byte auto_size[] = {10, 20, 30, 40}  -- Size automatically set to 4
var byte auto_str[] = "Auto"  -- Size automatically set to 4
-- var byte matrix[3][4]  -- JALv2 doesn't support multi-dimensional arrays

-- ============================================
-- VARIABLES - With Modifiers
-- ============================================
var volatile byte status_reg
-- var shared byte global_var  -- JALv2 requires initialization or different syntax
var byte global_var
var volatile byte shared_status

-- ============================================
-- VARIABLES - With AT Clauses
-- ============================================
var byte port_a at 0x05
var bit led at PORTA : 0
-- var byte bank0 at 0x20 : 0x7F  -- JALv2 doesn't support range syntax
var byte bank0 at 0x20
var byte regs at {0x20, 0x21, 0x22}
-- AT var [':bit] - Place variable at same location as another variable
var byte port_a_copy at port_a  -- Same location as port_a
var bit led_copy at PORTA : 1   -- Same location as PORTA, different bit

-- ============================================
-- ALIASES
-- ============================================
alias led_output is PORTA
-- alias serial_out is serial_hw_data  -- serial_hw_data not defined
alias counter_alias is counter

-- ============================================
-- RECORDS
-- ============================================
record Point is
    word x
    word y
end record

record Config is
    byte mode
    word timeout
    bit enabled
end record

-- ============================================
-- PROCEDURES - Basic
-- ============================================
procedure test_procedure is
    var byte local_var = 10
    counter = counter + 1
end procedure

procedure one_line_procedure is end procedure

-- ============================================
-- PROCEDURES - With Parameters
-- ============================================
procedure set_value(byte in value) is
    counter = value
end procedure

procedure swap(byte in a, byte in b) is
    var byte temp
    temp = a
    -- Note: JALv2 doesn't support inout, so this is just a test of parameter syntax
end procedure

procedure complex_params(
    byte in input_val,
    word out result,
    byte in buffer
) is
    result = input_val * 2
    -- Note: JALv2 doesn't support inout, so buffer modification removed
end procedure

-- ============================================
-- FUNCTIONS
-- ============================================
function get_count return byte is
    return counter
end function

function add(byte in a, byte in b) return byte is
    return a + b
end function

function compute(word in x, word in y) return word is
    var word result
    result = x * y + 10
    return result
end function

-- ============================================
-- RECURSION
-- ============================================
-- Documentation: "Recursion is fully supported but due to the overhead it is discouraged."
function factorial(byte in n) return word is
    if n <= 1 then
        return 1
    else
        return n * factorial(n - 1)
    end if
end function

function fibonacci(byte in n) return word is
    if n <= 1 then
        return n
    else
        return fibonacci(n - 1) + fibonacci(n - 2)
    end if
end function

procedure test_recursion is
    var word fact_result
    var word fib_result
    fact_result = factorial(5)
    fib_result = fibonacci(6)
end procedure

-- ============================================
-- PROCEDURE/FUNCTION PROTOTYPES
-- ============================================
procedure forward_decl(byte in x)
function forward_func(byte in x) return byte

-- ============================================
-- LARGE ARRAY 'GET/'PUT FUNCTION SYNTAX TESTS
-- ============================================
-- Based on PSEUDO_ARRAY.md Step 3 and Step 4
-- These demonstrate the actual syntax used in large_array_6 library

-- Simulate internal arrays (library creates these)
var byte*1 _test_large_array_1_00[256]  -- Segment 0 (bytes 256-511)
var byte*1 _test_large_array_1_01[256]  -- Segment 1 (bytes 0-255)
const TEST_LARGE_ARRAY_SIZE = 512

-- Test 'get function syntax (actual code from demo_lib/large_array_6.jal)
-- From PSEUDO_ARRAY.md Step 3
function test_large_array'get(word in address) return byte*1 is
   var byte address_lo at address      -- Low byte of address (0-255)
   var byte address_hi at address+1    -- High byte of address (segment number)
   var byte section at address_hi      -- section = segment number
   
   -- For 512-byte array (TEST_LARGE_ARRAY_SIZE <= 512)
   if TEST_LARGE_ARRAY_SIZE <= 512 then
   case section of
         00: return _test_large_array_1_01[address_lo]  -- Section 0: bytes 0-255
         01: return _test_large_array_1_00[address_lo]  -- Section 1: bytes 256-511
   end case
   end if
   -- Larger sizes have additional elsif blocks for more segments
end function

-- Test 'put procedure syntax (actual code from demo_lib/large_array_6.jal)
-- From PSEUDO_ARRAY.md Step 4
procedure test_large_array'put(word in address, byte*1 in data) is
   var byte address_lo at address+0    -- Low byte of address (0-255)
   var byte address_hi at address+1    -- High byte of address (segment number)
   var byte section at address_hi      -- section = segment number
   
   -- For 512-byte array (TEST_LARGE_ARRAY_SIZE <= 512)
   if TEST_LARGE_ARRAY_SIZE <= 512 then
   case section of
         00: _test_large_array_1_01[address_lo] = data  -- Section 0: bytes 0-255
         01: _test_large_array_1_00[address_lo] = data  -- Section 1: bytes 256-511
   end case
   end if
   -- Larger sizes have additional elsif blocks for more segments
end procedure

-- ============================================
-- IF STATEMENTS
-- ============================================
procedure test_if is
    if counter > 10 then
        flag = high
    end if
    
    if counter > 10 then
        flag = high
    else
        flag = low
    end if
    
    if counter > 100 then
        flag = high
    elsif counter > 50 then
        flag = low
    else
        flag = low
    end if
end procedure

-- ============================================
-- WHILE LOOPS
-- ============================================
procedure test_while is
    while counter < 100 loop
        counter = counter + 1
    end loop
end procedure

-- ============================================
-- REPEAT LOOPS
-- ============================================
procedure test_repeat is
    repeat
        counter = counter + 1
    until counter > 100
    
    -- JALv2 doesn't support 'end repeat', only 'until'
end procedure

-- ============================================
-- FOR LOOPS
-- ============================================
procedure test_for is
    var byte i
    for 10 using counter loop
        flag = high
    end loop
    
    for 10 loop
        counter = counter + 1
    end loop
    
    for 10 using i loop
        flag = high
    end loop
    
    -- FOR loop rollover behavior (November 2010 enhancement)
    -- If expr is a cexpr and is one larger than var can hold,
    -- the loop exits when var rolls over to zero
    var byte n
    for 256 using n loop
        -- loop body
        counter = counter + 1
    end loop
    -- On exit, n will be zero (rollover behavior)
end procedure

-- ============================================
-- FOREVER LOOPS
-- ============================================
procedure test_forever is
    forever loop
        counter = counter + 1
        if counter > 100 then
            exit loop
        end if
    end loop
end procedure

-- ============================================
-- CASE STATEMENTS
-- ============================================
procedure test_case is
    case counter of
        0: flag = low
        1, 2, 3: flag = high
        10: counter = 0
        otherwise
            flag = low
    end case
end procedure

-- ============================================
-- BLOCK STATEMENTS
-- ============================================
procedure test_block is
    block
        var byte block_var = 5
        counter = block_var
    end block
end procedure

-- ============================================
-- ASSEMBLY STATEMENTS
-- ============================================
procedure test_asm is
    asm nop
    asm sleep
    asm movlw 0x10
    asm movwf counter
end procedure

procedure test_assembler is
    assembler
        movlw 0x10
        movwf counter
        nop
    end assembler
end procedure

-- ============================================
-- EXPRESSIONS
-- ============================================
procedure test_expressions is
    var byte a, b, c
    var word w1, w2
    
    -- Arithmetic
    a = 10 + 20
    b = 100 - 50
    c = 5 * 6
    a = 100 / 10
    b = 17 % 5
    
    -- Bitwise
    a = b & c
    a = b | c
    a = b ^ c
    a = !b
    a = !!b
    
    -- Shift
    a = b << 2
    a = b >> 1
    
    -- Comparison
    if a == b then
        flag = high
    end if
    if a != b then
        flag = low
    end if
    if a < b then
        flag = high
    end if
    if a <= b then
        flag = high
    end if
    if a > b then
        flag = low
    end if
    if a >= b then
        flag = low
    end if
    
    -- Logical (use !! for logical operations, not bitwise)
    if !!(a & b) then
        flag = high
    end if
    if !!(a | b) then
        flag = high
    end if
    if !!(a ^ b) then
        flag = high
    end if
    
    -- Complex expressions
    a = (b + c) * 2
    w1 = word(a) * 10
    -- COUNT(buffer) returns an element count; scalar COUNT() returns byte length.
    flag = defined(counter)
    w1 = whereis(buffer)
    
    -- Division result and remainder optimization
    -- Documentation: "The compiler keeps track of the last operation, so if you find
    -- yourself needing both the division result and the remainder of a certain operation,
    -- make sure to put the assignments close together, thus saving a function call"
    var word x = 123
    var word n, r
    n = x / 10  -- Division
    r = x % 10  -- Remainder (uses same division call as above)
    
    -- WHEREIS with different identifier types
    -- Documentation: WHEREIS returns different values for:
    -- - Procedure/function: CODE address of entry point
    -- - Assembly label: CODE address of label
    -- - Variable: DATA address
    -- - Constant array: CODE address (16-bit) or lookup function (non-16-bit)
    w1 = whereis(test_procedure)  -- Procedure: CODE address
    w1 = whereis(get_count)       -- Function: CODE address
    w1 = whereis(counter)         -- Variable: DATA address
    w1 = whereis(buffer[1])       -- Array element: DATA address plus constant offset
    w1 = whereis(ARRAY)           -- Constant array: CODE address or lookup function
end procedure

-- ============================================
-- ARRAY OPERATIONS
-- ============================================
procedure test_arrays is
    var byte arr[10]
    var byte matrix[2][3]
    var byte cube[2][2][2]
    var byte val
    
    val = arr[0]
    arr[5] = 42
    arr[counter] = val
    val = arr[counter + 1]
    matrix[1][2] = 7
    val = matrix[1][2]
    cube[1][0][1] = val
    val = cube[1][0][1]
end procedure

-- ============================================
-- FUNCTION/PROCEDURE CALLS
-- ============================================
procedure test_calls is
    test_procedure()
    set_value(10)
    var byte temp_counter
    temp_counter = BYTE(timer_value)
    swap(counter, temp_counter)  -- Fixed: swap expects byte parameters
    var byte result
    result = get_count()
    result = add(5, 10)
    var word word_result
    word_result = compute(100, 200)  -- Fixed: compute returns word
end procedure

-- ============================================
-- RETURN STATEMENTS
-- ============================================
function test_return return byte is
    if counter > 10 then
        return 0
    end if
    return counter
end function

procedure test_return_void is
    if counter > 100 then
        return
    end if
    counter = counter + 1
end procedure

-- ============================================
-- EXIT STATEMENTS
-- ============================================
procedure test_exit is
    forever loop
        counter = counter + 1
        if counter > 100 then
            exit loop
        end if
    end loop
end procedure

-- ============================================
-- TASKS
-- ============================================
task blink_task is
    forever loop
        led = high
        -- delay_ms(100)  -- delay_ms not included
        led = low
        -- delay_ms(100)  -- delay_ms not included
    end loop
end task

var byte task_loop_count = 0

task worker(byte in id) is
    -- var byte loop_count = 0  -- variables cannot be declared inside a task body
    while task_loop_count != 10 loop
        task_loop_count = task_loop_count + 1
        _task_yield
    end loop
end task

-- ============================================
-- TASK CONTROL
-- ============================================
procedure test_tasks is
    -- start blink_task  -- START can only be used in main program
    -- start worker(1)  -- START can only be used in main program
    -- _task_yield  -- _task_yield can only be used in a TASK
    -- sleep  -- sleep not defined
end procedure

