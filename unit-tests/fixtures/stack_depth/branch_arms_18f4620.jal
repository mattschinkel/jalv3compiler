-- Title: stack-depth CFG probe -- the branch shape on a PIC18 part (31-level stack, rcall emitter)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
--
-- Pins the PIC hardware-stack-depth walker (src/libpic12/pic_stk.c) on a
-- synthetic control-flow shape. Compiled by
-- unit-tests/test_stack_depth_cfg.sh with -s demo_lib;third_party/jallib/lib;sims/shared.
-- The expected depth was cross-checked against the emitted .asm call nesting.

include regression_18f4620_device
var volatile byte v1
var volatile byte v2
procedure q3() is
   v2 = 3
end procedure
procedure q2() is
   q3()
   v2 = 2
end procedure
procedure q1() is
   v2 = 1
end procedure
if v1 then
   q2()
else
   q1()
end if
forever loop
end loop
