include regression_32mz1024efh064_device
var volatile byte va
var volatile byte vb
var volatile byte vc
var volatile byte vd
var volatile byte ve
var volatile byte vf
var volatile byte vg
var volatile byte vh
var volatile byte vi
va = 20
vb = 6
vc = va + vb
vd = va - vb
ve = va * vb
vf = va / vb
vg = va % vb
vh = va << 2
vi = va & vb
