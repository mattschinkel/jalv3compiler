-- expect byte v__bd_r_word_shift 1
-- expect byte v__bd_r_sword_edge 1
-- expect byte v__bd_r_dword_edge 1
-- expect byte v__bd_r_sdword_edge 1
-- expect byte v__bd_r_cmp 1
-- expect byte v__bd_r_cast 1
-- expect byte v__bd_r_incdec 1
-- expect byte v__bd_r_fold_div 1
-- @sim_validate end
--
-- ----------------------------------------------------------------------------

