--
-- @sim_validate begin
-- duration_s: 0.5
-- machine: pic32mz-explorer16
-- expect byte v_ha 10
-- expect byte v_hb 20
-- expect byte v_hc 5
-- expect byte v_ra 5
-- expect byte v_rb 5
-- @sim_validate end

include regression_32mz1024efh064_device
var volatile byte ha = 0
var volatile byte hb = 0
var volatile byte hc = 5
var pointer p as var byte
var volatile byte ra = 0
var volatile byte rb = 0

p is ha
p = 10

p is hb
p = 20

p is hc
ra = p

var pointer q as var byte
q is ra
rb = q
