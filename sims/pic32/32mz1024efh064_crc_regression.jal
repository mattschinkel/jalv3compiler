-- duration_s: 1.0
-- machine: pic32mz-explorer16
-- expect byte v__check_step 6
-- expect byte v__crc_r_msg9 1
-- expect byte v__crc_r_msg1 1
-- expect byte v__crc_r_msg5 1
-- expect byte v__crc_r_msg03 1
-- expect byte v__crc_r_incr 1
-- expect byte v__crc_r_sort 1
-- @sim_validate end
--
-- ----------------------------------------------------------------------------

include regression_32mz1024efh064_device
include regression_pic32

include _regression_crc_body
