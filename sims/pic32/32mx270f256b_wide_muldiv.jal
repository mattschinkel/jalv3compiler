-- ------------------------------------------------------
-- Title: PIC32MX270F256B @sim_validate — wide muldiv
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    PIC32 review: multi-word qword * / % (no 32-bit fallback)
--
-- Notes:
--    ./bin/jalv3-x86-64 -s 'lib;tests' tests/pic32/32mx270f256b_wide_muldiv.jal
--
-- @sim_validate begin
-- duration_s: 1.0
-- machine: pic32mx7-explorer16
-- expect byte v_ra 1
-- expect byte v_rb 1
-- expect byte v_rc 1
-- expect byte v_rd 1
-- expect byte v_re 1
-- expect byte v_rf 1
-- @sim_validate end

include regression_32mx270f256b_device
var volatile byte ra = 0
var volatile byte rb = 0
var volatile byte rc = 0
var volatile byte rd = 0
var volatile byte re = 0
var volatile byte rf = 0

var volatile qword qa = 0
var volatile qword qb = 0
var volatile qword qc = 0
var volatile sqword sa = 0
var volatile sqword sb = 0
var volatile sqword sc = 0

qa = 0x0000000100000001
qb = 3
qc = qa * qb
if byte(qc) == 3 then
   ra = 1
end if
if byte(qc >> 32) == 3 then
   rb = 1
end if

qa = 0x0000000100000000
qb = 2
qc = qa / qb
if byte(qc >> 24) == 0x80 then
   rc = 1
end if
qc = qa % qb
if qc == 0 then
   rd = 1
end if

sa = -8
sb = 3
sc = sa / sb
if sc == -2 then
   re = 1
end if
sc = sa % sb
if sc == -2 then
   rf = 1
end if
