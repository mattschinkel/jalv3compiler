-- machine: pic32mz-explorer16
-- expect byte v__check_step 4
-- expect byte v__mdw_grid_ok 1
-- expect byte v__mdw_const_ok 1
-- expect byte v__mdw_run_ok 1
-- expect byte v__mdw_word_ok 1
-- @sim_validate end
--
include regression_32mz1024efh064_device
include regression_pic32
include _regression_multidim_wide_body
