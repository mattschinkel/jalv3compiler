include regression_32mx270f256b_device
var volatile byte ra = 0
var volatile byte rb = 0
var volatile byte rc = 0
var volatile byte matrix[2][3] = {{1, 2, 3}, {4, 5, 6}}
var volatile byte row = 1
var volatile byte col = 2

ra = matrix[0][0]
matrix[1][2] = 42
rb = matrix[1][2]
rc = matrix[row][col]
