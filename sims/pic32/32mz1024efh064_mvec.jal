-- ------------------------------------------------------
-- Title: PIC32MZ1024EFH064 @sim_validate — mvec
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    PIC32: OFFx MVEC stub + IRQ 0 (QEMU still hits 0xBFC00400)
--
-- Notes:
--    ./bin/jalv3-x86-64 -s 'lib;tests' tests/pic32/32mz1024efh064_mvec.jal
--
-- @sim_validate begin
-- duration_s: 0.5
-- machine: pic32mz-explorer16
-- expect byte v_ra 1
-- expect byte v_rb 2
-- @sim_validate end

include regression_32mz1024efh064_device
pragma interrupt mvec


var volatile byte ra = 0
var volatile byte rb = 0

--------------------------------------------------------------------------------
-- Description: IRQ0 handler with an OFFx stub (MVEC)
-- Parameters: none
-- Returns: none
-- Notes: Clears IFS0 bit 0 so ERET does not re-enter. QEMU VEIC spacing
-- - is 0 so the default EIC stub still runs; OFFx is programmed for HW.
--------------------------------------------------------------------------------
procedure _ct_isr() is
   pragma interrupt 0

   IFS0CLR = 1
   ra = ra + 1
end procedure

IPC0 = 0x1C
IEC0SET = 1
rb = 1
IFS0SET = 1
while ra == 0 loop
end loop
if ra == 1 then
   rb = 2
end if
