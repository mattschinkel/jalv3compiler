-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness — an ISR local array larger than one bank
--    window (chunked ISR object)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    An ISR local larger than one bank window used to be refused (the ISR
--    frame is one contiguous run).  A3 increment 3 defers such an object to
--    the group/chunk placement: it is split across windows and its runtime
--    subscripts walk the chunk map.  The walk state is saved/restored at the
--    ISR boundary (fixes/fix_isr_walk_state.md), so the ISR can walk while
--    the main line is mid-walk.
--
--    The handler fills `line[160]` on each of three INT0 edges and XORs the
--    bytes back: XOR 0..159 is 0, so any wrong element shows up as a
--    non-zero checksum.  Main checks the count, the flag and the checkpoint.
--
-- @picsim_validate begin
--
-- steps: 600000
-- expect byte v__check_step 3
-- expect byte v__isr_cnt 3
-- expect byte v__ok 1
-- expect byte v__gpsim_regression_flags 0
--
-- @picsim_validate end
-- ----------------------------------------------------------------------------

include regression_16f18857_device
include regression

var volatile byte _ok = 1
var volatile byte _isr_cnt = 0

procedure _int0_isr() is
   pragma interrupt
   var byte line[160]
   var byte i
   var byte s

   if !PIR0_INTF then
      return
   end if
   PIR0_INTF = off

   for 160 using i loop
      line[i] = i
   end loop

   s = 0
   i = 0
   while i < 160 loop
      s = s ^ line[i]
      i = i + 1
   end loop
   if s != 0 then
      _ok = 0
   end if

   _isr_cnt = _isr_cnt + 1
end procedure

procedure _run_isr_checks() is
   var byte _i

   regression_begin_run()

   INTPPS = 0x00
   INTCON_INTEDG = true
   PIE0_INTE = off
   PIR0_INTF = off
   INTCON_GIE  = off
   pin_A0_direction = OUTPUT
   pin_A0 = low

   for 3 using _i loop
      PIR0_INTF = off
      PIE0_INTE = on
      INTCON_GIE  = on
      pin_A0 = low
      _usec_delay(10)
      pin_A0 = high
      _usec_delay(10)
      if _isr_cnt != _i + 1 then
         _ok = 0
      end if
      regression_checkpoint()
   end loop

   INTCON_GIE  = off
   PIE0_INTE = off
end procedure

_run_isr_checks()
regression_pass_led_if_clean()
