-- Title: picsim 16F18857 UART text validation
-- Author: Matthew Schinkel
-- Compiler: 3.0a1
--
-- Description: prints a sentinel over the hardware EUSART; the engine
--              captures the pty and asserts the text.
--
-- @picsim_validate begin
-- steps: 300000
-- uart_contains: ##PICSIM##
-- @picsim_validate end
--
include 16f18857
pragma target clock 4_000_000
pragma target OSC      OFF
pragma target RSTOSC   HFINT32
pragma target CLKOUTEN DISABLED
pragma target WDT      DISABLED
pragma target BROWNOUT DISABLED
pragma target FCMEN    DISABLED
pragma target CSWEN    ENABLED
pragma target LVP      ENABLED
pragma target MCLR     EXTERNAL
--
OSCFRQ_HFFRQ = 0b010
--
enable_digital_io()
--
include pps
pps_control_lock(FALSE)
RC6PPS = PPS_TX
pps_control_lock(TRUE)
--
include print
include delay
--
alias pin_rx_direction is pin_c7_direction
alias pin_tx_direction is pin_c6_direction
const serial_hw_baudrate = 115_200
include serial_hardware
serial_hw_init()
--
print_string(serial_hw_data, "##PICSIM##\r\n")
--
forever loop
   _usec_delay(10_000)
end loop
