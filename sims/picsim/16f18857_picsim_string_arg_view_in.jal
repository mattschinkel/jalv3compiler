-- Title: picsim 16F18857 — `in`-formal string reads as the payload view
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description: port of {18f4620,16f1825,16f877}_gpsim_string_arg_view_in
--    at a heap larger than 64: constant and dynamic indexes in one
--    boolean chain, a loop of dynamic reads, two strings through the
--    same formal, and a tainted callee keeping the snapshot.
--
-- @picsim_validate begin
-- steps: 1500000
-- expect byte v_ok1 1
-- expect byte v_ok2 1
-- expect byte v_ok3 1
-- expect byte v_ok4 1
-- @picsim_validate end
--
include 16f18857
pragma target clock 4_000_000
pragma target WDT DISABLED
pragma target string_heap_size 300

var string s
var string t
var volatile byte ok1 = 0
var volatile byte ok2 = 0
var volatile byte ok3 = 0
var volatile byte ok4 = 0

procedure peek(byte in x[], word in n) is
   if (n == 5) & (x[0] == "a") & (x[4] == "e") then
      ok1 = 1
   end if
end procedure

procedure sum5(byte in x[], word in n) is
   var byte i = 0
   var byte tot = 0
   for 5 loop
      tot = tot + x[i]
      i = i + 1
   end loop
   if (n == 5) & (tot == ("a" + "b" + "c" + "d" + "e")) then
      ok2 = 1
   end if
end procedure

procedure mut_check(byte in x[], word in n) is
   s = s & "!"
   if (n == 5) & (x[0] == "a") & (x[4] == "e") then
      ok4 = 1
   end if
end procedure

  s = "abcde"
  t = "vwxyz"
  peek(s, COUNT(s))
  sum5(s, COUNT(s))
  peek(t, COUNT(t))
  if (t[0] == "v") & (s[0] == "a") & (COUNT(s) == 5) & (COUNT(t) == 5) then
     ok3 = 1
  end if
  mut_check(s, COUNT(s))
  forever loop
    ok4 = ok4
  end loop
