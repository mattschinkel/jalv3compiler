-- ----------------------------------------------------------------------------
-- Title: PIC16F18857 picsim — a pointer-to-ARRAY slot, RUNTIME subscript
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    G3 S3: `pa[0] is big` (the ARRAY, not an element), then
--    `g = pa[0][i]` with a RUNTIME `i`.  The slot's base offset is a
--    POINTEE subscript, so the deref walks the array's chunk map exactly
--    like a plain pointer; the runtime-walk branch used to exclude every
--    array-of-pointers element, so a runtime subscript fell into the slot
--    staging and read the wrong byte.  (Slot 0 carries no slot-stride
--    ambiguity; a direct `pa[k][j]` with k>0 remains the recorded residual.)
--
-- @picsim_validate begin
-- steps: 2000000
-- frequency_hz: auto
-- expect byte v_g 101
-- @picsim_validate end
-- ----------------------------------------------------------------------------

include 16f18857
pragma target clock 4_000_000
pragma target WDT DISABLED
pragma target fat_pointers on

var volatile byte big[400]
var volatile byte i
var volatile byte g = 0
var pointer pa[2] as var byte[400]

big[100] = 101
i = 100
pa[0] is big
g = pa[0][i]

forever loop
end loop
