-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness — interrupt servicing, exactly once per
--    latch (ported from the retired 16f1825 gpsim isr_tmr0; Timer0 is not
--    modelled in picsim, so the trigger is a software-latched INT flag --
--    real vector delivery -- and the flag/prescaler setup lines dropped)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The shared `_regression_pic14_isr_body` triggers INT through RA0, which is
--    not the INT pin on this part, so every 14H `*_compiler_regression_isr`
--    wrapper is `skip_gpsim: 1` - the 14H interrupt path had no runtime
--    witness at all.  This test drives a real interrupt instead: TMR0
--    overflow (INTCON_TMR0IF), three times, each serviced exactly once, with
--    the peripheral disabled again at the end.
--
--    It also exercises the 14H context save/restore: the handler runs while
--    the main line is inside a `while` loop, so a missing W/STATUS save would
--    corrupt the loop counter and the checkpoints.
--
-- @picsim_validate begin
-- 
-- steps: 200000
-- expect byte v__check_step 2
-- expect byte v__t0_cnt 3
-- expect byte v__gpsim_regression_flags 0
-- 
-- @picsim_validate end
-- ----------------------------------------------------------------------------

include regression_16f18857_device

include regression

var volatile byte _t0_cnt = 0
var volatile byte _t0_bad = 0

--------------------------------------------------------------------------------
procedure _t0_isr() is
   pragma interrupt

   if !PIR0_INTF then
      return
   end if
   PIR0_INTF = off
   _t0_cnt = _t0_cnt + 1
end procedure

--------------------------------------------------------------------------------
procedure _run_t0_checks() is
   var byte _i

   regression_begin_run()

   -- picsim has no 18857 Timer0 model; the overflow trigger became a
   -- software-latched INT flag (INTPPS RA0), the same real-vector
   -- delivery proof used by the MZ Timer1 witness control.  The ISR
   -- path, per-interrupt exactly-once servicing and the leave-off
   -- checks are the subject and are unchanged.
   INTPPS = 0x00
   INTCON_INTEDG = true
   PIE0_INTE = off
   PIR0_INTF = off
   INTCON_GIE = off
   _t0_cnt = 0

   for 3 using _i loop
      PIE0_INTE = on
      INTCON_GIE = on
      PIR0_INTF = true          -- latch: vector delivers immediately
      while _t0_cnt != _i + 1 loop
      end loop
      INTCON_GIE = off
      PIE0_INTE = off
   end loop

   if _t0_cnt != 3 then
      _t0_bad = _t0_bad + 1
      _check_failed = true
   end if
   regression_checkpoint()

   -- the peripheral must be left off
   if PIE0_INTE | INTCON_GIE then
      _t0_bad = _t0_bad + 1
      _check_failed = true
   end if
   regression_checkpoint()
end procedure

_run_t0_checks()
regression_pass_led_if_clean()

forever loop
end loop
