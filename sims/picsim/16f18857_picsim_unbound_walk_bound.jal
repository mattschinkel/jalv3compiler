-- ----------------------------------------------------------------------------
-- Title: PIC16F18857 picsim — a BOUND pointer through the walk path (control)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The control for the unbound-walk trap: the same conditionally bound
--    pointer with `cond = 1`.  The guard sees a non-zero pointer and the walk
--    resolves big[100] = 101 normally.
--
-- @picsim_validate begin
-- steps: 2000000
-- frequency_hz: auto
-- expect byte v_g 101
-- @picsim_validate end
-- ----------------------------------------------------------------------------

include 16f18857
pragma target clock 4_000_000
pragma target WDT DISABLED

var volatile byte big[400]
var pointer p as var byte[400]
var volatile byte cond
var volatile byte g = 0

big[0] = 1
big[100] = 101
cond = 1
if cond != 0 then
  p is big
end if
g = p[100]

forever loop
end loop
