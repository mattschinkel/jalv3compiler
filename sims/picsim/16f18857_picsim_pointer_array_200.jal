var byte dynbad = 0
var byte constbad = 0
var byte expect
var byte i

expect = 10
for 200 using i loop
   if pa[i] != expect then
      dynbad = 1
   end if
   expect = expect + 10
   if expect == 90 then
      expect = 10
   end if
end loop

if pa[0] != 10 then constbad = 1 end if
if pa[37] != 60 then constbad = 1 end if
if pa[38] != 70 then constbad = 1 end if
if pa[39] != 80 then constbad = 1 end if
if pa[199] != 80 then constbad = 1 end if

if dynbad == 1 then
   a0 = 0
end if
if constbad == 1 then
   a1 = 0
end if

forever loop
end loop
