-- ----------------------------------------------------------------------------
-- Title: PIC16F18857 picsim — 200-slot chunked pointer array (P2b)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    A 200-slot pointer array (400 bytes, 2-byte slots) does not fit the
--    16F18857's holey data area contiguously: the placement segments it
--    (0x2B-0x6E, 0xA0-0xEF, 0x120-0x16F, ...).  The `is` table must land
--    in the chunks (P2b-1) and the dereference must walk to the slot, load
--    the slot's pointer and re-stage FSR (P2b-2) -- the old read staged the
--    slot address and read the slot's pointer bytes as data.
--
-- @picsim_validate begin
-- steps: 8000000
-- frequency_hz: auto
-- expect bit_clear v__bitbucket 0
-- expect byte v_dynbad 0
-- expect byte v_constbad 0
-- @picsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f18857_device

var byte a0 = 10
var byte a1 = 20
var byte a2 = 30
var byte a3 = 40
var byte a4 = 50
var byte a5 = 60
var byte a6 = 70
var byte a7 = 80
var pointer pa[200] as var byte
pa[0] is a0
pa[1] is a1
pa[2] is a2
pa[3] is a3
pa[4] is a4
pa[5] is a5
pa[6] is a6
