include regression_16f18857_device

alias led is pin_A0
alias led_pin is pin_A0              -- second alias to same pin (alias coverage)
pin_A0_direction = OUTPUT

include regression

alias _debounce_pin is pin_C1
pin_C1_direction = INPUT

include _regression_pic14_sample_onchip_body
