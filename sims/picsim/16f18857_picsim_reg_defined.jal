-- Title: picsim 16F18857 compiler regression — defined
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description: shared body: **(inline body, ported from the retired 16F1825 wrapper)**.
--    Ported from the retired 16F1825 gpsim wrapper when the
--    16F1825/16F877 suites were retired (2026-11-05).
--
-- @picsim_validate begin
-- steps: 120000
-- expect byte v__check_step 3
-- @picsim_validate end
--

include regression_16f18857_device

alias led is pin_A0
alias led_pin is pin_A0              -- second alias to same pin (alias coverage)
pin_A0_direction = OUTPUT

include regression

const byte _GPR_EXISTING = 99

--------------------------------------------------------------------------------
-- Description: Empty procedure so **defined** can resolve a label (not only a const value).
--------------------------------------------------------------------------------
procedure _defined_label_probe() is
end procedure

--------------------------------------------------------------------------------
-- Description: Run **defined()** checks; each block ends with **regression_checkpoint**.
--------------------------------------------------------------------------------
procedure _run_defined_checks() is
   regression_begin_run()

   -- Value path: constant exists → branch must be taken.
   if defined(_GPR_EXISTING) then
      if _GPR_EXISTING != 99 then
         _check_failed = true
      end if
   else
      _check_failed = true
   end if
   regression_checkpoint()

   -- Missing symbol → **defined** is false; must not enter the **then** body.
   if defined(_GPR_DOES_NOT_EXIST_ZZZ) then
      _check_failed = true
   end if
   regression_checkpoint()

   -- Label path: procedure name → **defined** should be true.
   if defined(_defined_label_probe) then
      -- ok
   else
      _check_failed = true
   end if
   regression_checkpoint()

   regression_pass_led_if_clean()
   led_pin = low
end procedure

_run_defined_checks()

forever loop
   if _bad then
      led = ON
      _usec_delay(10_000)
      led = OFF
      _usec_delay(10_000)
   else
      led = ON
      _usec_delay(100_000)
      led = OFF
      _usec_delay(400_000)
   end if
end loop
