-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness: a function returns a pointer value
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: 3.0a1
--
-- Description:
--    `return pointer` + `return p` returns the POINTER VALUE (the address),
--    not the rvalue deref; the caller stores it and derefs through `at`.
--    Exercises the full fat pointer (3 bytes) across the return slot.
--
-- ----------------------------------------------------------------------------

-- @picsim_validate begin
-- steps: 80000
-- expect byte v__check_step 1
-- expect byte v__ck 0x42
-- @picsim_validate end

include regression_16f18857_device
include regression

var volatile byte _ck = 0
var byte g

function getp() return pointer is
   var pointer p as var byte
   p is g
   return p
end function

var pointer q as var byte
q = getp()
var byte v at q
v = 0x42
_ck = g
regression_checkpoint()
