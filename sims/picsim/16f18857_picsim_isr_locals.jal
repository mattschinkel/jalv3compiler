-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness — ISR locals larger than one bank window
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    A3 increment 2: the shared ISR frame is one contiguous block, and a
--    frame larger than the largest free run used to wrap VARIABLE_BASE_UNKNOWN
--    into unowned low RAM (silent corruption).  When the block does not fit,
--    the allocator now places each ISR local on its own (each object still
--    inside one window), giving up the ISR overlay for those programs only.
--
--    Three 40-byte locals (122 bytes with the scalars) cannot fit one window
--    on this part; each 40-byte object fits.  The ISR fills them through
--    runtime subscripts (the FSR path that used to alias), reads the first and
--    last byte of each back through constant subscripts (the MOVLB path), and
--    flags any mismatch.  Main drives three INT0 edges and checks the count,
--    the flag and the checkpoint.
--
--    gpsim processor p16f877, 20 MHz HS.
--
-- @picsim_validate begin
--
-- steps: 500000
-- checkpoint_verify: off
-- expect byte v__check_step 3
-- expect byte v__isr_cnt 3
-- expect byte v__gpsim_regression_flags 0
--
-- @picsim_validate end
-- ----------------------------------------------------------------------------

include regression_16f18857_device
include regression

var volatile byte _isr_cnt = 0
var volatile byte _isr_bad = 0

procedure _int0_isr() is
   pragma interrupt
   var byte a[40]
   var byte b[40]
   var byte c[40]
   var byte i

   if !PIR0_INTF then
      return
   end if
   PIR0_INTF = off

   for 40 using i loop
      a[i] = i
      b[i] = i + 1
      c[i] = i + 2
   end loop

   -- constant subscripts: each object's first/last byte must be intact
   if a[0] != 0 then
      _isr_bad = 1
   end if
   if a[39] != 39 then
      _isr_bad = 1
   end if
   if b[0] != 1 then
      _isr_bad = 1
   end if
   if b[39] != 40 then
      _isr_bad = 1
   end if
   if c[0] != 2 then
      _isr_bad = 1
   end if
   if c[39] != 41 then
      _isr_bad = 1
   end if

   _isr_cnt = _isr_cnt + 1
end procedure

procedure _run_isr_checks() is
   var byte _i

   regression_begin_run()

   INTPPS = 0x00                 -- route INT to RA0 (18857 PPS)
   INTCON_INTEDG = true          -- rising edge
   PIE0_INTE = off
   PIR0_INTF = off
   INTCON_GIE  = off
   pin_A0_direction = OUTPUT
   pin_A0 = low

   _isr_bad = 0
   for 3 using _i loop
      PIR0_INTF = off
      PIE0_INTE = on
      INTCON_GIE  = on
      pin_A0 = low
      _usec_delay(10)
      pin_A0 = high                  -- rising edge -> INT0
      _usec_delay(10)
      if _isr_cnt != _i + 1 then
         _check_failed = true
      end if
      regression_checkpoint()
   end loop

   if _isr_bad != 0 then
      _check_failed = true
   end if

   INTCON_GIE  = off
   PIE0_INTE = off
end procedure

_run_isr_checks()
regression_pass_led_if_clean()
