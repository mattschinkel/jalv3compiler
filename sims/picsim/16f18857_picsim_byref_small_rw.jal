-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness: byref small-array read + write (single-bank placement)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv3
--
-- Description:
--    The enhanced-midrange twin of the 16F887 byref small-array witness.  A
--    10-byte array fits one bank, so the byref formal walks no chunk map and
--    the linear pointer path must read and write it correctly.
--
-- @picsim_validate begin
--
-- steps: 600000
-- expect byte v__check_step 2
-- expect byte v__ck_w0 0x78
-- expect byte v__ck_w9 0x56
-- expect byte v__ck_lo 0x78
-- expect byte v__ck_hi 0x56
--
-- @picsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f18857_device
include regression

var volatile byte _ck_lo = 0
var volatile byte _ck_hi = 0
var volatile byte _ck_w0 = 0
var volatile byte _ck_w9 = 0

procedure peek(byref in arr[]) is
   _ck_lo = arr[0]
   _ck_hi = arr[9]
end procedure

procedure bump(byref in out arr[]) is
   arr[0] = 0x78
   arr[9] = 0x56
end procedure

var byte small[10]

procedure run() is
   regression_begin_run()
   bump(small)
   _ck_w0 = small[0]
   _ck_w9 = small[9]
   regression_checkpoint()
   peek(small)
   regression_checkpoint()
   regression_pass_led_if_clean()
end procedure

run()
