-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness — 2-D bit arrays (shared bit2d body)
--    (ported from the retired 16f877 gpsim bit2d_arrays; the gpsim
--    `bit_clear v__bitbucket 0` line watched the pass-LED blink END
--    clear -- a gpsim blink-timing artifact -- so the port expects the
--    regression flags byte instead, the actual cleanliness signal)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Shared `_regression_bit2d_body`: 2D bit-array subscript strides
--    (runtime/const index mixes, 16-bit and 20-bit row strides) on a
--    classic core, where native bit arrays pack into GPR bytes behind
--    the reserved bitbucket bit 0.
--
-- @picsim_validate begin
-- 
-- steps: 300000
-- expect byte v__gpsim_regression_flags 0
-- expect byte v__check_step 7
-- expect byte v__bt2d_fill_ok 1
-- expect byte v__bt2d_const_ok 1
-- expect byte v__bt2d_run_ok 1
-- expect byte v__bt2d_wide_ok 1
-- expect byte v__bt2d_stride20_ok 1
-- expect byte v__bt2d_nd4_ok 1
-- expect byte v__bt2d_nd3b_ok 1
-- 
-- @picsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f18857_device
include regression

include _regression_bit2d_body
