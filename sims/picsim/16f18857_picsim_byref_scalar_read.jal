-- ----------------------------------------------------------------------------
-- Title: 16F18857 picsim witness: byref scalar read
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: 3.0a1
--
-- Description:
--    Pins the byref call-site address-of: a `word z` actual passed to
--    `byref in arr[]` is read back through arr[0]/arr[1] as z's two bytes
--    (low 0x34, high 0x12 on a 14-bit core).
--
-- ----------------------------------------------------------------------------

-- @picsim_validate begin
-- steps: 60000
-- expect byte v__check_step 1
-- expect byte v__ck_lo 0x34
-- expect byte v__ck_hi 0x12
-- expect byte v__ck_cnt 2
-- @picsim_validate end

include regression_16f18857_device
include regression

var volatile byte _ck_lo = 0
var volatile byte _ck_hi = 0
var volatile byte _ck_cnt = 0

procedure peek(byref in arr[]) is
   _ck_lo = arr[0]
   _ck_hi = arr[1]
   _ck_cnt = COUNT(arr)
end procedure

var word z = 0x1234
peek(z)
regression_checkpoint()
