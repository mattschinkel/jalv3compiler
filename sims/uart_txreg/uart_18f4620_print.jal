-- ------------------------------------------------------
-- Title: uart 18f4620 print
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
--
-- Cross-architecture UART TXREG test (PIC18): same record-array print
-- sequence as gpsim_tests/uart_txreg/issue_36_record_const_print.jal,
-- verified via `log w txreg` under gpsim (p18f4620).
--
include 18f4620

pragma target clock 20_000_000
pragma target OSC      hs
pragma target LVP      enabled
pragma target WDT      control

enable_digital_io()
_usec_delay(100_000)

const serial_hw_baudrate = 115_200
include serial_hardware
serial_hw_init()
alias serial is serial_hw_data

include print

record array_def is
   byte a_array[3]
   byte b_array[5]
end record

const array_def array[] = { {"a_1", "b_001"}, {"a_2", "b_002"}, {"a_3", "b_003"} }

forever loop
   print_string(serial, array[0].a_array)
   print_crlf(serial)
   print_string(serial, array[1].a_array)
   print_crlf(serial)
   print_string(serial, array[2].a_array)
   print_crlf(serial)
   print_string(serial, array[0].b_array)
   print_crlf(serial)
   print_string(serial, array[1].b_array)
   print_crlf(serial)
   print_string(serial, array[2].b_array)
   print_crlf(serial)
   print_crlf(serial)
   _usec_delay(500_000)
end loop
