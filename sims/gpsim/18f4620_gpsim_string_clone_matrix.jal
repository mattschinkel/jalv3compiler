-- ----------------------------------------------------------------------------
-- Title: PIC18F4620 gpsim — the string clone across MULTIPLE formals
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The string-flavored clone is chosen PER FORMAL, not per call: a routine
--    may be called with a string in one open-array formal and a byte array in
--    another, or with strings in two formals, and every actual must still be
--    marshalled against the formal it is bound to.
--
--    Pre-fix (the per-procedure clone memo with every open-array formal
--    re-flavoured), only the FIRST string actual was converted to a handle;
--    every later argument was staged by the view/array path into a formal the
--    clone had re-flavoured as a handle.  `mix(s, arr)` left arr[0] unwritten,
--    `mix(arr, s)` corrupted arr[1..3], and `mix(s, t)` never wrote t.  All
--    compiled with 0 errors.
--
--    Fix: a clone variant is keyed by the set of open-array formals that are
--    stored through AND receive a string (the flavour mask); the def re-flavours
--    only those, the call tail drops only their count slots, and every other
--    formal keeps its pointer/view marshalling.
--
-- @gpsim_validate begin
-- steps: 900000
-- frequency_hz: auto
-- expect byte v__check_step 9
-- expect byte v_ok_mixed_string_array 1
-- expect byte v_ok_mixed_array_string 1
-- expect byte v_ok_two_strings 1
-- expect byte v_ok_three_formals 1
-- expect byte v_ok_readonly_formal 1
-- expect byte v_ok_pass_on 1
-- expect byte v_ok_single_formal 1
-- expect byte v_ok_generic_array 1
-- expect byte v_ok_optional 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_18f4620_device
include regression

pragma target string_heap_size 96

var string s
var string t
var string u
var string wstr
var string s2
var string t2
var string s3
var string t3
var string s4
var string s5
var string s6
var byte arr[4]
var byte arr2[4]
var byte arr3[4]
var byte arr4[4]
var byte arr5[4]
var volatile byte ok_mixed_string_array = 0
var volatile byte ok_mixed_array_string = 0
var volatile byte ok_two_strings = 0
var volatile byte ok_three_formals = 0
var volatile byte ok_readonly_formal = 0
var volatile byte ok_pass_on = 0
var volatile byte ok_single_formal = 0
var volatile byte ok_generic_array = 0
var volatile byte ok_optional = 0

-- one stored formal and one read-only `in` formal in the same body
procedure mix(byte in out a[], byte in out b[]) is
   a[0] = "X"
   b[0] = "Y"
end procedure

procedure trio(byte in out a[], byte in out b[], byte in out c[]) is
   a[0] = "A"
   b[0] = "B"
   c[0] = "C"
end procedure

-- `a` is stored through (clone flavour); `x` is only read (payload view)
function mixed_ro(byte in out a[], byte in x[]) return byte is
   a[0] = "Z"
   if COUNT(x) == 3 then
      return x[0]
   end if
   return 0
end function

-- the formal is re-passed: this body is cloneable and its clone's `a` is a
-- string handle handed on to mix, while arr4 stays a generic array actual
procedure pass_on(byte in out a[]) is
   mix(a, arr4)
end procedure

-- the original single-formal clone: arrays keep the generic body
procedure bump(byte in out x[], byte in k, byte in v) is
   x[k] = v
end procedure

-- a trailing optional on a clone: the default must be filled against the
-- clone's shorter member layout
procedure bump_opt(byte in out x[], byte in k,
   optional byte in v default 90) is
   x[k] = v
end procedure

procedure run() is
   regression_begin_run()

   s = "abc"
   arr[0] = 0
   arr[1] = 7
   mix(s, arr)
   if (s[0] == "X") & (arr[0] == "Y") & (arr[1] == 7) then
      ok_mixed_string_array = 1
   end if
   regression_checkpoint()

   t = "def"
   arr2[0] = 0
   mix(arr2, t)
   if (arr2[0] == "X") & (t[0] == "Y") then
      ok_mixed_array_string = 1
   end if
   regression_checkpoint()

   u = "ghi"
   wstr = "jkl"
   mix(u, wstr)
   if (u[0] == "X") & (wstr[0] == "Y")
      & (COUNT(u) == 3) & (COUNT(wstr) == 3) then
      ok_two_strings = 1
   end if
   regression_checkpoint()

   s2 = "aaa"
   t2 = "bbb"
   arr3[0] = 0
   trio(s2, arr3, t2)
   if (s2[0] == "A") & (arr3[0] == "B") & (t2[0] == "C") then
      ok_three_formals = 1
   end if
   regression_checkpoint()

   s3 = "xyz"
   t3 = "pqr"
   if (mixed_ro(s3, t3) == "p") & (s3[0] == "Z") & (COUNT(t3) == 3) then
      ok_readonly_formal = 1
   end if
   regression_checkpoint()

   s4 = "mno"
   arr4[0] = 0
   pass_on(s4)
   if (s4[0] == "X") & (arr4[0] == "Y") then
      ok_pass_on = 1
   end if
   regression_checkpoint()

   s5 = "abc"
   bump(s5, 3, "d")
   if (COUNT(s5) == 4) & (s5[3] == "d") & (s5[0] == "a") then
      ok_single_formal = 1
   end if
   regression_checkpoint()

   arr5[0] = 0
   arr5[1] = 9
   arr5[3] = 4
   bump(arr5, 1, 5)
   if (arr5[1] == 5) & (arr5[0] == 0) & (arr5[3] == 4) then
      ok_generic_array = 1
   end if
   regression_checkpoint()

   s6 = "abc"
   bump_opt(s6, 0)
   if (s6[0] == "Z") & (COUNT(s6) == 3) then
      ok_optional = 1
   end if
   regression_checkpoint()
end procedure

run()
