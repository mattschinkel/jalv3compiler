-- Compiler: JALv2
--
-- Description:
--    The same `_regression_bit2d_body.jal` the PIC32/ESP32 suites run, on
--    the PIC18 back end: the shape is not 32-bit-specific, so the PIC_16
--    grid gains it too.
--
-- @gpsim_validate begin
-- steps: 350000
-- frequency_hz: auto
-- expect byte v__check_step 7
-- expect byte v__bt2d_fill_ok 1
-- expect byte v__bt2d_const_ok 1
-- expect byte v__bt2d_run_ok 1
-- expect byte v__bt2d_wide_ok 1
-- expect byte v__bt2d_stride20_ok 1
-- expect byte v__bt2d_nd4_ok 1
-- expect byte v__bt2d_nd3b_ok 1
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_18f26k22_device

include regression

include _regression_bit2d_body
