-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 1
-- expect byte v_ok 1
-- @gpsim_validate end
include regression_18f4620_device
include regression
pragma target string_heap_size 64
var string s
var volatile byte ok = 0
procedure inner(byte in out x[]) is
   x[0] = "Z"
end procedure
procedure outer(byte in out x[]) is
   inner(x)
end procedure
procedure run() is
   regression_begin_run()
   s = "abc"
   outer(s)
   if (s[0] == "Z") & (s[1] == "b") & (s[2] == "c") & (COUNT(s) == 3) then ok = 1 end if
   regression_checkpoint()
end procedure
run()
