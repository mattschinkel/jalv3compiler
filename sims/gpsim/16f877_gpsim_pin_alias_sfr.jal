-- ----------------------------------------------------------------------------
-- Title: PIC16F877 gpsim — pin aliases + SFR bit overlay
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Classic-14-bit pin/addressing witnesses:
--      * a pin alias and a second alias of the same pin address the same
--        port bit, and the direction alias drives TRIS;
--      * a `var bit [...] at PORTB` overlay writes and reads the real port
--        bits, including a RUNTIME index.
--
--    These are the gpsim counterparts of demo_sample/16f887_pin_alias_hw.jal
--    and demo_sample/16f887_sfr_overlay_hw.jal.  PORTB is made all-outputs
--    first: an overlay write is a read-modify-write on the port register, so
--    a floating input pin would latch its level into the byte.
--
-- @gpsim_validate begin
-- steps: 200000
-- frequency_hz: auto
-- expect byte v__check_step 5
-- expect byte v__gpsim_regression_flags 0
-- expect byte v__ps_b0 1
-- expect byte v__ps_ov5 1
-- expect byte v__ps_ov0 1
-- @gpsim_validate end
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

var bit portb_bits[8] at PORTB
var volatile byte _ps_b0 = 0
var volatile byte _ps_ov5 = 0
var volatile byte _ps_ov0 = 0
var byte _ps_pin

alias _ps_led is pin_B0
alias _ps_led2 is pin_B0

procedure _run_pin_alias_checks() is
   regression_begin_run()

   -- every PORTB pin an output so the overlay RMW is well defined
   TRISB = 0
   PORTB = 0

   -- alias write is visible in the port register
   _ps_led = ON
   if (PORTB & 0x01) != 0 then
      _ps_b0 = 1
   else
      _check_failed = true
   end if
   regression_checkpoint()

   -- the second alias of the same pin sees it, and clears it
   _ps_led2 = OFF
   if (PORTB & 0x01) != 0 then
      _check_failed = true
   end if
   regression_checkpoint()

   -- direction alias drives TRIS
   pin_B0_direction = INPUT
   if (TRISB & 0x01) == 0 then
      _check_failed = true
   end if
   pin_B0_direction = OUTPUT
   if (TRISB & 0x01) != 0 then
      _check_failed = true
   end if
   regression_checkpoint()

   -- SFR overlay, runtime index
   _ps_pin = 5
   portb_bits[_ps_pin] = ON
   if portb_bits[5] != 0 then
      _ps_ov5 = 1
   else
      _check_failed = true
   end if
   regression_checkpoint()

   portb_bits[_ps_pin] = OFF
   portb_bits[0] = ON
   portb_bits[7] = ON
   if (PORTB & 0x81) == 0x81 then
      _ps_ov0 = 1
   else
      _check_failed = true
   end if
   regression_checkpoint()
end procedure

_run_pin_alias_checks()
regression_pass_led_if_clean()

forever loop
end loop
