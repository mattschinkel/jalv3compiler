-- ----------------------------------------------------------------------------
-- Title: PIC16F877 gpsim — INT0 interrupt (pragma interrupt) witness
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Runtime proof of the classic-14-bit interrupt path: an INT0 handler
--    (`pragma interrupt`) increments a counter on every rising edge, the
--    main line toggles RB0 three times, and the run must stop with exactly
--    three counts.  This is the gpsim-runnable counterpart of the
--    `_regression_pic14_isr_body` grid entry, which can only be compiled
--    here (that body triggers INT through RA0, which is not the INT pin on
--    this part).
--
--    gpsim processor p16f877, 20 MHz HS.
--
-- @gpsim_validate begin
-- steps: 400000
-- frequency_hz: auto
-- checkpoint_verify: off
-- (the loop runs the checkpoint three times; the static counter sees one
--  call site)
-- expect byte v__check_step 3
-- expect byte v__isr_cnt 3
-- expect byte v__gpsim_regression_flags 0
-- @gpsim_validate end
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

var volatile byte _isr_cnt = 0

procedure _int0_isr() is
   pragma interrupt

   if !INTCON_INTF then
      return
   end if
   INTCON_INTF = off
   _isr_cnt = _isr_cnt + 1
end procedure

procedure _run_isr_checks() is
   var byte _i

   regression_begin_run()

   OPTION_REG_INTEDG = true          -- rising edge on RB0/INT
   INTCON_INTE = off
   INTCON_INTF = off
   INTCON_GIE  = off
   pin_B0_direction = OUTPUT
   pin_B0 = low

   for 3 using _i loop
      INTCON_INTF = off
      INTCON_INTE = on
      INTCON_GIE  = on
      pin_B0 = low
      _usec_delay(10)
      pin_B0 = high                  -- rising edge -> INT0
      _usec_delay(10)
      if _isr_cnt != _i + 1 then
         _check_failed = true
      end if
      regression_checkpoint()
   end loop

   INTCON_GIE  = off
   INTCON_INTE = off
end procedure

_run_isr_checks()
regression_pass_led_if_clean()

forever loop
end loop
