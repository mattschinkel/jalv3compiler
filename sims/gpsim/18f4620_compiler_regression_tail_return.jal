-- Description:
--    Shared logic: **`tests/_regression_tail_return_body.jal`**.
--    Guards **`cmd_opt_tail_return`** / **`cmd_opt_branch`**: function bodies
--    ending in a call must keep side effects and return the right value
--    (deleted-code / wrong-value defect was latent on classic PIC;
--    infinite `$ra` loop on PIC32 —
--    ****).
--
-- Notes:
--    ./bin/jalv3-x86-64 -s 'lib;tests' tests/18f4620_compiler_regression_tail_return.jal
--
-- @gpsim_validate begin
-- steps: 120000
-- frequency_hz: auto
-- expect_hw_stkptr_le_compiler_depth: 1
-- hw_stkptr_steps: 25000
-- expect byte v__check_step 6
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_18f4620_device

alias led is pin_A0
alias led_pin is pin_A0
pin_A0_direction = OUTPUT

include regression

include _regression_tail_return_body
