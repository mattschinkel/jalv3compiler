-- ----------------------------------------------------------------------------
-- Title: 16F877 classic gpsim — the string-flavored CLONE of a byte in/out
--        formal: the append rule through a plain `x[k] = v`
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    A dynamic string passed to a `byte in out x[]` / `byte out x[]`
--    formal is routed to a lazily created string-flavored CLONE of the
--    callee (fixes/fix_string_arg_view.md's clone follow-up): the body is
--    re-parsed with the formal as a string handle, so the ONE string rule
--    applies -- below COUNT store in place, AT COUNT append one character
--    (grow), past COUNT the range error -- and COUNT is live.  Array
--    actuals keep the generic body: one declared procedure, two compiled
--    flavors.  Growth inside the callee moves the block and the handle
--    follows per access, so no taint gate is needed.
--
-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 9
-- expect byte v_ok_place 1
-- expect byte v_ok_append 1
-- expect byte v_ok_moved 1
-- expect byte v_ok_array 1
-- expect byte v_ok_count 1
-- expect byte v_ok_fn 1
-- expect byte v_ok_ptr 1
-- expect byte v_ok_rd 1
-- expect byte v_ok_passon 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

pragma target string_heap_size 64

var string s
var string t
var pointer p as var string
var byte arr[4]
var volatile byte ok_place = 0
var volatile byte ok_append = 0
var volatile byte ok_moved = 0
var volatile byte ok_array = 0
var volatile byte ok_count = 0
var volatile byte ok_fn = 0
var volatile byte ok_ptr = 0
var volatile byte ok_rd = 0
var volatile byte ok_passon = 0

procedure bump(byte in out x[], byte in k, byte in v) is
   x[k] = v
end procedure

-- a FUNCTION clones the same way (the return binds to the clone's slot)
function bump_get(byte in out x[], byte in k, byte in v) return byte is
   x[k] = v
   return x[0]
end function

-- a READS-ONLY body keeps the payload view (no clone is created)
function first(byte in out x[]) return byte is
   return x[0]
end function

procedure tail2(byte in out y[], byte in v) is
   y[1] = v
end procedure

-- a re-passed formal composes: outer's clone passes its string onward
procedure mid(byte in out x[], byte in v) is
   tail2(x, v)
end procedure

procedure run() is
   regression_begin_run()
   s = "abc"
   bump(s, 0, "X")              -- below COUNT: in place
   if (s[0] == "X") & (s[1] == "b") & (COUNT(s) == 3) then
      ok_place = 1
   end if
   regression_checkpoint()
   bump(s, 3, "d")              -- AT COUNT: append, grow
   if (COUNT(s) == 4) & (s[3] == "d") & (s[0] == "X") then
      ok_append = 1
   end if
   regression_checkpoint()
   bump(s, 4, "e")              -- append again across a moved block
   if (COUNT(s) == 5) & (s[4] == "e") & (s[3] == "d") & (s[1] == "b") then
      ok_moved = 1
   end if
   regression_checkpoint()
   arr[0] = 9
   arr[3] = 7
   bump(arr, 1, 5)              -- array actual: the GENERIC body, no
                                -- append rule, neighbours intact
   if (arr[1] == 5) & (arr[3] == 7) & (arr[0] == 9) then
      ok_array = 1
   end if
   regression_checkpoint()
   if (COUNT(s) == 5) & (COUNT(arr) == 4) then
      ok_count = 1
   end if
   regression_checkpoint()
   t = "xyz"
   if (bump_get(t, 3, "w") == "x") & (COUNT(t) == 4) & (t[3] == "w") then
      ok_fn = 1
   end if
   regression_checkpoint()
   p is t
   bump(p, 0, "P")
   if (t[0] == "P") & (COUNT(t) == 4) then
      ok_ptr = 1
   end if
   regression_checkpoint()
   if (first(t) == "P") & (COUNT(t) == 4) & (first(s) == "X") then
      ok_rd = 1
   end if
   regression_checkpoint()
   mid(t, "Q")
   if (t[1] == "Q") & (COUNT(t) == 4) & (t[0] == "P") then
      ok_passon = 1
   end if
   regression_checkpoint()
end procedure

run()
