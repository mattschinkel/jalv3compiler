-- ----------------------------------------------------------------------------
-- Title: PIC16F887 gpsim — a pointer SLOT bound to a RUNTIME element offset
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    G3 S1 on the classic 14-bit core: `pa[0] is big[i]` with a RUNTIME `i`
--    selecting element 100 of a 200-byte array the allocator splits across
--    the classic RAM banks.  The physical-address slot representation could
--    not resolve `big[i]` across chunks at bind time and stored the
--    object-linear `big.base + i`; under the fat engine the slot holds the
--    tagged id + object-relative offset and the deref dispatch resolves the
--    chunk at run time.  Gate-off keeps the old physical-address limitation.
--
-- @gpsim_validate begin
-- steps: 2000000
-- frequency_hz: auto
-- checkpoint_verify: off
--   (deliberate: this witness proves a VALUE, not a step count; the positive
--    measurement and its failing negative control in the fat pin are the
--    proof)
-- expect byte v_got 42
-- @gpsim_validate end
-- ----------------------------------------------------------------------------

include 16f887
pragma target fat_pointers on

var volatile byte  big[200]
var pointer pa[2] as var byte
var volatile byte i
var volatile byte got = 0

big[100] = 42
i = 100
pa[0] is big[i]
got = pa[0]

forever loop
end loop
