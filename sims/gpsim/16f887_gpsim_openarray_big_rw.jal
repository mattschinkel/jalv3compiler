-- ------------------------------------------------------
-- Title: 16F887 gpsim witness: open-array big-array read + write across FSR holes
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv3
--
-- Description:
--    Pins the shared single-layout chunk-map hand-off for a plain open-array
--    formal on 16F887.  `big[300]` is placed across the SFR holes as 4
--    physical FSR chunks; the callee must walk the actual's chunk map.  This
--    is the same root cause as the byref witness, not a byref-specific gap:
--    `b[0]`/`b[299]` written through the formal land in `big[0]`/`big[299]`
--    (0x78/0x56), and the same offsets read back through the formal return
--    those bytes.
--
-- @gpsim_validate begin
-- steps: 60000
-- frequency_hz: auto
-- expect byte v__check_step 2
-- expect byte v__ck_w0 0x78
-- expect byte v__ck_w1 0x56
-- expect byte v__ck_lo 0x78
-- expect byte v__ck_hi 0x56
-- @gpsim_validate end
-- ------------------------------------------------------

include regression_16f887_device
include regression

var volatile byte _ck_lo = 0
var volatile byte _ck_hi = 0
var volatile byte _ck_w0 = 0
var volatile byte _ck_w1 = 0

procedure peek(byte in b[]) is
   _ck_lo = b[0]
   _ck_hi = b[299]
end procedure

procedure bump(byte in out b[]) is
   b[0] = 0x78
   b[299] = 0x56
end procedure

var byte big[300]

bump(big)
_ck_w0 = big[0]
_ck_w1 = big[299]
regression_checkpoint()
peek(big)
regression_checkpoint()
