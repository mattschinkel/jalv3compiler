-- run the checked body once, then park so the RAM dump is stable
_pclmp_p = 0
_pad_code
r1 = inc1(inc1(inc1(inc1(5))))
r2 = tbl_read(100) + tbl_read(200)
r3 = 0
for 10 using _pclmp_i loop
   r3 = r3 + padbuf[_pclmp_i * 7]
end loop
r4 = inc4(r1 + r2 + r3 + 30)
if _pclmp_p == 123 then
   r4 = r4 + 1
end if
regression_checkpoint()
forever loop
end loop
