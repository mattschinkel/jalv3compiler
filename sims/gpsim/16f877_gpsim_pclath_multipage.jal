-- ----------------------------------------------------------------------------
-- Title: PIC16F877 gpsim — PCLATH page management across a multi-page program
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Runtime gate for the branch-bit (PCLATH) machinery on classic 14-bit
--    parts whose program spans more than one 2K page: forced branchlo/hi
--    pseudos exist, the callee-liveness elision removes the redundant ones,
--    cross-page calls land correctly, and const-table lookups (which write
--    PCLATH directly) still leave the page state usable. The 700-statement
--    live code pad plus the 300-entry const table push the program past
--    2048 words. Checkpoints verify computed values.
--
-- Notes:
--    **`./tests/jal_gpsim_validate.sh tests/16f877_gpsim_pclath_multipage.jal`**
--
-- @gpsim_validate begin
-- steps: 500000
-- frequency_hz: auto
-- expect byte v__check_step 1
-- expect byte v_r1 9
-- expect byte v_r2 54
-- expect byte v_r3 177
-- expect byte v_r4 18
-- expect byte v__pclmp_p 152
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

const byte PADTBL[300] = { 1, 8, 15, 22, 29, 36, 43, 50, 57, 64, 71, 78, 85, 92, 99, 106, 113, 120, 127, 134, 141, 148, 155, 162, 169, 176, 183, 190, 197, 204, 211, 218, 225, 232, 239, 246, 253, 4, 11, 18, 25, 32, 39, 46, 53, 60, 67, 74, 81, 88, 95, 102, 109, 116, 123, 130, 137, 144, 151, 158, 165, 172, 179, 186, 193, 200, 207, 214, 221, 228, 235, 242, 249, 0, 7, 14, 21, 28, 35, 42, 49, 56, 63, 70, 77, 84, 91, 98, 105, 112, 119, 126, 133, 140, 147, 154, 161, 168, 175, 182, 189, 196, 203, 210, 217, 224, 231, 238, 245, 252, 3, 10, 17, 24, 31, 38, 45, 52, 59, 66, 73, 80, 87, 94, 101, 108, 115, 122, 129, 136, 143, 150, 157, 164, 171, 178, 185, 192, 199, 206, 213, 220, 227, 234, 241, 248, 255, 6, 13, 20, 27, 34, 41, 48, 55, 62, 69, 76, 83, 90, 97, 104, 111, 118, 125, 132, 139, 146, 153, 160, 167, 174, 181, 188, 195, 202, 209, 216, 223, 230, 237, 244, 251, 2, 9, 16, 23, 30, 37, 44, 51, 58, 65, 72, 79, 86, 93, 100, 107, 114, 121, 128, 135, 142, 149, 156, 163, 170, 177, 184, 191, 198, 205, 212, 219, 226, 233, 240, 247, 254, 5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89, 96, 103, 110, 117, 124, 131, 138, 145, 152, 159, 166, 173, 180, 187, 194, 201, 208, 215, 222, 229, 236, 243, 250, 1, 8, 15, 22, 29, 36, 43, 50, 57, 64, 71, 78, 85, 92, 99, 106, 113, 120, 127, 134, 141, 148, 155, 162, 169, 176, 183, 190, 197, 204, 211, 218, 225, 232, 239, 246, 253, 4, 11, 18, 25, 32, 39, 46 }

var byte padbuf[80] = { 0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39, 42, 45, 48, 51, 54, 57, 60, 63, 66, 69, 72, 75, 78, 81, 84, 87, 90, 93, 96, 99, 102, 105, 108, 111, 114, 117, 120, 123, 126, 129, 132, 135, 138, 141, 144, 147, 150, 153, 156, 159, 162, 165, 168, 171, 174, 177, 180, 183, 186, 189, 192, 195, 198, 201, 204, 207, 210, 213, 216, 219, 222, 225, 228, 231, 234, 237 }

var byte r1
var byte r2
var byte r3
var byte r4
var byte _pclmp_i
var byte _pclmp_p = 0

function inc4(byte in x) return byte is
   return x + 4
end function

function inc1(byte in x) return byte is
   return inc4(x) - 3
end function

function tbl_read(word in ix) return byte is
   return PADTBL[ix]
end function

