-- ----------------------------------------------------------------------------
-- Title: PIC16F877 classic gpsim — append needs the heap, not just the CAP
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Appending at COUNT(s) allocates the grown block while the old one is
--    still live (the same peak as `s = s & "x"`).  A 60-character string in an
--    80-byte heap leaves only ~14 bytes free, so the 61-byte append cannot
--    allocate: nothing is written, COUNT stays 60 and `_string_error` reports
--    heap full (1).  (80 also keeps the heap-size advisory quiet -- the
--    recommendation for one 60-byte literal is 79.)
--
-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 1
-- expect byte v_full_ok 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

const word _string_heap_size = 80

var string big
var pointer p as var string
var volatile byte full_ok = 0

procedure run() is
   regression_begin_run()
   big = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
   p is big
   p[60] = "B"                       -- grown block + the live block: heap full
   if (COUNT(big) == 60) & (_string_error == _STRING_ERROR_HEAP_FULL) then
      full_ok = 1
   end if
   regression_checkpoint()
end procedure

run()
