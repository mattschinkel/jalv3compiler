-- ----------------------------------------------------------------------------
-- Title: PIC12F508 gpsim — 12-bit core control flow
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    if / elif / else, while, for and case on the 12-bit core.  The core has
--    25 bytes of RAM, so the test spends them on five result cells and two
--    loop variables and nothing else; no `include regression` (its pinned
--    GPRs do not exist here), hence `checkpoint_verify: off`.
--
-- @gpsim_validate begin
-- steps: 200000
-- frequency_hz: auto
-- checkpoint_verify: off
-- (no `include regression`: its pinned GPRs do not exist on a 12-bit part)
-- expect byte v_r_if1 1
-- expect byte v_r_if2 3
-- expect byte v_r_while 5
-- expect byte v_r_for 4
-- expect byte v_r_case 22
-- @gpsim_validate end
-- ----------------------------------------------------------------------------

include regression_12f508_device

var volatile byte r_if1 = 0
var volatile byte r_if2 = 0
var volatile byte r_while = 0
var volatile byte r_for = 0
var volatile byte r_case = 0

var byte i
var byte n

n = 1
if n == 1 then
   r_if1 = 1
else
   if n == 3 then
      r_if1 = 3
   else
      r_if1 = 9
   end if
end if

n = 3
if n == 1 then
   r_if2 = 1
else
   if n == 3 then
      r_if2 = 3
   else
      r_if2 = 9
   end if
end if

n = 5
while n != 0 loop
   n = n - 1
   r_while = r_while + 1
end loop

for 4 using i loop
   r_for = r_for + 1
end loop

n = 2
case n of
   1 : block
      r_case = 11
   end block
   2 : block
      r_case = 22
   end block
   otherwise block
      r_case = 99
   end block
end case

forever loop
end loop
