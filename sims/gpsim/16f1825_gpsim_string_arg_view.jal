-- ----------------------------------------------------------------------------
-- Title: 16F1825 gpsim — a string payload VIEW into out / in out formals
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    A heap string actual bound to a `byte out x[]` / `byte in out x[]`
--    formal is handed over as a payload VIEW (fixes/fix_string_arg_view.md):
--    the formal's runtime chunk map carries the HEAP's layout plus a base
--    word staged from the handle (OFFSET + header), and the hidden count is
--    COUNT(s).  The callee's writes land in the live payload, count-bounded;
--    COUNT is unchanged and growth is not expressible through the view.
--    The contaminated shapes stay refused: a callee that reallocates a
--    string keeps the diagnostic (no snapshot exists on the OUT path).
--
-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 5
-- expect byte v_ok_io 1
-- expect byte v_ok_out 1
-- expect byte v_ok_ptr 1
-- expect byte v_ok_cnt 1
-- expect byte v_ok_iso 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f1825_device
include regression

pragma target string_heap_size 100

var string s
var string t
var pointer p as var string
var volatile byte ok_io = 0
var volatile byte ok_out = 0
var volatile byte ok_ptr = 0
var volatile byte ok_cnt = 0
var volatile byte ok_iso = 0

-- in out: read-modify-write through the view at constant and dynamic indices
procedure poke(byte in out x[], byte in k, byte in v) is
   x[k] = v
   x[0] = x[0]
end procedure

-- out: fill the first bytes; the tail past what is written stays as it was
procedure fill4(byte out x[], byte in v) is
   var byte i = 0
   for 4 loop
      x[i] = v
      i = i + 1
   end loop
end procedure

procedure run() is
   regression_begin_run()
   s = "abcde"
   t = "hello"
   poke(s, 0, "X")
   poke(s, 4, "Y")
   poke(t, 2, "Z")
   if (s[0] == "X") & (s[1] == "b") & (s[4] == "Y") & (COUNT(s) == 5)
      & (t[2] == "Z") & (t[0] == "h") & (t[4] == "o") & (COUNT(t) == 5) then
      ok_io = 1
      regression_checkpoint()
   end if
   fill4(t, "w")
   if (t[0] == "w") & (t[3] == "w") & (t[4] == "o") & (COUNT(t) == 5)
      & (s[0] == "X") & (s[4] == "Y") then
      ok_out = 1
      regression_checkpoint()
   end if
   p is t
   poke(p, 1, "q")
   if (t[1] == "q") & (t[0] == "w") & (COUNT(t) == 5) then
      ok_ptr = 1
      regression_checkpoint()
   end if
   if (COUNT(s) == 5) & (COUNT(t) == 5) then
      ok_cnt = 1
      regression_checkpoint()
   end if
   -- a second string through the same formals stays isolated (per-site base)
   fill4(s, "k")
   poke(t, 3, "m")
   if (s[0] == "k") & (s[3] == "k") & (s[4] == "Y")
      & (t[3] == "m") & (t[4] == "o") then
      ok_iso = 1
      regression_checkpoint()
   end if
end procedure

run()
