-- ----------------------------------------------------------------------------
-- Title: PIC18F4620 gpsim — a pointer actual for an open-array formal
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    `procedure check(byte in x[], word in n)` called with a POINTER that
--    addresses a 300-byte array (three RAM banks on this part, two chunks).
--    The formal must read through the pointer with the linear 16-bit path:
--    a baked array layout would address the pointer's own storage and read
--    zeros past the first bank.
--
-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 1
-- expect byte v_a 1
-- expect byte v_pv 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_18f4620_device
include regression

var byte big[300]
var pointer p as var byte
var volatile byte a = 0
var volatile byte pv = 0

procedure check(byte in x[], word in n) is
   if (n == 300) & (x[0] == 1) & (x[150] == 2) & (x[299] == 3) then
      a = 1
   end if
end procedure

procedure run() is
   regression_begin_run()
   big[0] = 1
   big[150] = 2
   big[299] = 3
   p is big[0]
   check(big, 300)          -- array actual: baked layout
   if a == 1 then
      a = 0
      check(p, 300)         -- pointer actual: linear pointer path
      if a == 1 then
         pv = 1
      end if
   end if
   regression_checkpoint()
end procedure

run()
