-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 1
-- expect byte v_ok 1
-- @gpsim_validate end
include regression_18f4620_device
include regression
pragma target string_heap_size 64
var string s
var pointer p as var string
var volatile byte ok = 0
procedure run() is
   regression_begin_run()
   s = "abc"
   p is s
   if (COUNT(p) == 3) & (p[0] == "a") & (p[2] == "c") then ok = 1 end if
   regression_checkpoint()
end procedure
run()
