-- ------------------------------------------------------
-- Title: 16f1825 gpsim witness — `_error_hook` runtime error handler
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Defines `procedure _error_hook()` and lets a dynamic-string append fail
--    (heap 100, three growing strings).  The compiler must:
--      * find the hook by name (no include, declaration or bind),
--      * set `_error_source` / `_string_error` and call it in place,
--      * clear both cells when it returns (delivered once, then gone).
--
--    The hook records the source/code and counts calls; the witness asserts
--    those, that `_string_error` reads 0 after the hook (the clear), and that
--    the failed appends left the string at 40 characters (no-ops).
--
-- @gpsim_validate begin
-- steps: 3000000
-- expect byte v__gpsim_regression_flags 0
-- expect byte v__check_step 1
-- expect byte v_done 1
-- expect byte v_hook_ct 2
-- expect byte v_hook_src 1
-- expect byte v_hook_code 1
-- expect byte v_err_after 0
-- expect word_le v_len 40
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_16f1825_device
include regression

var volatile byte hook_ct = 0
var volatile byte hook_src = 0
var volatile byte hook_code = 0
var volatile byte err_after = 99
var volatile word len = 0
var volatile byte done = 0

const word _string_heap_size = 100

-- the handler: it must be defined before the code that can fail
procedure _error_hook() is
   if _error_source == _ERROR_SOURCE_STRING then
      hook_src = _error_source
      hook_code = _string_error      -- read once: this read clears the cell
      hook_ct = hook_ct + 1
   end if
end procedure

var string sa = "AAAAAAAAAA"
var string sb = "BBBBBBBBBB"
var string sc

regression_begin_run()
sc = sc & sa & sb
sc = sc & sa & sb
sc = sc & sa & sb
sc = sc & sa & sb                   -- heap full: fails, hook fires
err_after = _string_error           -- cleared by the hook on return
len = COUNT(sc)
done = 1
regression_checkpoint()
regression_pass_led_if_clean()
