-- ----------------------------------------------------------------------------
-- Title: PIC16F877 classic gpsim — character store through a string pointer
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    `var pointer p as var string` + `p[i] = c` on a heap string:
--      * i <  COUNT(s)  stores in place (COUNT unchanged),
--      * i == COUNT(s)  APPENDS one character (the block grows, COUNT follows),
--      * i >  COUNT(s)  is refused: nothing written, `_string_error_range`
--        (4) through the optional `_error_hook`.
--    The pointer follows a reallocated block, and an empty string takes its
--    first character by append.  The direct `s[i] = c` form follows the same
--    rules (covered by the shared subscript body on the other targets).
--
-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 3
-- expect byte v_store_ok 1
-- expect byte v_range_ok 1
-- expect byte v_empty_ok 1
-- expect byte v_hook_ct 1
-- expect byte v_hook_src 1
-- expect byte v_hook_code 4
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

pragma target string_heap_size 64

var string s
var string e
var pointer p as var string
var byte i
var byte c
var volatile byte hook_ct = 0
var volatile byte hook_src = 0
var volatile byte hook_code = 0
var volatile byte store_ok = 0
var volatile byte range_ok = 0
var volatile byte empty_ok = 0

-- the handler: defined before the code that can fail
procedure _error_hook() is
   hook_src = _error_source
   hook_code = _string_error        -- consume-on-read
   hook_ct = hook_ct + 1
end procedure

procedure run() is
   regression_begin_run()

   -- in place (const and runtime index), then append at COUNT; a later
   -- assignment reallocates the block and the pointer follows it
   s = "abc"
   p is s
   p[1] = "X"
   i = 2
   c = 90
   p[i] = c
   p[3] = "!"
   if (s == "aXZ!") & (COUNT(s) == 4) then
      store_ok = 1
   end if
   s = "abcdef"
   p[1] = "Y"
   if (store_ok == 1) & (s == "aYcdef") & (COUNT(s) == 6) then
      store_ok = 2
   end if
   if store_ok == 2 then
      store_ok = 1
   end if
   regression_checkpoint()

   -- one past the end: refused, text unchanged, hook receives the range code
   p[7] = "Q"
   if (s == "aYcdef") & (hook_ct == 1) & (hook_src == 1)
      & (hook_code == 4) then
      range_ok = 1
   end if
   regression_checkpoint()

   -- an explicitly empty string takes its first character by append
   e = ""
   p is e
   p[0] = "A"
   if (e == "A") & (COUNT(e) == 1) then
      empty_ok = 1
   end if
   regression_checkpoint()
end procedure

run()
