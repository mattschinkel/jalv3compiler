-- @gpsim_validate begin
-- steps: 800000
-- frequency_hz: auto
-- expect byte v__check_step 8
-- expect byte v_guard_a 0xAA
-- expect byte v_guard_b 0x55
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_12f1840_device

alias led is pin_A0
pin_A0_direction = OUTPUT

include regression

include _regression_pic14_bit_dynamic_body
