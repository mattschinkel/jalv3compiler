-- ------------------------------------------------------
-- Title: 16f1825 gpsim witness — unassigned string as the LEFT operand of &
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Rob's 2026-11-02 follow-up:
--       var string my_string3               -- never assigned
--       my_string3 = my_string3 & my_string1 & my_string2
--    An unassigned `var string` must behave as the EMPTY string (handle 0,
--    COUNT 0), not as garbage: the report's program relies on the first
--    concatenation starting from nothing.  Verified here at
--    `_string_heap_size` 100 (over one 16F1825 RAM bank, so the heap and the
--    `_strargN` marshalling buffers are multi-bank and addressed through the
--    runtime chunk map).
--
--    Checks: COUNT before = 0, COUNT after = 20, and the 20 marshalled bytes
--    are "My string1My string2" (M at 0, '1' at 9, M at 10, '2' at 19).
--
-- @gpsim_validate begin
-- steps: 3000000
-- expect byte v__gpsim_regression_flags 0
-- expect byte v__check_step 1
-- expect byte v_done 1
-- expect word_le v_len0 0
-- expect word_le v_len3 20
-- expect word_le v_n 20
-- expect byte v_b0 77
-- expect byte v_b9 49
-- expect byte v_b10 77
-- expect byte v_b19 50
-- @gpsim_validate end
--
include regression_16f1825_device
include regression

var byte _cap[64]
var volatile byte _capn = 0
procedure cap'put(byte in x) is
   _cap[_capn] = x
   _capn = _capn + 1
end procedure

pragma target string_heap_size 100
include print

var string my_string1 = "My string" & 1
var byte two = 2
var string my_string2 = "My string" & two
var string my_string3

var volatile byte done = 0
var volatile word n = 0
var volatile word len0 = 0
var volatile word len3 = 0
var volatile byte b0 = 0
var volatile byte b9 = 0
var volatile byte b10 = 0
var volatile byte b19 = 0

regression_begin_run()
_capn = 0
len0 = COUNT(my_string3)
my_string3 = my_string3 & my_string1 & my_string2
len3 = COUNT(my_string3)
print_string(cap, my_string3)
n = _capn
b0 = _cap[0]
b9 = _cap[9]
b10 = _cap[10]
b19 = _cap[19]
done = 1
regression_checkpoint()
regression_pass_led_if_clean()
