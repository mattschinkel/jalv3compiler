-- ----------------------------------------------------------------------------
-- Title: PIC16F887 gpsim — `in`-formal string reads as the payload VIEW
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The classic 14-bit form of the payload-view witness: an IN-only open
--    byte-array formal reads a heap string in place.  On this core the view
--    is a BAKED copy of the heap's chunk map with the payload base riding a
--    per-formal cell, so the callee's runtime subscript walks it through
--    `pic_fsr_chunk_walk_emit_ofs` with the classic string-view class --
--    the FSR_DYNAMIC/SV_VIEW recipe row (A12 row 20).
--
--    A12 coverage fixture: the 16F18857 suite takes the RUNTIME-map row on
--    the 14H core, so no gate program reached the classic view row after
--    the 16F1825/16F877 suites were retired.
--
-- @gpsim_validate begin
-- steps: 2000000
-- frequency_hz: auto
-- checkpoint_verify: off
--   (deliberate: this witness proves VALUES, not a step count; the four ok
--    flags are the measurement)
-- expect byte v_ok1 1
-- expect byte v_ok2 1
-- expect byte v_ok3 1
-- expect byte v_ok4 1
-- @gpsim_validate end
-- ----------------------------------------------------------------------------

include 16f887
pragma target clock 4_000_000
pragma target string_heap_size 100

var string s
var string t
var volatile byte ok1 = 0
var volatile byte ok2 = 0
var volatile byte ok3 = 0
var volatile byte ok4 = 0

procedure peek(byref in x[], word in n) is
   if (n == 5) & (x[0] == "a") & (x[4] == "e") then
      ok1 = 1
   end if
end procedure

procedure sum5(byref in x[], word in n) is
   var byte i = 0
   var byte tot = 0
   for 5 loop
      tot = tot + x[i]
      i = i + 1
   end loop
   if (n == 5) & (tot == ("a" + "b" + "c" + "d" + "e")) then
      ok2 = 1
   end if
end procedure

procedure mut_check(byref in x[], word in n) is
   s = s & "!"
   if (n == 5) & (x[0] == "a") & (x[4] == "e") then
      ok4 = 1
   end if
end procedure

s = "abcde"
t = "vwxyz"
peek(s, COUNT(s))
sum5(s, COUNT(s))
peek(t, COUNT(t))
if (t[0] == "v") & (s[0] == "a") & (COUNT(s) == 5) & (COUNT(t) == 5) then
   ok3 = 1
end if
mut_check(s, COUNT(s))
forever loop
   ok4 = ok4
end loop
