-- Title: 18f4620 float renderer battery (_string_float_str)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description: Runtime float->decimal renderer battery, classic-robust
--    subset (24 cases: the old soft-float division is ~1 ulp imprecise,
--    so boundary-digit shortest forms fall back to 9 digits -- those
--    cases live in the ESP32/PIC32 battery only).
--
-- @gpsim_validate begin
-- steps: 40000000
-- frequency_hz: auto
-- checkpoint_verify: off
-- (the pin is expect byte v__fb_bad 0, not the _check_step convention)
-- expect byte v__fb_bad 0
-- @gpsim_validate end
--
include 18f4620
pragma target clock 40_000_000
const word _string_heap_size = 64
pragma string index byte
include strings_dynamic

var byte _fb_buf[48]
var byte _fb_n = 0
var byte _fb_bad = 0
var byte _fb_i = 0

--------------------------------------------------------------------------------
-- Description: run one battery case; _e0.._eg are the expected ASCII bytes
--------------------------------------------------------------------------------
procedure _fb_case(float in _fv, byte in _cid, byte in _el, byte in _e0, byte in _e1, byte in _e2, byte in _e3, byte in _e4, byte in _e5, byte in _e6, byte in _e7, byte in _e8, byte in _e9, byte in _ea, byte in _eb, byte in _ec, byte in _ed, byte in _ee, byte in _ef, byte in _eg) is
   var byte _k = 0
   var byte _m = 0
   _fb_n = _string_float_str(_fv, _fb_buf)
   if _fb_n != _el then
      _fb_bad = _cid
   end if
   _fb_i = 0
   while _fb_i < _fb_n loop
      _k = _fb_i
      if _k == 0 then
         _m = _e0
      end if
      if _k == 1 then
         _m = _e1
      end if
      if _k == 2 then
         _m = _e2
      end if
      if _k == 3 then
         _m = _e3
      end if
      if _k == 4 then
         _m = _e4
      end if
      if _k == 5 then
         _m = _e5
      end if
      if _k == 6 then
         _m = _e6
      end if
      if _k == 7 then
         _m = _e7
      end if
      if _k == 8 then
         _m = _e8
      end if
      if _k == 9 then
         _m = _e9
      end if
      if _k == 10 then
         _m = _ea
      end if
      if _k == 11 then
         _m = _eb
      end if
      if _k == 12 then
         _m = _ec
      end if
      if _k == 13 then
         _m = _ed
      end if
      if _k == 14 then
         _m = _ee
      end if
      if _k == 15 then
         _m = _ef
      end if
      if _k == 16 then
         _m = _eg
      end if
      if _fb_buf[_fb_i] != _m then
         _fb_bad = _cid
      end if
      _fb_i = _fb_i + 1
   end loop
end procedure

var float _fb_v2 = 0.5
