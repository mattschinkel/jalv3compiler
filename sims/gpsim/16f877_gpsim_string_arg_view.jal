-- ----------------------------------------------------------------------------
-- Title: 16F877 classic gpsim — a string payload VIEW into out / in out
--        formals through the BAKED chunk-map ladder
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    A classic 14-bit core has one 8-bit FSR (no FSR0 linear walk), so the
--    payload view takes its own path (fixes/fix_string_arg_view.md): the
--    formal carries a BAKED copy of the heap's chunk map (the placement
--    propagation), the payload base offset rides a PER-FORMAL cell that
--    every call site of that formal fills, and the callee's ladder adds
--    the cell into the index before resolving the chunk (IRP comes from
--    the chunk base and the carry, the 2026-10-26 rule).  Heap 150 spans
--    two banks here, so every access crosses the hole.
--
-- @gpsim_validate begin
-- steps: 600000
-- frequency_hz: auto
-- expect byte v__check_step 4
-- expect byte v_ok_io 1
-- expect byte v_ok_out 1
-- expect byte v_ok_iso 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

pragma target string_heap_size 150

var string s
var string t
var volatile byte ok_io = 0
var volatile byte ok_out = 0
var volatile byte ok_iso = 0

-- in out: constant and dynamic indices
procedure poke(byte in out x[], byte in k, byte in v) is
   x[k] = v
   x[0] = x[0]
end procedure

-- out: partial fill through a loop
procedure fill4(byte out x[], byte in v) is
   var byte i = 0
   for 4 loop
      x[i] = v
      i = i + 1
   end loop
end procedure

procedure run() is
   regression_begin_run()
   s = "abcde"
   t = "hello"
   poke(s, 0, "X")
   poke(t, 2, "Z")
   regression_checkpoint()
   if (s[0] == "X") & (s[1] == "b") & (t[2] == "Z") & (t[0] == "h")
      & (COUNT(s) == 5) & (COUNT(t) == 5) then
      ok_io = 1
   end if
   fill4(t, "w")
   regression_checkpoint()
   if (t[0] == "w") & (t[3] == "w") & (t[4] == "o") & (COUNT(t) == 5)
      & (s[0] == "X") then
      ok_out = 1
   end if
   fill4(s, "k")
   regression_checkpoint()
   if (s[0] == "k") & (s[3] == "k") & (s[4] == "e") & (t[0] == "w") then
      ok_iso = 1
   end if
   regression_checkpoint()
end procedure

run()
