-- ------------------------------------------------------

include regression_12f1840_device

alias led is pin_A0
pin_A0_direction = OUTPUT

include regression

alias _debounce_pin is pin_A1
pin_A1_direction = INPUT

include _regression_pic14_sample_onchip_body
