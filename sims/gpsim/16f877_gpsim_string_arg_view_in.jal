-- ----------------------------------------------------------------------------
-- Title: 16F877 classic gpsim — `in`-formal string reads as the payload
--        VIEW, including a word-index heap
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The classic-core half of the `in` view (fixes/fix_string_arg_view.md):
--    reads walk the formal's BAKED copy of the heap's chunk map with the
--    per-formal base cell added into the index.  Heap 260 makes the heap
--    index WORD-sized, so the ladder's wide path (IRP from the carry and
--    the high byte) is exercised; the loop reads go through the shared
--    walk helper, whose body also folds the cell in.  A tainted callee
--    keeps the snapshot on the IN side.
--
-- @gpsim_validate begin
-- steps: 800000
-- frequency_hz: auto
-- expect byte v__check_step 4
-- expect byte v_ok1 1
-- expect byte v_ok2 1
-- expect byte v_ok3 1
-- @gpsim_validate end
--
-- ----------------------------------------------------------------------------

include regression_16f877_device
include regression

pragma target string_heap_size 260

var string s
var string t
var volatile byte ok1 = 0
var volatile byte ok2 = 0
var volatile byte ok3 = 0

-- constant and dynamic indexes in one boolean chain
procedure peek(byte in x[], word in n) is
   if (n == 5) & (x[0] == "a") & (x[4] == "e") then
      ok1 = 1
   end if
end procedure

-- a loop of dynamic reads (the shared walk-helper path)
procedure sum5(byte in x[], word in n) is
   var byte i = 0
   var byte tot = 0
   for 5 loop
      tot = tot + x[i]
      i = i + 1
   end loop
   if (n == 5) & (tot == ("a" + "b" + "c" + "d" + "e")) then
      ok2 = 1
   end if
end procedure

procedure run() is
   regression_begin_run()
   s = "abcde"
   t = "hello"
   peek(s, COUNT(s))
   regression_checkpoint()
   sum5(s, COUNT(s))
   regression_checkpoint()
   peek(t, COUNT(t))
   if (t[0] == "h") & (s[0] == "a") & (COUNT(s) == 5) & (COUNT(t) == 5) then
      ok3 = 1
   end if
   regression_checkpoint()
   -- nb: the tainted-callee SNAPSHOT case is not carried here: a 260-byte
   -- marshalling buffer cannot fit this part's RAM (the sizing diagnostic
   -- says so honestly); the taint gate itself is pinned in
   -- unit-tests/test_string_error_paths.sh
   regression_checkpoint()
end procedure

run()
