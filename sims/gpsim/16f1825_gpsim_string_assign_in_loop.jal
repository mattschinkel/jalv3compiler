-- ------------------------------------------------------
-- Title: 16f1825 gpsim witness — heap string assigned inside a loop
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Second face of the 2026-11-01 nested-loop temp-region defect
--    (`fix_temp_nested_loop_region.md`) behind Rob's 16F1825 string
--    report.  `16f1825_gpsim_string_print_in_loop.jal` pins the
--    `print_string` marshalling path; this file pins the plain heap
--    assignment path, which fails the same way but SILENTLY.
--
--    `b = a` on two heap strings emits a compiler-generated copy loop
--    bounded by `a`'s runtime length.  The bound temp is written
--    between the outer loop top and the inner copy-loop top, so the
--    pre-fix temp allocator -- which merged nested backward-branch
--    hulls into one region -- classed it "entirely inside" the merged
--    outer hull and did not extend it across the inner back edge.  The
--    heap source-index temp written in the copy body therefore shared
--    the bound's slot and clobbered the bound every iteration.
--
--    Pre-fix the copy clobbers its own bound and never terminates in
--    this regression build: after 3M steps the PC still sits in the
--    copy-loop body and every checkpoint variable (`_check_step`,
--    `done`, the string checks) reads 0.  The same source built against
--    the full default data pool instead completed with `COUNT(a)` and
--    `COUNT(b)` both 0 and `a`'s handle corrupted -- the same defect,
--    failing quietly -- so the content checks here are what pin it;
--    a completion-only check would depend on the allocator's layout.
--    Post-fix both strings are 9 bytes with `M`/`g` at the ends.
--
-- @gpsim_validate begin
-- steps: 3000000
-- expect byte v__gpsim_regression_flags 0
-- expect byte v__check_step 1
-- expect byte v_done 1
-- expect byte v_na 9
-- expect byte v_nb 9
-- expect byte v_a8 103
-- expect byte v_b0 77
-- expect byte v_b8 103
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_16f1825_device
include regression

const word _string_heap_size = 48

var string a
var string b
var volatile byte done = 0
var volatile byte na = 0
var volatile byte nb = 0
var volatile byte a8 = 0
var volatile byte b0 = 0
var volatile byte b8 = 0

a = "My string"
regression_begin_run()

-- the outer loop merges the pre-fix allocator's regions; the
-- assignment's heap copy loop is the inner region
for 2 loop
   b = a
end loop

na = COUNT(a)
nb = COUNT(b)
a8 = a[8]
b0 = b[0]
b8 = b[8]
done = 1
regression_checkpoint()
regression_pass_led_if_clean()
