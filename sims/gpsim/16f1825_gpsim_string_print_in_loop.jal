-- ------------------------------------------------------
-- Title: 16f1825 gpsim witness — dynamic string printed inside a loop
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Rob's 2026-11-01 silicon report, reduced: `print_string(cap,
--    my_string)` with a heap-backed `var string` inside a loop.  The
--    marshalling that copies a dynamic string into the open byte-array
--    formal allocates temps for the copy length and the heap source
--    index; the temp interval allocator merged nested loop regions into
--    one hull, so a temp written before an INNER loop but inside the
--    merged outer hull was classed "entirely inside the region" and was
--    not extended across the inner back edge.  The copy-length temp then
--    shared its slot with the source-index temp the loop body writes, so
--    the copy bound was clobbered every iteration and the copy ran past
--    the heap -- on silicon the out-of-range writes hit SFRs and
--    restarted the part (the serial log shows the banner repeating);
--    gpsim stops at the first invalid file-register read.
--
--    Pre-fix this file derails: `done` never reaches 1 (the checkpoint
--    count stalls and `_bad` is never cleared).  Post-fix both loop
--    iterations copy the 9-byte payload byte-exact.
--
-- @gpsim_validate begin
-- steps: 3000000
-- poke byte v_my_string 0x5c
-- poke byte v_my_string+1 0x99
-- poke byte v_my_string+2 0xff
-- expect byte v__gpsim_regression_flags 0
-- expect byte v__check_step 1
-- expect byte v_done 1
-- expect byte v_n1 9
-- expect byte v_b0 77
-- expect byte v_b8 103
-- expect byte v_my_string 0
-- expect byte v_my_string+1 9
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_16f1825_device
include regression

var byte _cap[24]
var volatile byte _capn = 0
procedure cap'put(byte in x) is
   _cap[_capn] = x
   _capn = _capn + 1
end procedure

pragma target string_heap_size 15
include print

var string my_string
var volatile byte done = 0
var volatile byte n1 = 0
var volatile byte b0 = 0
var volatile byte b8 = 0

my_string = "My string"
regression_begin_run()

-- the outer loop is what merges the regions in the pre-fix allocator;
-- the print's own copy loop is the inner region
for 2 loop
   _capn = 0
   print_string(cap, my_string)
end loop

n1 = _capn
b0 = _cap[0]
b8 = _cap[8]
done = 1
regression_checkpoint()
regression_pass_led_if_clean()
