-- ------------------------------------------------------
-- Title: PIC18F26K22 compiler regression — **`var pointer` / `is` / subscripts** (shared body)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    **`tests/_gpsim_pointer_portable_body.jal`**: hop, byte literal, rvalue copy, folded
--    **`byte[2]`** subscript, const-pointer ROM→RAM (**`dst[i]=p[i]`**). Same JAL as **18F4620**
--    and **16f877** pointer smoke tracks; second **PIC18** part for gpsim (**`pic18f26k22`**).
--
-- Notes:
--    compilertest/Compiler_Linux/jalv2 -s 'third_party/jallib/lib;tests' tests/18f26k22_compiler_regression_pointers.jal
--
-- @gpsim_validate begin
-- steps: 120000
-- frequency_hz: auto
-- expect_hw_stkptr_le_compiler_depth: 1
-- hw_stkptr_steps: 25000
-- expect file_addr_ne v__gptr_cp 2 v__check_step
-- expect bit_clear v__bitbucket 0
-- expect byte v__check_step 5
-- expect byte v__gptr_ha 10
-- expect byte v__gptr_hb 20
-- expect byte v__gptr_hc 30
-- expect byte v__gptr_lc 42
-- expect byte v__gptr_ra 77
-- expect byte v__gptr_rb 77
-- expect word_le v__gptr_sb 1287
-- expect byte v__gptr_dd0 3
-- expect byte v__gptr_dd1 1
-- expect byte v__gptr_dd2 4
-- expect byte v__gptr_dd3 11
-- @gpsim_validate end
--
-- ------------------------------------------------------

include regression_18f26k22_device

alias led is pin_A0
pin_A0_direction = OUTPUT

include regression

include _gpsim_pointer_portable_body
