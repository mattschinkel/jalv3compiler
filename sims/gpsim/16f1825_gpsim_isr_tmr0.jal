-- ----------------------------------------------------------------------------
-- Title: PIC16F1825 gpsim — TMR0 overflow interrupt (14H runtime ISR witness)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The shared `_regression_pic14_isr_body` triggers INT through RA0, which is
--    not the INT pin on this part, so every 14H `*_compiler_regression_isr`
--    wrapper is `skip_gpsim: 1` - the 14H interrupt path had no runtime
--    witness at all.  This test drives a real interrupt instead: TMR0
--    overflow (INTCON_TMR0IF), three times, each serviced exactly once, with
--    the peripheral disabled again at the end.
--
--    It also exercises the 14H context save/restore: the handler runs while
--    the main line is inside a `while` loop, so a missing W/STATUS save would
--    corrupt the loop counter and the checkpoints.
--
-- @gpsim_validate begin
-- steps: 200000
-- frequency_hz: auto
-- expect byte v__check_step 2
-- expect byte v__t0_cnt 3
-- expect byte v__gpsim_regression_flags 0
-- @gpsim_validate end
-- ----------------------------------------------------------------------------

include regression_16f1825_device

include regression

var volatile byte _t0_cnt = 0
var volatile byte _t0_bad = 0

--------------------------------------------------------------------------------
procedure _t0_isr() is
   pragma interrupt

   if !INTCON_TMR0IF then
      return
   end if
   INTCON_TMR0IF = off
   -- preload short of overflow so the next tick is a few counts away
   TMR0 = 0xf0
   _t0_cnt = _t0_cnt + 1
end procedure

--------------------------------------------------------------------------------
procedure _run_t0_checks() is
   var byte _i

   regression_begin_run()

   INTCON_GIE = off
   INTCON_TMR0IE = off
   INTCON_TMR0IF = off

   -- TMR0: internal instruction clock, prescaler 1:2 assigned to TMR0
   OPTION_REG_TMR0CS = low
   OPTION_REG_TMR0SE = low
   OPTION_REG_PSA = low
   OPTION_REG_PS = 0b000
   TMR0 = 0xf0
   _t0_cnt = 0

   for 3 using _i loop
      INTCON_TMR0IF = off
      INTCON_TMR0IE = on
      INTCON_GIE = on
      while _t0_cnt != _i + 1 loop
      end loop
      INTCON_GIE = off
      INTCON_TMR0IE = off
   end loop

   if _t0_cnt != 3 then
      _t0_bad = _t0_bad + 1
      _check_failed = true
   end if
   regression_checkpoint()

   -- the peripheral must be left off
   if INTCON_TMR0IE | INTCON_GIE then
      _t0_bad = _t0_bad + 1
      _check_failed = true
   end if
   regression_checkpoint()
end procedure

_run_t0_checks()
regression_pass_led_if_clean()

forever loop
end loop
