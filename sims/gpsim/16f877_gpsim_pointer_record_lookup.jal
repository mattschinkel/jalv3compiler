-- ------------------------------------------------------
-- Title: 16f877 gpsim pointer record lookup
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
include regression_16f877_device
include regression

-- @gpsim_validate begin
-- steps: 200000
-- frequency_hz: auto
-- allow_compiler_warnings: yes
-- expect bit_clear v__bitbucket 0
-- expect byte v__check_step 1
-- expect byte v__record_lookup_r0 3
-- expect byte v__record_lookup_r1 1
-- expect byte v__record_lookup_r2 4
-- expect byte v__record_lookup_r3 11
-- @gpsim_validate end

record _record_lookup_rec_t is
   byte prefix
   byte payload[4]
   byte suffix
end record

const _record_lookup_rec_t _record_lookup_rec = {0x11, {3, 1, 4, 11}, 0x22}
var pointer _record_lookup_ptr as const byte[4]
var byte _record_lookup_r0 = 0
var byte _record_lookup_r1 = 0
var byte _record_lookup_r2 = 0
var byte _record_lookup_r3 = 0

_record_lookup_ptr is _record_lookup_rec.payload
_record_lookup_r0 = _record_lookup_ptr[0]
_record_lookup_r1 = _record_lookup_ptr[1]
_record_lookup_r2 = _record_lookup_ptr[2]
_record_lookup_r3 = _record_lookup_ptr[3]

if _record_lookup_r0 != 3 then
   _check_failed = true
end if
if _record_lookup_r1 != 1 then
   _check_failed = true
end if
if _record_lookup_r2 != 4 then
   _check_failed = true
end if
if _record_lookup_r3 != 11 then
   _check_failed = true
end if

regression_checkpoint()
regression_pass_led_if_clean()

forever loop
end loop
