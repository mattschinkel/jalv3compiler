include regression_18f26k22_device

alias led is pin_A0
pin_A0_direction = OUTPUT
-- INT0 is RB0; drive as output for software edge (datasheet INT0 pin).
pin_B0_direction = OUTPUT

include regression

include _regression_pic18_isr_body
