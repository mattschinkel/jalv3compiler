-- ------------------------------------------------------
-- Title: 16f877 gpsim regression — native array > 256 bytes (classic 14-bit)
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    The >256-byte native-array acceptance test for CLASSIC 14-bit
--    chunked placements (fix_pic14h_multibank_shared_window addendum):
--    a 320-byte array spans all four banks. Pins the classic-core
--    chunk-walk IRP rule -- IRP = (chunk base >= 0x100) OR low-byte
--    carry; the old carry-only rule made every bank-2/3 chunk land
--    in bank 0 (index 172 addressed 0x23 instead of 0x123, silently
--    corrupting low RAM). Fill all 320, rewrite indices >= 256,
--    checksum readback.
--
-- @gpsim_validate begin
-- steps: 12000000
-- frequency_hz: 20000000
-- expect byte v__check_step 5
-- expect byte v__r1 96
-- expect byte v__r2 183
-- expect byte v__r3 255
-- expect byte v__r4 0
-- @gpsim_validate end

include 16f877
pragma target clock 20_000_000
pragma target WDT DISABLED
include regression

var byte arr[320]
var volatile byte _r1 = 0
var volatile byte _r2 = 0
var volatile byte _r3 = 0
var volatile byte _r4 = 255
var word i
var word sum = 0

for 320 using i loop
   arr[i] = byte(i)
end loop
regression_checkpoint()

for 64 using i loop
   arr[256 + i] = 255 - byte(i)
end loop
regression_checkpoint()

sum = 0
for 320 using i loop
   sum = sum + arr[i]
end loop
_r1 = byte(sum)
regression_checkpoint()
_r2 = byte(sum >> 8)
regression_checkpoint()

_r3 = arr[256]
_r4 = arr[319] - 192
regression_checkpoint()
