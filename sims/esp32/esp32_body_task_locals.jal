-- Compiler: JALv2
--
-- Description:
--    Shared `_regression_task_locals_body` via @sim_validate: two
--    tasks with same-shaped locals + yields + a shared callee between
--    slices — per-task isolation on the unique-linear-homes model.
--
-- Notes:
--    ./bin/jalv3-x86-64 -s 'lib;tests' tests/esp32/esp32_body_task_locals.jal
--
-- @sim_validate begin
-- duration_s: 8.0
-- machine: esp32
-- expect byte v__check_step 2
-- expect byte v__tl_a_final 48
-- expect byte v__tl_b_final 50
-- expect byte v__tl_a_hits 4
-- expect byte v__tl_b_hits 4
-- @sim_validate end
--
include regression_esp32_device
var volatile bit _task_pin = 0
include regression_esp32
include _regression_task_locals_body
