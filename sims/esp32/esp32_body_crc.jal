-- ------------------------------------------------------
-- Title: ESP32 compiler regression — CRC16 + sort known-answer body
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Shared SDCC-adoption workload via `_regression_crc_body`:
--    CRC16-CCITT over several messages incl. incremental updates,
--    plus a bubble sort with a pinned sorted image and sum
--    invariant.
--
-- Notes:
--    ./bin/jalv3-x86-64 -s 'lib;tests' tests/esp32/esp32_body_crc.jal
--
-- @sim_validate begin
-- duration_s: 8.0
-- machine: esp32
-- expect byte v__check_step 6
-- expect byte v__crc_r_msg9 1
-- expect byte v__crc_r_msg1 1
-- expect byte v__crc_r_msg5 1
-- expect byte v__crc_r_msg03 1
-- expect byte v__crc_r_incr 1
-- expect byte v__crc_r_sort 1
-- @sim_validate end
--
include regression_esp32_device
include regression_esp32
include _regression_crc_body
