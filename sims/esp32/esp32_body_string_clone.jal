-- ------------------------------------------------------
-- Title: ESP32 @sim_validate — string-flavored CLONES
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    A dynamic string passed to a `byte in out x[]` / `byte out x[]`
--    formal is routed to a string-flavored clone of the callee (fixes/
--    fix_string_arg_clone.md): the body is re-parsed with the formal as
--    a string handle, so the ONE string rule applies -- below COUNT
--    store in place, AT COUNT append one character, COUNT live.  Array
--    actuals keep the generic body.  Functions clone; reads-only bodies
--    keep the payload view.
--
-- @sim_validate begin
-- duration_s: 20.0
-- machine: esp32
-- expect byte v_done 1
-- expect byte v_ok_place 1
-- expect byte v_ok_append 1
-- expect byte v_ok_fn 1
-- expect byte v_ok_rd 1
-- @sim_validate end
--
-- ------------------------------------------------------

include regression_esp32_device
include regression_esp32

pragma target string_heap_size 64

var string s
var volatile byte done = 0
var volatile byte ok_place = 0
var volatile byte ok_append = 0
var volatile byte ok_fn = 0
var volatile byte ok_rd = 0

procedure bump(byte in out x[], byte in k, byte in v) is
   x[k] = v
end procedure

function bump_get(byte in out x[], byte in k, byte in v) return byte is
   x[k] = v
   return x[0]
end function

function first(byte in out x[]) return byte is
   return x[0]
end function

procedure run() is
   regression_begin_run()
   s = "abc"
   bump(s, 0, "X")
   if (s[0] == "X") & (s[1] == "b") & (COUNT(s) == 3) then
      ok_place = 1
   end if
   bump(s, 3, "d")
   if (COUNT(s) == 4) & (s[3] == "d") & (s[0] == "X") then
      ok_append = 1
   end if
   s = "xyz"
   if (bump_get(s, 3, "w") == "x") & (COUNT(s) == 4) & (s[3] == "w") then
      ok_fn = 1
   end if
   if (first(s) == "x") & (COUNT(s) == 4) then
      ok_rd = 1
   end if
   done = 1
end procedure

run()
