-- Title: Shared PIC14 regression body — pragma
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Included by slim `*_pragma.jal` wrappers after `include regression`.
--
-- ------------------------------------------------------

regression_begin_run()
regression_checkpoint()
regression_pass_led_if_clean()
led = low

forever loop
   if _bad then
      led = ON
      _usec_delay(10_000)
      led = OFF
      _usec_delay(10_000)
   else
      led = ON
      _usec_delay(100_000)
      led = OFF
      _usec_delay(400_000)
   end if
end loop
