-- Title: Shared PIC14 regression body — isr
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Included by slim `*_isr.jal` wrappers after `include regression`.
--
-- ------------------------------------------------------

var volatile byte _isr_cnt = 0

--------------------------------------------------------------------------------
procedure _ext_isr() is
   pragma interrupt

   if !INTCON_INTF then
      return
   end if
   INTCON_INTF = off
   _isr_cnt = _isr_cnt + 1
end procedure

--------------------------------------------------------------------------------
procedure _run_isr_checks() is
   var byte _i

   regression_begin_run()

   OPTION_REG_INTEDG = true
   INTCON_INTE = off
   INTCON_INTF = off
   INTCON_GIE = off

   pin_A0 = low

   for 3 using _i loop
      INTCON_INTF = off
      INTCON_INTE = on
      INTCON_GIE = on
      pin_A0 = low
      pin_A0 = high
      while _isr_cnt != _i + 1 loop
      end loop
      INTCON_GIE = off
      INTCON_INTE = off
   end loop

   if _isr_cnt != 3 then
      _check_failed = true
   end if
   regression_checkpoint()

   if INTCON_INTE then
      _check_failed = true
   end if
   regression_checkpoint()

   regression_pass_led_if_clean()
   led = low
end procedure

_run_isr_checks()

forever loop
   if _bad then
      led = ON
      _usec_delay(10_000)
      led = OFF
      _usec_delay(10_000)
   else
      led = ON
      _usec_delay(100_000)
      led = OFF
      _usec_delay(400_000)
   end if
end loop
