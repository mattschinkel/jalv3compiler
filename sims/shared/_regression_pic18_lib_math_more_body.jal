-- Title: Shared PIC18 regression body — lib math more
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Included by slim `*_lib math more.jal` wrappers after `include regression`.
--
-- ------------------------------------------------------

include math

--------------------------------------------------------------------------------
-- Description: Verify BCD/binary helpers, digit count, abs8
-- Parameters:
-- - (none)
-- Returns:
-- - (none)
--------------------------------------------------------------------------------
procedure _run_math_more_checks() is
   var sbyte _neg

   regression_begin_run()

   if bcd2bin8(0x45) != 45 then
      _check_failed = true
   end if
   if bcd2bin8(0x99) != 99 then
      _check_failed = true
   end if
   regression_checkpoint()

   if bin2bcd8(0) != 0 then
      _check_failed = true
   end if
   if bin2bcd8(47) != 0x47 then
      _check_failed = true
   end if
   regression_checkpoint()

   if digits_word(0) != 1 then
      _check_failed = true
   end if
   if digits_word(9) != 1 then
      _check_failed = true
   end if
   if digits_word(10) != 2 then
      _check_failed = true
   end if
   if digits_word(9999) != 4 then
      _check_failed = true
   end if
   regression_checkpoint()

   _neg = -30
   if abs8(_neg) != 30 then
      _check_failed = true
   end if
   _neg = 14
   if abs8(_neg) != 14 then
      _check_failed = true
   end if
   regression_checkpoint()

   regression_pass_led_if_clean()
end procedure

_run_math_more_checks()

forever loop
   if _bad then
      led = ON
      _usec_delay(10_000)
      led = OFF
      _usec_delay(10_000)
   else
      led = ON
      _usec_delay(100_000)
      led = OFF
      _usec_delay(400_000)
   end if
end loop
