-- ----------------------------------------------------------------------------
-- Title: Wide integer types (qword/sqword/oword/soword) — shared runtime body
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Extracted from **`tests/16f877_gpsim_wide_integer_types.jal`** so the same runtime
--    coverage runs on multiple architectures.
--
-- ----------------------------------------------------------------------------

const qword _gpsim_wi_q_const = 0x0123456789ABCDEF
const oword _gpsim_wi_o_const = 0x0123456789ABCDEF0123456789ABCDEF
const sqword _gpsim_wi_sq_const = -2
const soword _gpsim_wi_so_const = -2

var sqword _gpsim_wi_sq = _gpsim_wi_sq_const
var soword _gpsim_wi_so = _gpsim_wi_so_const
var qword _gpsim_wi_q_arr[2]
var oword _gpsim_wi_o_arr[1]
var volatile byte _gpsim_wi_q_hi
var volatile byte _gpsim_wi_o_hi
var volatile byte _gpsim_wi_q_arr_lo
var volatile byte _gpsim_wi_q_arr_carry
var volatile byte _gpsim_wi_o_arr_lo
var volatile byte _gpsim_wi_sq_neg
var volatile byte _gpsim_wi_so_neg
var volatile byte _gpsim_wi_param_modes

--------------------------------------------------------------------------------
procedure _gpsim_wi_param_copy(qword in _qin, qword out _qout,
      oword in out _oinout) is
   _qout = _qin + 1
   _oinout = _oinout + 1
end procedure

--------------------------------------------------------------------------------
function _gpsim_wi_param_sum(sqword in _x, soword in _y) return soword is
   return _x + _y
end function

--------------------------------------------------------------------------------
procedure _gpsim_wi_run() is
   regression_begin_run()

   _gpsim_wi_q_arr[0] = _gpsim_wi_q_const
   if byte(_gpsim_wi_q_arr[0] >> 56) == 0x01 then
      _gpsim_wi_q_hi = 1
   end if
   regression_checkpoint()

   _gpsim_wi_o_arr[0] = _gpsim_wi_o_const
   if byte(_gpsim_wi_o_arr[0] >> 120) == 0x01 then
      _gpsim_wi_o_hi = 1
   end if
   regression_checkpoint()

   _gpsim_wi_q_arr[1] = _gpsim_wi_q_arr[0] + 0x11
   if byte(_gpsim_wi_q_arr[1]) == 0x00 then
      _gpsim_wi_q_arr_lo = 1
   end if
   regression_checkpoint()

   if byte(_gpsim_wi_q_arr[1] >> 8) == 0xCE then
      _gpsim_wi_q_arr_carry = 1
   end if
   regression_checkpoint()

   _gpsim_wi_o_arr[0] = _gpsim_wi_o_arr[0] + 1
   if byte(_gpsim_wi_o_arr[0]) == 0xF0 then
      _gpsim_wi_o_arr_lo = 1
   end if
   regression_checkpoint()

   if _gpsim_wi_sq == -2 then
      _gpsim_wi_sq_neg = 1
   end if
   regression_checkpoint()

   if _gpsim_wi_so == -2 then
      _gpsim_wi_so_neg = 1
   end if
   regression_checkpoint()

   _gpsim_wi_param_modes = 1
   _gpsim_wi_param_copy(_gpsim_wi_q_arr[0], _gpsim_wi_q_arr[1],
      _gpsim_wi_o_arr[0])
   if byte(_gpsim_wi_q_arr[1]) != 0xF0 then
      _gpsim_wi_param_modes = 0
   end if
   if byte(_gpsim_wi_o_arr[0]) != 0xF1 then
      _gpsim_wi_param_modes = 0
   end if
   if _gpsim_wi_param_sum(_gpsim_wi_sq, _gpsim_wi_so) != -4 then
      _gpsim_wi_param_modes = 0
   end if
   regression_checkpoint()

   regression_pass_led_if_clean()
end procedure

_gpsim_wi_run()

forever loop
end loop
