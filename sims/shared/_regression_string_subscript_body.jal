-- ------------------------------------------------------
-- Title: shared body — heap-string subscripts (str[i])
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    `str[i]` on a heap `var string` reads and writes the i-th
--    CHARACTER (payload through the handle), const and runtime
--    indices, char-literal writes, COUNT unchanged by writes.
--    A `var pointer p as var string` gives the same character access on
--    every target.  The rules for BOTH forms (direct and through a pointer):
--    a write below COUNT stores in place, a write at COUNT appends one
--    character (the string grows and COUNT follows), and a write past COUNT
--    is refused with `_string_error = _string_error_range` (nothing written).
--    A failed append reports `_string_error_heap_full` and leaves the text.
--
-- Notes:
--    Wrapped by the ESP32, PIC32 and PIC18 sim bodies.
--------------------------------------------------------------------------------
pragma target string_heap_size 128
include strings_dynamic

var string _ss_s
var string _ss_t
var pointer _ss_p as var string
var pointer _ss_pe as var string
var word _ss_wi
var byte _ss_i
var byte _ss_b

--------------------------------------------------------------------------------
-- a string FORMAL is a copy-in/copy-out dynamic string: a pointer to it must
-- read the formal's handle, append through it, and refuse past-the-end
procedure _ss_poke(string in out d) is
   var pointer lp as var string
   lp is d
   lp[1] = "Z"                        -- in place
   lp[3] = "W"                        -- append at COUNT
   lp[9] = "Q"                        -- past the end: refused, left for the caller
end procedure

--------------------------------------------------------------------------------
procedure _run() is
   regression_begin_run()

   _ss_s = "hello world"
   _ss_b = _ss_s[0]
   if _ss_b != "h" then
      _check_failed = true
   end if
   if _ss_s[6] != "w" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 1

   _ss_i = 4
   _ss_b = _ss_s[_ss_i]
   if _ss_b != "o" then
      _check_failed = true
   end if
   _ss_i = 10
   if _ss_s[_ss_i] != "d" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 2

   _ss_s[6] = "W"
   _ss_i = 4
   _ss_s[_ss_i] = "O"
   if _ss_s[6] != "W" then
      _check_failed = true
   end if
   if _ss_s[4] != "O" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 3

   if COUNT(_ss_s) != 11 then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 4

   if ! (_ss_s[0] == "h") then
      _check_failed = true
   end if
   if _ss_s[6] == "w" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 5

   -- character store through a string pointer: same access as `str[i]`,
   -- const and runtime index, COUNT untouched
   _ss_p is _ss_s
   _ss_p[0] = "H"
   _ss_i = 2
   _ss_p[_ss_i] = "L"
   if _ss_s[0] != "H" then
      _check_failed = true
   end if
   if _ss_s[2] != "L" then
      _check_failed = true
   end if
   if COUNT(_ss_s) != 11 then
      _check_failed = true
   end if
   if _string_error != _STRING_ERROR_NONE then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 6

   -- APPEND at COUNT(s): a write at the end grows the string by one and
   -- COUNT follows.  Past the end (not at it) is refused with the range code
   -- and leaves the text alone; a wide index cannot wrap into range.
   _ss_p[11] = "Q"
   _ss_i = 12
   _ss_p[_ss_i] = "!"
   if COUNT(_ss_s) != 13 then
      _check_failed = true
   end if
   if _ss_s[10] != "d" then
      _check_failed = true
   end if
   if _ss_s[11] != "Q" then
      _check_failed = true
   end if
   if _ss_s[12] != "!" then
      _check_failed = true
   end if
   if _string_error != _STRING_ERROR_NONE then
      _check_failed = true
   end if
   _ss_p[14] = "X"                               -- one past the end: refused
   if _string_error != _STRING_ERROR_RANGE then
      _check_failed = true
   end if
   if COUNT(_ss_s) != 13 then
      _check_failed = true
   end if
   _ss_wi = 300
   _ss_p[_ss_wi] = "X"
   if _string_error != _STRING_ERROR_RANGE then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 7

   -- an explicitly empty string gets its first character by append
   _ss_t = ""
   _ss_pe is _ss_t
   _ss_pe[0] = "A"
   if COUNT(_ss_t) != 1 then
      _check_failed = true
   end if
   if _ss_t[0] != "A" then
      _check_failed = true
   end if
   if _string_error != _STRING_ERROR_NONE then
      _check_failed = true
   end if

   -- string formal: the pointer sees the formal's handle, the append
   -- survives copy-back, and a past-the-end write inside the callee is
   -- refused
   _ss_s = "abc"
   _ss_poke(_ss_s)
   if _ss_s[1] != "Z" then
      _check_failed = true
   end if
   if _ss_s[3] != "W" then
      _check_failed = true
   end if
   if COUNT(_ss_s) != 4 then
      _check_failed = true
   end if
   if _string_error != _STRING_ERROR_RANGE then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 8
end procedure

_run()
regression_pass_led_if_clean()

forever loop
end loop
