-- ------------------------------------------------------
-- Title: shared body — heap-string subscripts (str[i])
--
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    `str[i]` on a heap `var string` reads and writes the i-th
--    CHARACTER (payload through the handle), const and runtime
--    indices, char-literal writes, COUNT unchanged by writes.
--
-- Notes:
--    Unchecked like array subscripts. Wrapped by the ESP32 and PIC32
--    sim bodies.
--------------------------------------------------------------------------------
const word _string_heap_size = 128
include strings_dynamic

var string _ss_s
var byte _ss_i
var byte _ss_b

--------------------------------------------------------------------------------
procedure _run() is
   regression_begin_run()

   _ss_s = "hello world"
   _ss_b = _ss_s[0]
   if _ss_b != "h" then
      _check_failed = true
   end if
   if _ss_s[6] != "w" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 1

   _ss_i = 4
   _ss_b = _ss_s[_ss_i]
   if _ss_b != "o" then
      _check_failed = true
   end if
   _ss_i = 10
   if _ss_s[_ss_i] != "d" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 2

   _ss_s[6] = "W"
   _ss_i = 4
   _ss_s[_ss_i] = "O"
   if _ss_s[6] != "W" then
      _check_failed = true
   end if
   if _ss_s[4] != "O" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 3

   if COUNT(_ss_s) != 11 then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 4

   if ! (_ss_s[0] == "h") then
      _check_failed = true
   end if
   if _ss_s[6] == "w" then
      _check_failed = true
   end if
   regression_checkpoint()                       -- 5
end procedure

_run()
regression_pass_led_if_clean()

forever loop
end loop
