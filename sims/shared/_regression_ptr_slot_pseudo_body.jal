-- ----------------------------------------------------------------------------
-- Title: Pseudo-variable bound into a pointer-slot array — shared runtime body
-- Author: Matthew Schinkel
-- Compiler: JALv2
--
-- Description:
--    Pins `slots[k] is pv` on a const index (stage 1): reads and writes
--    through the pseudo-bound element dispatch statically to 'get/'put,
--    while plain-bound elements of the same array keep the ordinary
--    slot dereference.
--
-- Sources:
--
--
-- ----------------------------------------------------------------------------

regression_begin_run()

var byte _slp_shadow = 0
var byte _slp_v2 = 0
var byte _slp_snap1 = 0
var byte _slp_snap2 = 0

function _slp_pv'get return byte is
   return _slp_shadow
end function

procedure _slp_pv'put(byte in v) is
   _slp_shadow = v
end procedure

var pointer _slp_slots[2] as var byte

_slp_slots[0] is _slp_pv
_slp_slots[1] is _slp_v2
_slp_shadow = 41
_slp_v2 = 42
_slp_snap1 = _slp_slots[0]
_slp_snap2 = _slp_slots[1]
_slp_slots[0] = 55
if (_slp_snap1 != 41) | (_slp_snap2 != 42) then
   _check_failed = true
end if
regression_checkpoint()
if (_slp_shadow != 55) | (_slp_v2 != 42) then
   _check_failed = true
end if
regression_checkpoint()
-- Stage-2 runtime-indexed dispatch (`slots[k]` with runtime k). The
-- dispatch's element-size policy used the pointer def's nominal size
-- (2, the classic PIC FSR width) instead of the back end's pointer
-- size (4 on MIPS32/Xtensa, 3 on PIC18) -- every runtime-indexed slot
-- access misaddressed on the non-14-bit cores (fixed 2026-10-29: all
-- dispatch units now share pfile_flat_def_storage_sz). Pins both read
-- arms (pseudo 'get via the kind[] dispatch + plain deref, including
-- the expression context) and both write arms (compare-chain 'put +
-- plain store-through) at runtime indices.
var byte _slp_rtk = 0
var byte _slp_rtsum = 0

_slp_rtk = 0
_slp_rtsum = _slp_slots[_slp_rtk]
_slp_rtk = 1
_slp_rtsum = _slp_rtsum + _slp_slots[_slp_rtk]
if _slp_rtsum != 97 then
   _check_failed = true
end if
regression_checkpoint()
_slp_rtk = 1
_slp_slots[_slp_rtk] = 77
if _slp_v2 != 77 then
   _check_failed = true
end if
regression_checkpoint()
_slp_rtk = 0
_slp_slots[_slp_rtk] = 66
if _slp_shadow != 66 then
   _check_failed = true
end if
regression_checkpoint()
