-- Title: Shared PIC32 sample-onchip body (delay / bits / debounce / queues)
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
--
-- Description:
--    delay + bit_array_1 + debounce_init/threshold + 20-iter poll + queues.
--    Poll uses a RAM bit (`_debounce_pin`), not an SFR and not a device-file
--    GET/PUT pin (that would shift every body's RAM map).
--
-- ------------------------------------------------------

include delay

const dword BIT_ARRAY_1_SIZE = 48
include bit_array_1
alias _bits is bit_array_1

include debounce

-- RAM-backed poll input; keep this in the body, not regression_32mz1024efh064_device.
var volatile byte _debounce_pin_byte = 0
var volatile bit _debounce_pin at _debounce_pin_byte : 0

const byte queue01_size = 6
include queue01

const byte queue02_size = 5
include queue02

var bit _b0
var bit _b1
var bit _b2

--------------------------------------------------------------------------------
procedure _run_sample_onchip_checks() is
   var word _st
   var byte _qv
   var byte _db
   var bit _ok
   var byte _need

   regression_begin_run()

   delay_1us()
   delay_5us()
   delay_10us(4)
   delay_1ms(1)
   regression_checkpoint()

   _bits[0] = 1
   _bits[7] = 1
   _bits[8] = 0
   _bits[31] = 1
   _b0 = _bits[0]
   _b1 = _bits[7]
   _b2 = _bits[8]
   if (!_b0) | (!_b1) | _b2 then
      _check_failed = true
   end if
   if !_bits[31] then
      _check_failed = true
   end if
   regression_checkpoint()

   _st = debounce_init(8)
   _need = 11
   if debounce_threshold(_st) != _need then
      _check_failed = true
   end if
   for 20 loop
      _db = debounce(_debounce_pin, _st)
   end loop
   regression_checkpoint()

   queue01_clear()
   _ok = queue01_nb_put(0xAA)
   if !_ok then
      _check_failed = true
   end if
   _ok = queue01_nb_put(0x55)
   if !_ok then
      _check_failed = true
   end if
   _ok = queue01_nb_get(_qv)
   if (!_ok) | (_qv != 0xAA) then
      _check_failed = true
   end if
   _ok = queue01_nb_get(_qv)
   if (!_ok) | (_qv != 0x55) then
      _check_failed = true
   end if
   regression_checkpoint()

   queue02_clear()
   _ok = queue02_nb_put(1)
   if !_ok then
      _check_failed = true
   end if
   _ok = queue02_nb_get(_qv)
   if (!_ok) | (_qv != 1) then
      _check_failed = true
   end if
   regression_checkpoint()

   regression_pass_led_if_clean()
end procedure

_run_sample_onchip_checks()

forever loop
   if _bad then
      led = ON
      _usec_delay(10_000)
      led = OFF
      _usec_delay(10_000)
   else
      led = ON
      _usec_delay(100_000)
      led = OFF
      _usec_delay(400_000)
   end if
end loop
