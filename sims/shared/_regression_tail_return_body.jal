-- Title: Shared regression body — tail-transfer optimizer must not delete code
-- Author: Matthew Schinkel, Copyright (c) 2026 all rights reserved.
-- Compiler: JALv2
--
-- Description:
--    Guards **`cmd_opt_tail_return`** / **`cmd_opt_branch`** (shared libcore):
--    a function or procedure ending in a *call + return* must keep every side
--    effect and the correct return value. Before the fix
-- the tail-return rewrite
--    treated real assignments between the call and the exit as disposable
--    glue, and the fall-through rule deleted the rewritten tail GOTO —
--    truncating the caller: wrong return values and deleted stores on all
--    cores, an infinite `$ra` loop on PIC32.
--
-- Notes:
--    Six **`regression_checkpoint()`** calls → **`expect byte v__check_step 6`**.
--    Include after **`include regression`** (same pattern as
--    **`_regression_dead_code_body.jal`**). Side effects are recorded in the
--    shadow byte **`_tr_side`** — the deleted-code defect makes the expected
--    pattern mismatch even when execution returns normally.

-- Side-effect shadow: callees append a bit per action (b1=proc w/ post-store,
-- b2=fn call before return, b3=deep tail chain, b4=post-call store in caller)
var byte _tr_side = 0

-- Observed by value: sum of return values, checked per checkpoint
var byte _tr_sum = 0

--------------------------------------------------------------------------------
-- Description: Empty tail callee emitted right after its callers so the tail
-- - GOTO is a fall-through candidate for cmd_opt_branch (the deleted-GOTO
-- - defect shape).
--------------------------------------------------------------------------------
procedure _tr_empty_tail() is
end procedure

--------------------------------------------------------------------------------
-- Description: Function whose body ends call + return-local; a post-call store
-- - (side effect) sits between the call and the return.
-- Returns:
-- - 3 - fixed value (was wrong/0 pre-fix)
--------------------------------------------------------------------------------
function _tr_fn_call_then_ret() return byte is
   var byte r = 0
   r = 3
   _tr_empty_tail()
   _tr_side = _tr_side | 0b0000_0010
   return r
end function

--------------------------------------------------------------------------------
-- Description: Function whose last statement is the call itself (pure tail);
-- - the fall-through deletion applied to exactly this shape on PIC32.
-- Returns:
-- - 5 - fixed value
--------------------------------------------------------------------------------
function _tr_fn_pure_tail() return byte is
   _tr_empty_tail()
   return 5
end function

--------------------------------------------------------------------------------
-- Description: Function returning the value computed *before* the tail call —
-- - the value-return defect deleted this move (min1.jal shape).
-- Returns:
-- - 7 - fixed value
--------------------------------------------------------------------------------
function _tr_fn_value_before_call() return byte is
   var byte r = 0
   r = 7
   _tr_empty_tail()
   return r
end function

--------------------------------------------------------------------------------
-- Description: Procedure with a call + post-call side-effect store at its end
-- - (the i2c_transmit_byte `scl_direction = low` shape).
--------------------------------------------------------------------------------
procedure _tr_proc_store_after_call() is
   _tr_empty_tail()
   _tr_side = _tr_side | 0b0000_0001
end procedure

--------------------------------------------------------------------------------
-- Description: Two-level tail chain: wrapper tail-calls a middle function
-- - which tail-calls the empty procedure (exercises nesting + exit-label
-- - rewriting).
-- Returns:
-- - 9 - fixed value
--------------------------------------------------------------------------------
function _tr_chain_mid() return byte is
   _tr_empty_tail()
   _tr_side = _tr_side | 0b0000_0100
   return 9
end function

function _tr_chain_wrap() return byte is
   return _tr_chain_mid()
end function

--------------------------------------------------------------------------------
-- Description: Run the tail-transfer checks; each block ends with
-- - **regression_checkpoint**.
--------------------------------------------------------------------------------
procedure _run_tail_return_checks() is
   var byte v = 0

   regression_begin_run()

   -- 1) value computed before a trailing call survives (value-return defect)
   v = _tr_fn_value_before_call()
   if v != 7 then
      _check_failed = true
   end if
   regression_checkpoint()

   -- 2) call then store-then-return: side effect + value both kept
   v = _tr_fn_call_then_ret()
   if v != 3 then
      _check_failed = true
   end if
   if (_tr_side & 0b0000_0010) == 0 then
      _check_failed = true       -- post-call store was deleted
   end if
   regression_checkpoint()

   -- 3) pure tail call + return constant
   v = _tr_fn_pure_tail()
   if v != 5 then
      _check_failed = true
   end if
   regression_checkpoint()

   -- 4) procedure with post-call store (the i2c scl_direction shape)
   _tr_proc_store_after_call()
   if (_tr_side & 0b0000_0001) == 0 then
      _check_failed = true
   end if
   regression_checkpoint()

   -- 5) nested tail chain through two functions
   v = _tr_chain_wrap()
   if v != 9 then
      _check_failed = true
   end if
   if (_tr_side & 0b0000_0100) == 0 then
      _check_failed = true
   end if
   regression_checkpoint()

   -- 6) full side-effect pattern: b0..b2 set, b3+ clear
   _tr_sum = _tr_side
   if _tr_side != 0b0000_0111 then
      _check_failed = true
   end if
   regression_checkpoint()

   regression_pass_led_if_clean()
   led_pin = low
end procedure

_run_tail_return_checks()

forever loop
   if _bad then
      led = ON
      _usec_delay(10_000)
      led = OFF
      _usec_delay(10_000)
   else
      led = ON
      _usec_delay(100_000)
      led = OFF
      _usec_delay(400_000)
   end if
end loop
