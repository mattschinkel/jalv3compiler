--
-- GPIO pin aliases (synthesized from the register layout)
--
--    pin_N            at GPIO_IN(_1) : N   input level (read)
--    pin_N_out        at GPIO_OUT(_1) : N  output value
--    pin_N_direction  at GPIO_ENABLE(_1) : N  direction
--
--    banks: 0..31 on GPIO_IN/GPIO_OUT/GPIO_ENABLE;
--           32..39 on GPIO_IN1/GPIO_OUT1/GPIO_ENABLE1.
--    GPIO28..31 are dedicated flash pins -- NOT emitted.
--
--    pin_N_direction sense (GPIO_ENABLE): TRUE = output, FALSE =
--    input -- the OPPOSITE of jallib's TRIS-sense INPUT/OUTPUT
--    constants, which therefore must NOT be used here.
--
--    NOTE: a pin_N_out write is a READ-MODIFY-WRITE of GPIO_OUT
--    -- not atomic vs interrupts.  For atomic output updates
--    keep GPIO_OUT_W1TS / GPIO_OUT_W1TC (the samples do); the
--    aliases are for readability and pin reads.  Same caveat for
--    pin_N_direction vs GPIO_ENABLE_W1TS/W1TC.
--
var volatile bit pin_0_direction at GPIO_ENABLE : 0
var volatile bit pin_0_out at GPIO_OUT : 0
var volatile bit pin_0 at GPIO_IN : 0
var volatile bit pin_1_direction at GPIO_ENABLE : 1
var volatile bit pin_1_out at GPIO_OUT : 1
var volatile bit pin_1 at GPIO_IN : 1
