--
--
--
-- Constants and procedures related to analog features
--


const byte ADC_ADCS_BITCOUNT  = 0
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - -
-- Change analog I/O pins into digital I/O pins.
procedure analog_off() is
   pragma inline
   -- PIC32: No analog module to disable - all pins are digital by default
   ANSELA = 0b0000_0000
   ANSELB = 0b0000_0000
end procedure
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - -
-- Disable comparator module
procedure comparator_off() is
   pragma inline
   -- PIC32: comparator ON is 0 after reset; no SFR write (qemu CMP unmodeled)
end procedure
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - -
-- Switch analog ports to digital mode when analog module(s) present.
procedure enable_digital_io() is
   pragma inline
   analog_off()
   comparator_off()
end procedure
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - -
-- PIC32 System Key unlock sequence (required for configuration changes)
procedure syskey_unlock() is
   pragma inline
   SYSKEY = 0x00000000  -- First part of unlock sequence
   SYSKEY = 0xAA996655  -- Second part of unlock sequence
   SYSKEY = 0x556699AA  -- Third part of unlock sequence
end procedure
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - -
-- PIC32 System Key lock sequence (prevents accidental changes)
procedure syskey_lock() is
   pragma inline
   SYSKEY = 0x33333333  -- Lock sequence
end procedure
--
-- - - - - - - - - - - - - - - - - - - - - - - - - - -
-- PIC32 basic startup configuration (call after reset)
procedure pic32_startup() is
   pragma inline
   -- Unlock system configuration
   syskey_unlock()
   
   -- No PBxDIV block on this family: PBCLK = SYSCLK / FPBDIV
   -- (DEVCFG1), set by the clock solve / fuse words.
   -- Lock system configuration to prevent accidental changes
   syskey_lock()
   
   -- Enable digital I/O
   enable_digital_io()
end procedure
--
--
--    Miscellaneous information
--
--
const PPS_GROUP             = PPS_0       -- PIC32 PPS: use the PPS_IN_/PPS_OUT_ tables (jallib pps.jal groups do not apply)
--
-- Free shared memory: 0x80000000-0x8000FFFF
--
--
--    Symbolic Fuse Definitions
--
const dword DEVCFG3_USERID         = 0x0000FFFF  --  (arbitrary-value field: `pragma target fuses 3 <value>`)
--
pragma fuse_def PMDL1WAY     :3  0x10000000 {  -- Peripheral Module Disable Configuration
       ON                 = 0x10000000  -- Allow only one reconfiguration
       OFF                = 0x00000000  -- Allow multiple reconfigurations
       }
--
pragma fuse_def IOL1WAY      :3  0x20000000 {  -- Peripheral Pin Select Configuration
       ON                 = 0x20000000  -- Allow only one reconfiguration
       OFF                = 0x00000000  -- Allow multiple reconfigurations
       }
--
pragma fuse_def FUSBIDIO     :3  0x40000000 {  -- USB USID Selection
       OFF                = 0x00000000  -- Controlled by Port Function
       ON                 = 0x40000000  -- Controlled by the USB Module
       }
--
pragma fuse_def FVBUSONIO    :3  0x80000000 {  -- USB VBUS ON Selection
       OFF                = 0x00000000  -- Controlled by Port Function
       ON                 = 0x80000000  -- Controlled by USB Module
       }
const dword DEVCFG2_FPLLIDIV       = 0x00000007  -- PLL Input Divider (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
const dword DEVCFG2_FPLLMUL        = 0x00000070  -- PLL Multiplier (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
--
pragma fuse_def UPLLIDIV     :2  0x00000700 {  -- USB PLL Input Divider
       DIV_1              = 0x00000000  -- 1x Divider
       DIV_2              = 0x00000100  -- 2x Divider
       DIV_3              = 0x00000200  -- 3x Divider
       DIV_4              = 0x00000300  -- 4x Divider
       DIV_5              = 0x00000400  -- 5x Divider
       DIV_6              = 0x00000500  -- 6x Divider
       DIV_10             = 0x00000600  -- 10x Divider
       DIV_12             = 0x00000700  -- 12x Divider
       }
--
pragma fuse_def UPLLEN       :2  0x00008000 {  -- USB PLL Enable
       ON                 = 0x00000000  -- Enabled
       OFF                = 0x00008000  -- Disabled and Bypassed
       }
const dword DEVCFG2_FPLLODIV       = 0x00070000  -- System PLL Output Clock Divider (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
const dword DEVCFG1_FNOSC          = 0x00000007  -- Oscillator Selection Bits (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
const dword DEVCFG1_FSOSCEN        = 0x00000020  -- Secondary Oscillator Enable (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
const dword DEVCFG1_IESO           = 0x00000080  -- Internal/External Switch Over (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
const dword DEVCFG1_POSCMOD        = 0x00000300  -- Primary Oscillator Configuration (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
--
pragma fuse_def OSCIOFNC     :1  0x00000400 {  -- CLKO Output Signal Active on the OSCO Pin
       OFF                = 0x00000400  -- Disabled
       ON                 = 0x00000000  -- Enabled
       }
--
pragma fuse_def FPBDIV       :1  0x00003000 {  -- Peripheral Clock Divisor
       DIV_1              = 0x00000000  -- Pb_Clk is Sys_Clk/1
       DIV_2              = 0x00001000  -- Pb_Clk is Sys_Clk/2
       DIV_4              = 0x00002000  -- Pb_Clk is Sys_Clk/4
       DIV_8              = 0x00003000  -- Pb_Clk is Sys_Clk/8
       }
const dword DEVCFG1_FCKSM          = 0x0000C000  -- Clock Switching and Monitor Selection (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
--
pragma fuse_def WDTPS        :1  0x001F0000 {  -- Watchdog Timer Postscaler
       PS1                = 0x00000000  -- 1:1
       PS2                = 0x00010000  -- 1:2
       PS4                = 0x00020000  -- 1:4
       PS8                = 0x00030000  -- 1:8
       PS16               = 0x00040000  -- 1:16
       PS32               = 0x00050000  -- 1:32
       PS64               = 0x00060000  -- 1:64
       PS128              = 0x00070000  -- 1:128
       PS256              = 0x00080000  -- 1:256
       PS512              = 0x00090000  -- 1:512
       PS1024             = 0x000A0000  -- 1:1024
       PS2048             = 0x000B0000  -- 1:2048
       PS4096             = 0x000C0000  -- 1:4096
       PS8192             = 0x000D0000  -- 1:8192
       PS16384            = 0x000E0000  -- 1:16384
       PS32768            = 0x000F0000  -- 1:32768
       PS65536            = 0x00100000  -- 1:65536
       PS131072           = 0x00110000  -- 1:131072
       PS262144           = 0x00120000  -- 1:262144
       PS524288           = 0x00130000  -- 1:524288
       PS1048576          = 0x00140000  -- 1:1048576
       }
--
pragma fuse_def WINDIS       :1  0x00400000 {  -- Watchdog Timer Window Enable
       ON                 = 0x00000000  -- Watchdog Timer is in Window Mode
       OFF                = 0x00400000  -- Watchdog Timer is in Non-Window Mode
       }
const dword DEVCFG1_FWDTEN         = 0x00800000  -- Watchdog Timer Enable (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
--
pragma fuse_def FWDTWINSZ    :1  0x03000000 {  -- Watchdog Timer Window Size
       WINSZ_75           = 0x00000000  -- Window Size is 75%
       WINSZ_50           = 0x01000000  -- Window Size is 50%
       WINSZ_37           = 0x02000000  -- Window Size is 37.5%
       WINSZ_25           = 0x03000000  -- Window Size is 25%
       }
const dword DEVCFG0_DEBUG          = 0x00000003  -- Background Debugger Enable (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
--
pragma fuse_def JTAGEN       :0  0x00000004 {  -- JTAG Enable
       ON                 = 0x00000004  -- JTAG Port Enabled
       OFF                = 0x00000000  -- JTAG Disabled
       }
--
