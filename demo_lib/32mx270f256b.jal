--
pragma fuse_def BWP          :0  0x01000000 {  -- Boot Flash Write Protect bit
       ON                 = 0x00000000  -- Protection Enabled
       OFF                = 0x01000000  -- Protection Disabled
       }
--
pragma fuse_def CP           :0  0x10000000 {  -- Code Protect
       ON                 = 0x00000000  -- Protection Enabled
       OFF                = 0x10000000  -- Protection Disabled
       }
