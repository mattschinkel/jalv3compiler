       PWP452K            = 0x0008E000  -- First 452K
       PWP456K            = 0x0008D000  -- First 456K
       PWP460K            = 0x0008C000  -- First 460K
       PWP464K            = 0x0008B000  -- First 464K
       PWP468K            = 0x0008A000  -- First 468K
       PWP472K            = 0x00089000  -- First 472K
       PWP476K            = 0x00088000  -- First 476K
       PWP480K            = 0x00087000  -- First 480K
       PWP484K            = 0x00086000  -- First 484K
       PWP488K            = 0x00085000  -- First 488K
       PWP492K            = 0x00084000  -- First 492K
       PWP496K            = 0x00083000  -- First 496K
       PWP500K            = 0x00082000  -- First 500K
       PWP504K            = 0x00081000  -- First 504K
       PWP508K            = 0x00080000  -- First 508K
       PWP512K            = 0x0007F000  -- First 512K
       }
--
pragma fuse_def BWP          :0  0x01000000 {  -- Boot Flash Write Protect bit
       ON                 = 0x00000000  -- Protection Enabled
       OFF                = 0x01000000  -- Protection Disabled
       }
--
pragma fuse_def CP           :0  0x10000000 {  -- Code Protect
       ON                 = 0x00000000  -- Protection Enabled
       OFF                = 0x10000000  -- Protection Disabled
       }
--
