--
pragma fuse_def SOSCGAIN     :0  0x00030000 {  -- Secondary Oscillator Gain Control bits
       GAIN_2X            = 0x00030000  -- 2x gain setting
       GAIN_1_5X          = 0x00020000  -- 1.5x gain setting
       GAIN_0_5X          = 0x00000000  -- 0.5x gain setting
       GAIN_1X            = 0x00010000  -- 1x gain setting
       GAIN_LEVEL_3       = 0x00030000  -- Gain level 3 (Highest)
       GAIN_LEVEL_2       = 0x00020000  -- Gain level 2
       GAIN_LEVEL_1       = 0x00010000  -- Gain level 1
       GAIN_LEVEL_0       = 0x00000000  -- Gain level 0 (Lowest)
       }
--
pragma fuse_def SOSCBOOST    :0  0x00040000 {  -- Secondary Oscillator Boost Kick Start Enable bit
       ON                 = 0x00040000  -- Boost the kick start of the oscillator
       OFF                = 0x00000000  -- Normal start of the oscillator
       }
--
pragma fuse_def POSCGAIN     :0  0x00180000 {  -- Primary Oscillator Gain Control bits
       GAIN_2X            = 0x00180000  -- 2x gain setting
       GAIN_1_5X          = 0x00100000  -- 1.5x gain setting
       GAIN_0_5X          = 0x00000000  -- 0.5x gain setting
       GAIN_1X            = 0x00080000  -- 1x gain setting
       GAIN_LEVEL_3       = 0x00180000  -- Gain level 3 (Highest)
       GAIN_LEVEL_2       = 0x00100000  -- Gain level 2
       GAIN_LEVEL_1       = 0x00080000  -- Gain level 1
       GAIN_LEVEL_0       = 0x00000000  -- Gain level 0 (Lowest)
       }
--
pragma fuse_def POSCBOOST    :0  0x00200000 {  -- Primary Oscillator Boost Kick Start Enable bit
       ON                 = 0x00200000  -- Boost the kick start of the oscillator
       OFF                = 0x00000000  -- Normal start of the oscillator
       }
--
pragma fuse_def EJTAGBEN     :0  0x40000000 {  -- EJTAG Boot
       NORMAL             = 0x40000000  -- Normal EJTAG functionality
       REDUCED            = 0x00000000  -- Reduced EJTAG functionality
       }
--
--    PPS constants (Peripheral Pin Select)
--    Source: PIC32MZ EF family DS60001320H, Tables 12-2/12-3
--    Input:  U1RXR = PPS_IN_U1RX_RPB2   (peripheral <- pin)
--    Output: RPB3R = PPS_OUT_RPB3_U1TX  (pin <- function)
--    Only combinations valid for this device are defined.
--    Function codes (jallib 8-bit style, e.g. RPB3R = PPS_U1TX)
--    follow the pair constants; a code is only valid on pins of
--    its own group -- prefer the pair constants when unsure.
--
-- pin group 1: RPD2 RPG8 RPF4 RPD10 RPF1 RPB9 RPB10 RPC14 RPB5
