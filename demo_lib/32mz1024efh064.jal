       DMT13              = 0x14000000  -- 2^13 (8192)
       DMT14              = 0x18000000  -- 2^14 (16384)
       DMT15              = 0x1C000000  -- 2^15 (32768)
       DMT16              = 0x20000000  -- 2^16 (65536)
       DMT17              = 0x24000000  -- 2^17 (131072)
       DMT18              = 0x28000000  -- 2^18 (262144)
       DMT19              = 0x2C000000  -- 2^19 (524288)
       DMT20              = 0x30000000  -- 2^20 (1048576)
       DMT21              = 0x34000000  -- 2^21 (2097152)
       DMT22              = 0x38000000  -- 2^22 (4194304)
       DMT23              = 0x3C000000  -- 2^23 (8388608)
       DMT24              = 0x40000000  -- 2^24 (16777216)
       DMT25              = 0x44000000  -- 2^25 (33554432)
       DMT26              = 0x48000000  -- 2^26 (67108864)
       DMT27              = 0x4C000000  -- 2^27 (134217728)
       DMT28              = 0x50000000  -- 2^28 (268435456)
       DMT29              = 0x54000000  -- 2^29 (536870912)
       DMT30              = 0x58000000  -- 2^30 (1073741824)
       DMT31              = 0x5C000000  -- 2^31 (2147483648)
       }
const dword DEVCFG1_FDMTEN         = 0x80000000  -- Deadman Timer Enable (owned by pragma target clock/OSC and the WDT/DMT/DEBUG/IESO/SOSC/MCLR keywords)
--
pragma fuse_def JTAGEN       :0  0x00000004 {  -- JTAG Enable
       ON                 = 0x00000004  -- JTAG Port Enabled
       OFF                = 0x00000000  -- JTAG Disabled
       }
--
pragma fuse_def ICESEL       :0  0x00000018 {  -- ICE/ICD Comm Channel Select
       ICS_PGX1           = 0x00000018  -- Communicate on PGEC1/PGED1
       ICS_PGX2           = 0x00000010  -- Communicate on PGEC2/PGED2
       }
--
pragma fuse_def TRCEN        :0  0x00000020 {  -- Trace Enable
       ON                 = 0x00000020  -- Trace features in the CPU are enabled
       OFF                = 0x00000000  -- Trace features in the CPU are disabled
       }
--
pragma fuse_def BOOTISA      :0  0x00000040 {  -- Boot ISA Selection
       MIPS32             = 0x00000040  -- Boot code and Exception code is MIPS32
       MICROMIPS          = 0x00000000  -- Boot code and Exception code is microMIPS
       }
--
pragma fuse_def FECCCON      :0  0x00000300 {  -- Dynamic Flash ECC Configuration
       ON                 = 0x00000000  -- Flash ECC is enabled (ECCCON bits are locked)
       DYNAMIC            = 0x00000100  -- Dynamic Flash ECC is enabled (ECCCON bits are locked)
       OFF_LOCKED         = 0x00000200  -- ECC and Dynamic ECC are disabled (ECCCON bits are locked)
       OFF_UNLOCKED       = 0x00000300  -- ECC and Dynamic ECC are disabled (ECCCON bits are writable)
       }
--
pragma fuse_def FSLEEP       :0  0x00000400 {  -- Flash Sleep Mode
       OFF                = 0x00000400  -- Flash is powered down when the device is in Sleep mode
       VREGS              = 0x00000000  -- Flash power down is controlled by the VREGS bit
       }
