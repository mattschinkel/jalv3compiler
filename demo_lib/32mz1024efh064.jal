       WINSZ_25           = 0x03000000  -- Window size is 25%
       WINSZ_37           = 0x02000000  -- Window size is 37.5%
       WINSZ_50           = 0x01000000  -- Window size is 50%
       WINSZ_75           = 0x00000000  -- Window size is 75%
       }
--
pragma fuse_def DMTCNT       :1  0x7C000000 {  -- Deadman Timer Count Selection
       DMT8               = 0x00000000  -- 2^8 (256)
       DMT9               = 0x04000000  -- 2^9 (512)
       DMT10              = 0x08000000  -- 2^10 (1024)
       DMT11              = 0x0C000000  -- 2^11 (2048)
