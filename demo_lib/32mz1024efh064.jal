       WIN_3_4            = 0x00000010  -- Window/Interval value is 3/4 counter value
       WIN_7_8            = 0x00000018  -- Window/Interval value is 7/8 counter value
       WIN_15_16          = 0x00000020  -- Window/Interval value is 15/16 counter value
       WIN_31_32          = 0x00000028  -- Window/Interval value is 31/32 counter value
       WIN_63_64          = 0x00000030  -- Window/Interval value is 63/64 counter value
       WIN_127_128        = 0x00000038  -- Window/Interval value is 127/128 counter value
       }
